@page "/jobs/add"
@page "/jobs/{JobId:guid}/edit"

@attribute [Authorize]
@rendermode InteractiveServer

@using CRM.Core.Companies.Abstractions
@using CRM.Core.Companies.Domain
@using CRM.Core.Contacts.Abstractions
@using CRM.Core.Contacts.Domain
@using CRM.Core.Jobs.Abstractions
@using CRM.Core.Jobs.Domain
@using CRM.Core.Services.Abstractions
@using CRM.Core.Users.Abstraction.Services
@using CRM.Core.Users.Domain
@using CRM.Web.State
@using CRM.Web.Users.Abstraction
@using CrmService = CRM.Core.Services.Domain.Service

@inject IJobService JobService
@inject ICompanyService CompanyService
@inject IContactService ContactService
@inject IServiceService ServiceService
@inject IUserService UserService
@inject ICurrentUserState CurrentUserState
@inject NavigationManager Navigation
@inject PageHeaderState HeaderState

<SeoHead Title="@strPageTitle" />

<section class="job-edit-page">

    <div class="job-toolbar">

        <button type="button"
                class="btn crm-btn-secondary"
                @onclick="GoBack">

            <span class="material-symbols-outlined">
                arrow_back
            </span>

            @(blnEditMode
                ? "Back to job"
                : "Back to jobs")

        </button>

    </div>

    @if (!String.IsNullOrWhiteSpace(
        strErrorMessage))
    {
        <div class="alert alert-danger crm-alert"
             role="alert">

            <span class="material-symbols-outlined">
                error
            </span>

            <div>
                @strErrorMessage
            </div>

        </div>
    }

    @if (blnLoading)
    {
        <div class="crm-card job-empty-state">

            <span class="material-symbols-outlined">
                hourglass_empty
            </span>

            <h2>
                Loading job
            </h2>

            <p>
                Please wait while the form is prepared.
            </p>

        </div>
    }
    else
    {
        <EditForm Model="objJob"
                  OnValidSubmit="SaveJobAsync"
                  FormName="JobEditForm">

            <DataAnnotationsValidator />

            <div class="job-layout">

                <div class="job-main-column">

                    <div class="crm-card job-form-card">

                        <div class="job-form-heading">

                            <div>

                                <h2>
                                    @(blnEditMode
                                        ? "Edit job"
                                        : "New job")
                                </h2>

                                <p>
                                    Track the work, customer, site, assignment and pipeline stage.
                                </p>

                            </div>

                        </div>

                        <div class="job-form-body">

                            <div class="row g-3">

                                <div class="col-md-8">

                                    <label class="form-label"
                                           for="name">
                                        Name
                                    </label>

                                    <InputText id="name"
                                               class="form-control"
                                               @bind-Value="objJob.Name" />

                                </div>

                                <div class="col-md-4">

                                    <label class="form-label"
                                           for="stage">
                                        Stage
                                    </label>

                                    <InputSelect id="stage"
                                                 class="form-select"
                                                 TValue="JobStage"
                                                 @bind-Value="objJob.Stage">

                                        @foreach (JobStage enmStage
                                            in Enum.GetValues<JobStage>())
                                        {
                                            <option value="@enmStage">
                                                @enmStage.GetDisplay().Name
                                            </option>
                                        }

                                    </InputSelect>

                                </div>

                                <div class="col-md-6">

                                    <label class="form-label"
                                           for="company">
                                        Company
                                    </label>

                                    <select id="company"
                                            class="form-select"
                                            @bind="strSelectedCompanyId">

                                        <option value="">
                                            No company linked
                                        </option>

                                        @foreach (Company objCompany
                                            in colCompanies)
                                        {
                                            <option value="@objCompany.Id.ToString()">
                                                @objCompany.Name
                                            </option>
                                        }

                                    </select>

                                </div>

                                <div class="col-md-6">

                                    <label class="form-label"
                                           for="contact">
                                        Contact
                                    </label>

                                    <select id="contact"
                                            class="form-select"
                                            @bind="strSelectedContactId">

                                        <option value="">
                                            No contact linked
                                        </option>

                                        @foreach (Contact objContact
                                            in colContacts)
                                        {
                                            <option value="@objContact.Id.ToString()">
                                                @objContact.Entity.DisplayName
                                            </option>
                                        }

                                    </select>

                                </div>

                                <div class="col-12">

                                    <div class="job-form-section-heading">

                                        <div class="job-form-section-icon">

                                            <span class="material-symbols-outlined">
                                                assignment_ind
                                            </span>

                                        </div>

                                        <div>

                                            <h3>
                                                Assignment
                                            </h3>

                                            <p>
                                                Choose who is responsible for this job.
                                            </p>

                                        </div>

                                    </div>

                                </div>

                                <div class="col-12 col-md-6">

                                    <label class="form-label"
                                           for="assignedUser">
                                        Assigned to
                                    </label>

                                    <InputSelect id="assignedUser"
                                                 class="form-select"
                                                 TValue="Guid?"
                                                 @bind-Value="objJob.AssignedUserId">

                                        <option value="">
                                            Unassigned
                                        </option>

                                        @foreach (User objUser
                                            in AssignableUsers)
                                        {
                                            <option value="@objUser.Id">

                                                @(objUser.Id ==
                                                    CurrentUserState.CurrentUserId
                                                    ? $"{objUser.DisplayName} (You)"
                                                    : objUser.Enabled
                                                        ? objUser.DisplayName
                                                        : $"{objUser.DisplayName} (Disabled)")

                                            </option>
                                        }

                                    </InputSelect>

                                    <div class="form-text">
                                        The person currently responsible for this job.
                                    </div>

                                </div>

                                <div class="col-12">

                                    <div class="job-form-section-heading">

                                        <div class="job-form-section-icon">

                                            <span class="material-symbols-outlined">
                                                home_repair_service
                                            </span>

                                        </div>

                                        <div>

                                            <h3>
                                                Services
                                            </h3>

                                            <p>
                                                Select the work included and set the agreed job pricing.
                                            </p>

                                        </div>

                                        @if (dicServiceLines.Count > 0)
                                        {
                                            <span class="job-services-count">
                                                @dicServiceLines.Count selected
                                            </span>
                                        }

                                    </div>

                                </div>

                                <div class="col-12">

                                    @if (colServices.Count == 0)
                                    {
                                        <div class="job-services-empty">

                                            <span class="material-symbols-outlined">
                                                home_repair_service
                                            </span>

                                            <div>

                                                <strong>
                                                    No services available
                                                </strong>

                                                <span>
                                                    Add services before assigning them to jobs.
                                                </span>

                                            </div>

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="job-services-grid">

                                            @foreach (CrmService objService
                                                in colServices)
                                            {
                                                Boolean blnSelected =
                                                    dicServiceLines.ContainsKey(
                                                        objService.Id);

                                                JobServiceLink? objLine =
                                                    blnSelected
                                                        ? dicServiceLines[objService.Id]
                                                        : null;

                                                <div class="job-service-option @(blnSelected ? "is-selected" : String.Empty)">

                                                    <label class="job-service-selector">

                                                        <input type="checkbox"
                                                               checked="@blnSelected"
                                                               @onchange="@((ChangeEventArgs objArgs) =>
                                                                                                                           SetServiceSelected(
                                                                                                                               objService.Id,
                                                                                                                               Convert.ToBoolean(
                                                                                                                                   objArgs.Value)))" />

                                                        <span class="job-service-check">

                                                            <span class="material-symbols-outlined">
                                                                @(blnSelected
                                                                    ? "check"
                                                                    : "add")
                                                            </span>

                                                        </span>

                                                        <span class="job-service-content">

                                                            <strong>
                                                                @objService.Name
                                                            </strong>

                                                            @if (!String.IsNullOrWhiteSpace(
                                                                objService.Description))
                                                            {
                                                                <small>
                                                                    @objService.Description
                                                                </small>
                                                            }

                                                            @if (!blnSelected &&
                                                                 objService.DefaultPrice.HasValue)
                                                            {
                                                                <span>
                                                                    Default
                                                                    @objService.DefaultPrice.Value.ToString("C")
                                                                </span>
                                                            }

                                                        </span>

                                                    </label>

                                                    @if (objLine != null)
                                                    {
                                                        <div class="job-service-pricing">

                                                            <div>

                                                                <label class="form-label"
                                                                       for="@($"quantity-{objService.Id}")">
                                                                    Quantity
                                                                </label>

                                                                <InputNumber id="@($"quantity-{objService.Id}")"
                                                                             class="form-control"
                                                                             min="0.01"
                                                                             step="0.01"
                                                                             @bind-Value="objLine.Quantity" />

                                                            </div>

                                                            <div>

                                                                <label class="form-label"
                                                                       for="@($"price-{objService.Id}")">
                                                                    Unit price
                                                                </label>

                                                                <div class="input-group">

                                                                    <span class="input-group-text">
                                                                        £
                                                                    </span>

                                                                    <InputNumber id="@($"price-{objService.Id}")"
                                                                                 class="form-control"
                                                                                 min="0"
                                                                                 step="0.01"
                                                                                 @bind-Value="objLine.UnitPrice" />

                                                                </div>

                                                            </div>

                                                            <div class="job-service-line-total">

                                                                <small>
                                                                    Line total
                                                                </small>

                                                                <strong>
                                                                    @FormatMoney(
                                                                        GetLineTotal(
                                                                            objLine))
                                                                </strong>

                                                            </div>

                                                        </div>
                                                    }

                                                </div>
                                            }

                                        </div>

                                        @if (dicServiceLines.Count > 0)
                                        {
                                            <div class="job-services-total">

                                                <div>

                                                    <span class="material-symbols-outlined">
                                                        calculate
                                                    </span>

                                                    <div>

                                                        <small>
                                                            Services total
                                                        </small>

                                                        <strong>
                                                            @FormatMoney(
                                                                GetServicesTotal())
                                                        </strong>

                                                    </div>

                                                </div>

                                                @if (HasUnpricedServiceLines)
                                                {
                                                    <span class="job-services-total-note">
                                                        Some selected services do not have a price yet.
                                                    </span>
                                                }

                                            </div>
                                        }
                                    }

                                </div>

                                <div class="col-12">

                                    <div class="job-form-section-heading">

                                        <div class="job-form-section-icon">

                                            <span class="material-symbols-outlined">
                                                location_on
                                            </span>

                                        </div>

                                        <div>

                                            <h3>
                                                Site details
                                            </h3>

                                            <p>
                                                Where the work will be carried out and how to access the site.
                                            </p>

                                        </div>

                                    </div>

                                </div>

                                <div class="col-12 col-md-8">

                                    <label class="form-label"
                                           for="addressLine1">
                                        Address line 1
                                    </label>

                                    <InputText id="addressLine1"
                                               class="form-control"
                                               @bind-Value="objJob.AddressLine1"
                                               placeholder="Building number and street" />

                                </div>

                                <div class="col-12 col-md-4">

                                    <label class="form-label"
                                           for="postcode">
                                        Postcode
                                    </label>

                                    <InputText id="postcode"
                                               class="form-control text-uppercase"
                                               @bind-Value="objJob.Postcode"
                                               placeholder="NR3 3EH" />

                                </div>

                                <div class="col-12">

                                    <label class="form-label"
                                           for="addressLine2">
                                        Address line 2
                                    </label>

                                    <InputText id="addressLine2"
                                               class="form-control"
                                               @bind-Value="objJob.AddressLine2"
                                               placeholder="Flat, unit, building or locality" />

                                </div>

                                <div class="col-12 col-md-6">

                                    <label class="form-label"
                                           for="town">
                                        Town / city
                                    </label>

                                    <InputText id="town"
                                               class="form-control"
                                               @bind-Value="objJob.Town" />

                                </div>

                                <div class="col-12 col-md-6">

                                    <label class="form-label"
                                           for="county">
                                        County
                                    </label>

                                    <InputText id="county"
                                               class="form-control"
                                               @bind-Value="objJob.County" />

                                </div>

                                <div class="col-12 col-md-6">

                                    <label class="form-label"
                                           for="siteContactName">
                                        Site contact
                                    </label>

                                    <InputText id="siteContactName"
                                               class="form-control"
                                               @bind-Value="objJob.SiteContactName"
                                               placeholder="Person at the property" />

                                </div>

                                <div class="col-12 col-md-6">

                                    <label class="form-label"
                                           for="siteContactPhone">
                                        Site contact phone
                                    </label>

                                    <InputText id="siteContactPhone"
                                               class="form-control"
                                               @bind-Value="objJob.SiteContactPhone"
                                               inputmode="tel"
                                               placeholder="Telephone number" />

                                </div>

                                <div class="col-12">

                                    <label class="form-label"
                                           for="accessNotes">
                                        Access notes
                                    </label>

                                    <InputTextArea id="accessNotes"
                                                   class="form-control job-access-notes"
                                                   @bind-Value="objJob.AccessNotes"
                                                   placeholder="Keys, gate codes, parking, alarms, access restrictions..." />

                                </div>

                                <div class="col-12">

                                    <div class="job-form-section-heading">

                                        <div class="job-form-section-icon">

                                            <span class="material-symbols-outlined">
                                                payments
                                            </span>

                                        </div>

                                        <div>

                                            <h3>
                                                Commercial details
                                            </h3>

                                            <p>
                                                Value, probability, expected close date and source.
                                            </p>

                                        </div>

                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <label class="form-label"
                                           for="value">
                                        Value
                                    </label>

                                    <InputNumber id="value"
                                                 class="form-control"
                                                 disabled="@HasPricedServiceLines"
                                                 @bind-Value="objJob.Value" />

                                    @if (HasPricedServiceLines)
                                    {
                                        <div class="form-text">
                                            Calculated from priced service lines:
                                            <strong>
                                                @FormatMoney(
                                                    GetServicesTotal())
                                            </strong>
                                        </div>
                                    }

                                </div>

                                <div class="col-md-4">

                                    <label class="form-label"
                                           for="probability">
                                        Probability %
                                    </label>

                                    <InputNumber id="probability"
                                                 class="form-control"
                                                 @bind-Value="objJob.ProbabilityPercent" />

                                </div>

                                <div class="col-md-4">

                                    <label class="form-label"
                                           for="closeDate">
                                        Expected close date
                                    </label>

                                    <InputDate id="closeDate"
                                               class="form-control"
                                               @bind-Value="objJob.ExpectedCloseDateUtc" />

                                </div>

                                <div class="col-md-6">

                                    <label class="form-label"
                                           for="source">
                                        Source
                                    </label>

                                    <InputText id="source"
                                               class="form-control"
                                               @bind-Value="objJob.Source" />

                                </div>

                                <div class="col-12">

                                    <div class="job-form-section-heading">

                                        <div class="job-form-section-icon">

                                            <span class="material-symbols-outlined">
                                                description
                                            </span>

                                        </div>

                                        <div>

                                            <h3>
                                                Job information
                                            </h3>

                                            <p>
                                                Description and internal job notes.
                                            </p>

                                        </div>

                                    </div>

                                </div>

                                <div class="col-12">

                                    <label class="form-label"
                                           for="description">
                                        Description
                                    </label>

                                    <InputTextArea id="description"
                                                   class="form-control job-textarea"
                                                   @bind-Value="objJob.Description" />

                                </div>

                                <div class="col-12">

                                    <label class="form-label"
                                           for="notes">
                                        Notes
                                    </label>

                                    <InputTextArea id="notes"
                                                   class="form-control job-textarea"
                                                   @bind-Value="objJob.Notes" />

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <aside class="job-side-column">

                    <div class="crm-card job-summary-card">

                        <h3>
                            Preview
                        </h3>

                        <p class="job-summary-subtitle">
                            Current job details at a glance.
                        </p>

                        <dl>

                            <div>
                                <dt>
                                    Stage
                                </dt>

                                <dd>
                                    @objJob.Stage.GetDisplay().Name
                                </dd>
                            </div>

                            <div>
                                <dt>
                                    Assigned to
                                </dt>

                                <dd>
                                    @GetAssigneeSummary()
                                </dd>
                            </div>

                            <div>
                                <dt>
                                    Company
                                </dt>

                                <dd>
                                    @GetCompanySummary()
                                </dd>
                            </div>

                            <div>
                                <dt>
                                    Site
                                </dt>

                                <dd>
                                    @GetSiteSummary()
                                </dd>
                            </div>

                            <div>
                                <dt>
                                    Services
                                </dt>

                                <dd>
                                    @GetServicesSummary()
                                </dd>
                            </div>

                            <div>
                                <dt>
                                    Value
                                </dt>

                                <dd>
                                    @FormatMoney(
                                        GetEffectiveJobValue())
                                </dd>
                            </div>

                            <div>
                                <dt>
                                    Probability
                                </dt>

                                <dd>
                                    @FormatProbability(
                                        objJob.ProbabilityPercent)
                                </dd>
                            </div>

                            <div>
                                <dt>
                                    Close
                                </dt>

                                <dd>
                                    @FormatDate(
                                        objJob.ExpectedCloseDateUtc)
                                </dd>
                            </div>

                        </dl>

                    </div>

                    <div class="crm-card job-edit-save-card">

                        <div class="job-edit-save-icon">

                            <span class="material-symbols-outlined">
                                save
                            </span>

                        </div>

                        <h3>
                            @(blnEditMode
                                ? "Save changes"
                                : "Create job")
                        </h3>

                        <p>
                            @(blnEditMode
                                ? "Save the updated job details."
                                : "Create this job and add it to the pipeline.")
                        </p>

                        <div class="job-edit-save-actions">

                            <button type="submit"
                                    class="btn crm-btn-primary"
                                    disabled="@blnSaving">

                                @if (blnSaving)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <span class="material-symbols-outlined">
                                        save
                                    </span>
                                }

                                @(blnSaving
                                    ? "Saving..."
                                    : "Save job")

                            </button>

                            <button type="button"
                                    class="btn crm-btn-secondary"
                                    disabled="@blnSaving"
                                    @onclick="GoBack">

                                Cancel

                            </button>

                        </div>

                    </div>

                </aside>

            </div>

        </EditForm>
    }

</section>

@code {
    [Parameter]
    public Guid? JobId { get; set; }

    [SupplyParameterFromQuery(Name = "companyId")]
    public Guid? CompanyId { get; set; }

    [SupplyParameterFromQuery(Name = "contactId")]
    public Guid? ContactId { get; set; }

    private Job objJob =
        new();

    private List<Company> colCompanies =
        [];

    private List<Contact> colContacts =
        [];

    private List<CrmService> colServices =
        [];

    private List<User> colUsers =
        [];

    private Dictionary<Guid, JobServiceLink> dicServiceLines =
        [];

    private String strPageTitle =
        "New job";

    private String? strErrorMessage;

    private Boolean blnLoading =
        true;

    private Boolean blnSaving;

    private Boolean blnEditMode =>
        JobId.HasValue &&
        JobId.Value != Guid.Empty;

    private IEnumerable<User> AssignableUsers =>
        colUsers
            .Where(objUser =>
                objUser.Enabled ||
                objUser.Id ==
                    objJob.AssignedUserId)
            .OrderBy(objUser =>
                objUser.DisplayName);

    private Boolean HasPricedServiceLines =>
        dicServiceLines
            .Values
            .Any(objLine =>
                objLine.UnitPrice.HasValue);

    private Boolean HasUnpricedServiceLines =>
        dicServiceLines
            .Values
            .Any(objLine =>
                !objLine.UnitPrice.HasValue);

    private String strSelectedCompanyId
    {
        get =>
            objJob.CompanyId?.ToString() ??
            String.Empty;

        set
        {
            objJob.CompanyId =
                Guid.TryParse(
                    value,
                    out Guid objCompanyId)
                    ? objCompanyId
                    : null;
        }
    }

    private String strSelectedContactId
    {
        get =>
            objJob.ContactId?.ToString() ??
            String.Empty;

        set
        {
            objJob.ContactId =
                Guid.TryParse(
                    value,
                    out Guid objContactId)
                    ? objContactId
                    : null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        blnLoading =
            true;

        strErrorMessage =
            null;

        try
        {
            Task<List<Company>> objCompaniesTask =
                CompanyService.GetCompaniesAsync();

            Task<List<Contact>> objContactsTask =
                ContactService.GetContactsAsync();

            Task<List<CrmService>> objServicesTask =
                ServiceService.GetServicesAsync();

            Task<List<User>> objUsersTask =
                UserService.GetUsersAsync(
                    true);

            await Task.WhenAll(
                objCompaniesTask,
                objContactsTask,
                objServicesTask,
                objUsersTask);

            colCompanies =
                (await objCompaniesTask)
                    .OrderBy(objCompany =>
                        objCompany.Name)
                    .ToList();

            colContacts =
                (await objContactsTask)
                    .OrderBy(objContact =>
                        objContact.Entity.DisplayName)
                    .ToList();

            colServices =
                (await objServicesTask)
                    .OrderBy(objService =>
                        objService.Name)
                    .ToList();

            colUsers =
                (await objUsersTask)
                    .OrderBy(objUser =>
                        objUser.DisplayName)
                    .ToList();

            if (blnEditMode)
            {
                Job? objExistingJob =
                    await JobService.GetJobByIdAsync(
                        JobId!.Value);

                if (objExistingJob == null)
                {
                    strErrorMessage =
                        "Job not found.";

                    HeaderState.SetHeader(
                        "Job not found",
                        "The selected job could not be loaded");

                    return;
                }

                objJob =
                    objExistingJob;

                dicServiceLines =
                    objJob.ServiceLinks
                        .GroupBy(objLink =>
                            objLink.ServiceId)
                        .ToDictionary(
                            objGroup =>
                                objGroup.Key,
                            objGroup =>
                            {
                                JobServiceLink objExistingLink =
                                    objGroup.First();

                                return new JobServiceLink
                                {
                                    JobId =
                                        objJob.Id,

                                    ServiceId =
                                        objExistingLink.ServiceId,

                                    Quantity =
                                        objExistingLink.Quantity,

                                    UnitPrice =
                                        objExistingLink.UnitPrice,

                                    Service =
                                        objExistingLink.Service
                                };
                            });

                strPageTitle =
                    "Edit " +
                    objJob.Name;

                HeaderState.SetHeader(
                    "Edit job",
                    objJob.Name);

                return;
            }

            Guid? objCurrentUserId =
                await CurrentUserState
                    .GetCurrentUserIdAsync();

            objJob =
                new Job
                {
                    CompanyId =
                        CompanyId,

                    ContactId =
                        ContactId,

                    AssignedUserId =
                        objCurrentUserId,

                    Stage =
                        JobStage.New
                };

            dicServiceLines =
                [];

            strPageTitle =
                "New job";

            HeaderState.SetHeader(
                "New job",
                "Create a new job");
        }
        catch (Exception objError)
        {
            strErrorMessage =
                "Failed to load job form: " +
                objError.Message;
        }
        finally
        {
            blnLoading =
                false;
        }
    }

    private async Task SaveJobAsync()
    {
        if (blnSaving)
        {
            return;
        }

        blnSaving =
            true;

        strErrorMessage =
            null;

        try
        {
            objJob.ServiceLinks =
                dicServiceLines
                    .Values
                    .Select(objLine =>
                        new JobServiceLink
                        {
                            JobId =
                                objJob.Id,

                            ServiceId =
                                objLine.ServiceId,

                            Quantity =
                                objLine.Quantity,

                            UnitPrice =
                                objLine.UnitPrice
                        })
                    .ToList();

            if (HasPricedServiceLines)
            {
                objJob.Value =
                    GetServicesTotal();
            }

            Job objSavedJob;

            if (blnEditMode)
            {
                Job? objUpdatedJob =
                    await JobService.UpdateJobAsync(
                        objJob);

                if (objUpdatedJob == null)
                {
                    strErrorMessage =
                        "The job could not be updated.";

                    return;
                }

                objSavedJob =
                    objUpdatedJob;
            }
            else
            {
                objSavedJob =
                    await JobService.AddJobAsync(
                        objJob);
            }

            Navigation.NavigateTo(
                $"/jobs/{objSavedJob.Id}");
        }
        catch (Exception objError)
        {
            strErrorMessage =
                "Failed to save job: " +
                objError.Message;
        }
        finally
        {
            blnSaving =
                false;
        }
    }

    private void SetServiceSelected(
        Guid objServiceId,
        Boolean blnSelected)
    {
        if (!blnSelected)
        {
            dicServiceLines.Remove(
                objServiceId);

            return;
        }

        if (dicServiceLines.ContainsKey(
            objServiceId))
        {
            return;
        }

        CrmService? objService =
            colServices.FirstOrDefault(
                objService =>
                    objService.Id ==
                    objServiceId);

        if (objService == null)
        {
            return;
        }

        dicServiceLines.Add(
            objServiceId,
            new JobServiceLink
            {
                JobId =
                    objJob.Id,

                ServiceId =
                    objService.Id,

                Service =
                    objService,

                Quantity =
                    1m,

                UnitPrice =
                    objService.DefaultPrice
            });
    }

    private Decimal GetServicesTotal()
    {
        return dicServiceLines
            .Values
            .Where(objLine =>
                objLine.UnitPrice.HasValue)
            .Sum(objLine =>
                GetLineTotal(
                    objLine));
    }

    private Decimal? GetEffectiveJobValue()
    {
        return HasPricedServiceLines
            ? GetServicesTotal()
            : objJob.Value;
    }

    private static Decimal GetLineTotal(
        JobServiceLink objLine)
    {
        Decimal dcmQuantity =
            objLine.Quantity <= 0m
                ? 1m
                : objLine.Quantity;

        return dcmQuantity *
            (objLine.UnitPrice ?? 0m);
    }

    private String GetAssigneeSummary()
    {
        if (!objJob.AssignedUserId.HasValue)
        {
            return "Unassigned";
        }

        User? objUser =
            colUsers.FirstOrDefault(
                objUser =>
                    objUser.Id ==
                    objJob.AssignedUserId.Value);

        return objUser?.DisplayName ??
            "Unknown user";
    }

    private String GetCompanySummary()
    {
        if (!objJob.CompanyId.HasValue)
        {
            return "None";
        }

        Company? objCompany =
            colCompanies.FirstOrDefault(
                objCompany =>
                    objCompany.Id ==
                    objJob.CompanyId.Value);

        return objCompany?.Name ??
            "Selected";
    }

    private String GetSiteSummary()
    {
        List<String> colParts =
            new[]
            {
                objJob.AddressLine1,
                objJob.Town,
                objJob.Postcode
            }
            .Where(strValue =>
                !String.IsNullOrWhiteSpace(
                    strValue))
            .Select(strValue =>
                strValue!.Trim())
            .ToList();

        return colParts.Count == 0
            ? "Not set"
            : String.Join(
                ", ",
                colParts);
    }

    private String GetServicesSummary()
    {
        if (dicServiceLines.Count == 0)
        {
            return "None";
        }

        List<String> colSelectedNames =
            colServices
                .Where(objService =>
                    dicServiceLines.ContainsKey(
                        objService.Id))
                .Select(objService =>
                    objService.Name)
                .ToList();

        if (colSelectedNames.Count == 0)
        {
            return
                $"{dicServiceLines.Count} selected";
        }

        if (colSelectedNames.Count == 1)
        {
            return colSelectedNames[0];
        }

        if (colSelectedNames.Count == 2)
        {
            return String.Join(
                ", ",
                colSelectedNames);
        }

        return
            $"{colSelectedNames.Count} services";
    }

    private void GoBack()
    {
        if (blnEditMode)
        {
            Navigation.NavigateTo(
                $"/jobs/{JobId}");

            return;
        }

        Navigation.NavigateTo(
            "/jobs");
    }

    private static String FormatMoney(
        Decimal dcmValue)
    {
        return dcmValue.ToString("C");
    }

    private static String FormatMoney(
        Decimal? dcmValue)
    {
        return dcmValue.HasValue
            ? dcmValue.Value.ToString("C")
            : "Not set";
    }

    private static String FormatProbability(
        Int32? intProbability)
    {
        return intProbability.HasValue
            ? $"{intProbability.Value}%"
            : "Not set";
    }

    private static String FormatDate(
        DateTime? dteDate)
    {
        return dteDate.HasValue
            ? dteDate.Value
                .ToLocalTime()
                .ToString("dd MMM yyyy")
            : "Not set";
    }
}