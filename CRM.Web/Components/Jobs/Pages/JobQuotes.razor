@page "/jobs/{JobId:guid}/quotes"
@attribute [Authorize]
@rendermode InteractiveServer
@using CRM.Core.Quotes
@inject IQuoteService Quotes

<SeoHead Title="Job quotes" />
<section class="p-4">
    <a href="@($"/jobs/{JobId}")">Back to job</a>
    <h1 class="mt-3">Quotes</h1>
    <p>Each quote saves the job’s services, quantities, prices and customer details at creation. Create a new quote when the scope changes.</p>
    @if (error != null)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    <button class="btn btn-primary mb-3" disabled="@(busy || loading)" @onclick="CreateAsync">@(busy ? "Creating…" : "Create quote")</button>
    @if (loading)
    {
        <p>Loading quotes…</p>
    }
    else if (quotes.Count == 0)
    {
        <p>No quotes yet. All job services must have a price before creating a quote.</p>
    }
    @foreach (var quote in quotes)
    {
        <article class="card mb-3" id="@($"quote-{quote.Id}")">
            <div class="card-body">
                <h2 class="h5">@quote.QuoteNumber</h2>
                <p>@quote.CustomerName · @quote.JobName · @quote.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
                <p>@string.Join(", ", new[] { quote.AddressLine1, quote.AddressLine2, quote.Town, quote.County, quote.Postcode }.Where(value => !string.IsNullOrWhiteSpace(value)))</p>
                <div class="table-responsive">
                    <table class="table">
                        <thead><tr><th>Service</th><th>Quantity</th><th>Unit price</th><th>Total</th></tr></thead>
                        <tbody>
                            @foreach (var line in quote.Lines.OrderBy(line => line.SortOrder))
                            {
                                <tr><td>@line.Description</td><td>@line.Quantity.ToString("0.##")</td><td>@line.UnitPrice.ToString("C")</td><td>@line.LineTotal.ToString("C")</td></tr>
                            }
                        </tbody>
                        <tfoot><tr><th colspan="3">Total</th><th>@quote.Total.ToString("C")</th></tr></tfoot>
                    </table>
                </div>
                @if (!string.IsNullOrWhiteSpace(quote.Notes)) { <p>@quote.Notes</p> }
                <a class="btn btn-outline-primary" href="@($"/quotes/{quote.Id}/quote.pdf")" target="_blank">Export PDF</a>
            </div>
        </article>
    }
</section>

@code {
    [Parameter] public Guid JobId { get; set; }
    private List<Quote> quotes = [];
    private bool loading = true;
    private bool busy;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        try { quotes = await Quotes.GetForJobAsync(JobId); }
        catch (Exception) { error = "Unable to load quotes. Please try again."; }
        finally { loading = false; }
    }

    private async Task CreateAsync()
    {
        if (busy) return;
        busy = true;
        error = null;
        try
        {
            var quote = await Quotes.CreateFromJobAsync(JobId, await UserState.GetCurrentUserIdAsync());
            quotes.Insert(0, quote);
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        catch (Exception) { error = "Unable to create the quote. Please try again."; }
        finally { busy = false; }
    }
}
