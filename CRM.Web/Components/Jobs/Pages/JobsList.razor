@page "/jobs"

@attribute [Authorize]
@rendermode InteractiveServer

@using CRM.Core.Jobs.Domain
@using CRM.Core.Jobs.Abstractions
@using CRM.Core.Services.Abstractions
@using CRM.Web.State
@using CrmService = CRM.Core.Services.Domain.Service

@inject IJobService JobService
@inject IServiceService ServiceService
@inject NavigationManager Navigation
@inject PageHeaderState HeaderState

<SeoHead Title="Jobs" />

<section class="jobs-page">

    @if (CompanyId.HasValue)
    {
        <div class="jobs-context-filter">

            <div class="jobs-context-filter-main">

                <span class="material-symbols-outlined">
                    apartment
                </span>

                <div>
                    <strong>
                        Company filter active
                    </strong>

                    <span>
                        Showing jobs linked to this company.
                    </span>
                </div>

            </div>

            <button type="button"
                    class="btn btn-soft-secondary btn-sm"
                    @onclick="ClearCompanyFilterAsync">

                <span class="material-symbols-outlined">
                    close
                </span>

                Clear company filter

            </button>

        </div>
    }

    <div class="crm-card jobs-toolbar">

        <div class="jobs-search">

            <div class="input-group">

                <span class="input-group-text">

                    <span class="material-symbols-outlined">
                        search
                    </span>

                </span>

                <input id="jobSearch"
                       class="form-control"
                       placeholder="Search jobs, addresses, postcodes, companies or contacts..."
                       @bind="strSearch"
                       @bind:event="oninput"
                       @onkeydown="SearchKeyDownAsync" />

            </div>

        </div>

        <div class="jobs-filters">

            <select class="form-select jobs-stage-filter"
                    @bind="strSelectedStage"
                    @bind:after="StageChangedAsync">

                <option value="">
                    All stages
                </option>

                @foreach (JobStage enmStage
                    in Enum.GetValues<JobStage>())
                {
                    <option value="@enmStage.ToString()">
                        @enmStage.GetDisplay().Name
                    </option>
                }

            </select>

            <select class="form-select jobs-service-filter"
                    @bind="strSelectedServiceId"
                    @bind:after="ServiceChangedAsync">

                <option value="">
                    All services
                </option>

                @foreach (CrmService objService
                    in colServices)
                {
                    <option value="@objService.Id.ToString()">
                        @objService.Name
                    </option>
                }

            </select>

            <div class="jobs-filter-divider"></div>

            <div class="form-check form-switch">

                <input id="includeArchived"
                       class="form-check-input"
                       type="checkbox"
                       @bind="blnIncludeArchived"
                       @bind:after="LoadJobsAsync" />

                <label class="form-check-label"
                       for="includeArchived">
                    Include archived
                </label>

            </div>

        </div>

        <div class="jobs-toolbar-actions">

            <button class="btn btn-primary"
                    type="button"
                    @onclick="SearchAsync">

                <span class="material-symbols-outlined">
                    search
                </span>

                Search

            </button>

        </div>

    </div>

    <div class="jobs-summary row g-3">

        <div class="col-12 col-md-6 col-xl-3">

            <div class="jobs-summary-card jobs-summary-card-primary">

                <span class="material-symbols-outlined">
                    track_changes
                </span>

                <div>

                    <small>
                        Open shown
                    </small>

                    <strong>
                        @intOpenJobs
                    </strong>

                    <span class="jobs-summary-note">
                        @intTotalJobs total result@(GetPlural(intTotalJobs))
                    </span>

                </div>

            </div>

        </div>

        <div class="col-12 col-md-6 col-xl-3">

            <div class="jobs-summary-card jobs-summary-card-success">

                <span class="material-symbols-outlined">
                    payments
                </span>

                <div>

                    <small>
                        Open pipeline
                    </small>

                    <strong>
                        @FormatMoney(dcmOpenPipelineValue)
                    </strong>

                    <span class="jobs-summary-note">
                        Active non-paid/lost value
                    </span>

                </div>

            </div>

        </div>

        <div class="col-12 col-md-6 col-xl-3">

            <div class="jobs-summary-card jobs-summary-card-warning">

                <span class="material-symbols-outlined">
                    event_upcoming
                </span>

                <div>

                    <small>
                        Closing soon
                    </small>

                    <strong>
                        @intClosingSoonJobs
                    </strong>

                    <span class="jobs-summary-note">
                        Due before
                        @dteClosingSoonCutoffUtc.ToLocalTime().ToString("dd MMM")
                    </span>

                </div>

            </div>

        </div>

        <div class="col-12 col-md-6 col-xl-3">

            <div class="jobs-summary-card jobs-summary-card-info">

                <span class="material-symbols-outlined">
                    emoji_events
                </span>

                <div>

                    <small>
                        Paid shown
                    </small>

                    <strong>
                        @intWonJobs
                    </strong>

                    <span class="jobs-summary-note">
                        @FormatMoney(dcmWonValue) paid value
                    </span>

                </div>

            </div>

        </div>

    </div>

    @if (blnShowErrorAlert &&
         !String.IsNullOrWhiteSpace(
             strErrorMessage))
    {
        <div class="alert alert-danger jobs-alert"
             role="alert">

            <span class="material-symbols-outlined">
                error
            </span>

            <div class="alert-content">

                <strong class="alert-title">
                    Unable to load jobs
                </strong>

                <p>
                    @strErrorMessage
                </p>

            </div>

            <div class="alert-actions">

                <button class="btn btn-soft-danger btn-sm"
                        type="button"
                        @onclick="LoadJobsAsync">

                    <span class="material-symbols-outlined">
                        refresh
                    </span>

                    Try again

                </button>

                <button class="btn btn-soft-danger btn-sm jobs-alert-close"
                        type="button"
                        @onclick="DismissErrorAlert">

                    <span class="material-symbols-outlined">
                        close
                    </span>

                </button>

            </div>

        </div>
    }

    <div class="crm-card jobs-results-card">

        <div class="crm-card-header">

            <div>

                <h3>
                    Job records
                </h3>

                <p>
                    @strResultSummary
                </p>

            </div>

            @if (HasActiveFilters)
            {
                <button class="btn btn-soft-secondary btn-sm"
                        type="button"
                        @onclick="ClearFiltersAsync">

                    <span class="material-symbols-outlined">
                        filter_alt_off
                    </span>

                    Clear filters

                </button>
            }

        </div>

        @if (blnLoading)
        {
            <div class="crm-loading">

                <span class="spinner-border spinner-border-sm"></span>

                Loading jobs...

            </div>
        }
        else if (!colJobs.Any())
        {
            <div class="crm-empty-state">

                <span class="material-symbols-outlined">
                    empty_dashboard
                </span>

                <h4>
                    No jobs found
                </h4>

                <p>

                    @if (CompanyId.HasValue)
                    {
                        <text>
                            No jobs are currently linked to this company.
                        </text>
                    }
                    else if (ServiceId.HasValue)
                    {
                        <text>
                            No jobs currently use the selected service.
                        </text>
                    }
                    else
                    {
                        <text>
                            Create your first job or adjust the filters.
                        </text>
                    }

                </p>

                <a class="btn btn-primary"
                   href="@GetAddJobUrl()">

                    <span class="material-symbols-outlined">
                        add_circle
                    </span>

                    Add job

                </a>

            </div>
        }
        else
        {
            <div class="jobs-table-view">

                <div class="table-responsive">

                    <table class="table table-hover align-middle crm-table jobs-table">

                        <thead>

                            <tr>
                                <th>Job</th>
                                <th>Site</th>
                                <th>Company</th>
                                <th>Stage</th>
                                <th>Value</th>
                                <th>Close date</th>
                                <th>Status</th>

                                <th class="text-end">
                                    Actions
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (Job objJob
                                in colJobs)
                            {
                                <tr class="@GetJobRowClass(objJob)">

                                    <td>

                                        <div class="jobs-job-cell">

                                            <div class="jobs-avatar">
                                                @GetJobInitial(objJob)
                                            </div>

                                            <div class="jobs-job-content">

                                                <a class="jobs-name-link"
                                                   href="@GetJobUrl(objJob.Id)">

                                                    @objJob.Name

                                                </a>

                                                @if (!String.IsNullOrWhiteSpace(
                                                    objJob.Source))
                                                {
                                                    <small>
                                                        Source: @objJob.Source
                                                    </small>
                                                }

                                            </div>

                                        </div>

                                    </td>

                                    <td>

                                        @if (HasAddress(objJob))
                                        {
                                            <div class="jobs-site-cell">

                                                <span class="material-symbols-outlined">
                                                    location_on
                                                </span>

                                                <div>

                                                    <strong>
                                                        @GetPrimaryAddressLine(objJob)
                                                    </strong>

                                                    @if (!String.IsNullOrWhiteSpace(
                                                        GetSecondaryAddressLine(objJob)))
                                                    {
                                                        <small>
                                                            @GetSecondaryAddressLine(objJob)
                                                        </small>
                                                    }

                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="jobs-muted">
                                                No address
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (objJob.Company != null)
                                        {
                                            <a class="jobs-company-link"
                                               href="@GetCompanyUrl(
                                                                                                  objJob.Company.Id)">

                                                @objJob.Company.Name

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="jobs-muted">
                                                Not linked
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <span class="@GetStageBadgeClass(
                                                                                        objJob.Stage)">

                                            @objJob.Stage.GetDisplay().Name

                                        </span>

                                    </td>

                                    <td>
                                        @FormatMoney(objJob.Value)
                                    </td>

                                    <td>

                                        <span class="@GetCloseDateClass(objJob)">
                                            @FormatDate(
                                                objJob.ExpectedCloseDateUtc)
                                        </span>

                                    </td>

                                    <td>

                                        @if (objJob.IsArchived)
                                        {
                                            <span class="badge text-bg-secondary">
                                                Archived
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success">
                                                Active
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <div class="jobs-row-actions">

                                            <a href="@GetJobUrl(objJob.Id)"
                                               class="btn btn-soft-primary btn-sm">

                                                <span class="material-symbols-outlined">
                                                    visibility
                                                </span>

                                                View

                                            </a>

                                            <a href="@($"/jobs/{objJob.Id}/edit")"
                                               class="btn btn-soft-secondary btn-sm">

                                                <span class="material-symbols-outlined">
                                                    edit
                                                </span>

                                                Edit

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

            <div class="jobs-mobile-list">

                @foreach (Job objJob
                    in colJobs)
                {
                    <article class="jobs-mobile-card @GetJobRowClass(objJob)">

                        <a href="@GetJobUrl(objJob.Id)"
                           class="jobs-mobile-main">

                            <div class="jobs-mobile-avatar">
                                @GetJobInitial(objJob)
                            </div>

                            <div class="jobs-mobile-content">

                                <div class="jobs-mobile-title-row">

                                    <strong>
                                        @objJob.Name
                                    </strong>

                                    <span class="@GetStageBadgeClass(
                                                                                objJob.Stage)">

                                        @objJob.Stage.GetDisplay().Name

                                    </span>

                                </div>

                                @if (HasAddress(objJob))
                                {
                                    <div class="jobs-mobile-address">

                                        <span class="material-symbols-outlined">
                                            location_on
                                        </span>

                                        <span>
                                            @GetCompactAddress(objJob)
                                        </span>

                                    </div>
                                }
                                else
                                {
                                    <div class="jobs-mobile-address jobs-mobile-address-muted">

                                        <span class="material-symbols-outlined">
                                            location_off
                                        </span>

                                        <span>
                                            No site address
                                        </span>

                                    </div>
                                }

                                <span class="jobs-mobile-company">
                                    @(objJob.Company?.Name ??
                                      "No company linked")
                                </span>

                            </div>

                            <span class="material-symbols-outlined jobs-mobile-arrow">
                                chevron_right
                            </span>

                        </a>

                        <div class="jobs-mobile-meta">

                            <div>

                                <small>
                                    Value
                                </small>

                                <strong>
                                    @FormatMoney(objJob.Value)
                                </strong>

                            </div>

                            <div>

                                <small>
                                    Close date
                                </small>

                                <strong class="@GetCloseDateClass(objJob)">
                                    @FormatDate(
                                        objJob.ExpectedCloseDateUtc)
                                </strong>

                            </div>

                            <div>

                                <small>
                                    Services
                                </small>

                                <strong>
                                    @FormatServiceCount(
                                        objJob.ServiceLinks.Count)
                                </strong>

                            </div>

                        </div>

                        <div class="jobs-mobile-footer">

                            <div>

                                @if (objJob.IsArchived)
                                {
                                    <span class="badge text-bg-secondary">
                                        Archived
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">
                                        Active
                                    </span>
                                }

                            </div>

                            <div class="jobs-mobile-actions">

                                <a href="@GetJobUrl(objJob.Id)"
                                   class="btn btn-soft-primary">

                                    <span class="material-symbols-outlined">
                                        visibility
                                    </span>

                                    View

                                </a>

                                <a href="@($"/jobs/{objJob.Id}/edit")"
                                   class="btn btn-soft-secondary">

                                    <span class="material-symbols-outlined">
                                        edit
                                    </span>

                                    Edit

                                </a>

                            </div>

                        </div>

                    </article>
                }

            </div>
        }

    </div>

</section>

@code {
    [SupplyParameterFromQuery(Name = "stage")]
    public String? Stage { get; set; }

    [SupplyParameterFromQuery(Name = "overdue")]
    public Boolean Overdue { get; set; }

    [SupplyParameterFromQuery(Name = "companyId")]
    public Guid? CompanyId { get; set; }

    [SupplyParameterFromQuery(Name = "serviceId")]
    public Guid? ServiceId { get; set; }

    private List<Job> colJobs =
        [];

    private List<CrmService> colServices =
        [];

    private String? strSearch;

    private String? strErrorMessage;

    private String strSelectedStage =
        String.Empty;

    private String strSelectedServiceId =
        String.Empty;

    private String strResultSummary =
        "Showing active job records.";

    private Boolean blnIncludeArchived;

    private Boolean blnLoading =
        true;

    private Boolean blnShowErrorAlert =
        true;

    private Int32 intTotalJobs;

    private Int32 intOpenJobs;

    private Int32 intClosingSoonJobs;

    private Int32 intWonJobs;

    private Decimal dcmOpenPipelineValue;

    private Decimal dcmWonValue;

    private DateTime dteClosingSoonCutoffUtc =
        DateTime.UtcNow.Date.AddDays(30);

    private Boolean HasActiveFilters =>
        !String.IsNullOrWhiteSpace(
            strSearch) ||
        !String.IsNullOrWhiteSpace(
            strSelectedStage) ||
        ServiceId.HasValue ||
        blnIncludeArchived ||
        Overdue ||
        CompanyId.HasValue;

    private JobStage? SelectedStage
    {
        get
        {
            if (Enum.TryParse(
                strSelectedStage,
                true,
                out JobStage enmStage))
            {
                return enmStage;
            }

            return null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        HeaderState.SetHeader(
            "Jobs",
            "Track jobs, sites, pipeline value and expected close dates.",
            GetHeaderActions());

        await LoadServicesAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        ApplyQueryFilters();

        await LoadJobsAsync();
    }

    private RenderFragment GetHeaderActions()
    {
        return @<a class="btn btn-primary"
               href="@GetAddJobUrl()">

            <span class="material-symbols-outlined">
                add_circle
            </span>

            Add job

        </a>;
    }

    private async Task LoadServicesAsync()
    {
        colServices =
            (await ServiceService.GetServicesAsync())
                .OrderBy(
                    objService =>
                        objService.Name)
                .ToList();
    }

    private void ApplyQueryFilters()
    {
        if (String.IsNullOrWhiteSpace(
            Stage))
        {
            strSelectedStage =
                String.Empty;
        }
        else if (Enum.TryParse(
            Stage,
            true,
            out JobStage enmStage))
        {
            strSelectedStage =
                enmStage.ToString();
        }
        else
        {
            strSelectedStage =
                String.Empty;
        }

        strSelectedServiceId =
            ServiceId.HasValue
                ? ServiceId.Value.ToString()
                : String.Empty;
    }

    private Task SearchAsync()
    {
        return LoadJobsAsync();
    }

    private async Task SearchKeyDownAsync(
        KeyboardEventArgs objArgs)
    {
        if (objArgs.Key != "Enter")
        {
            return;
        }

        await LoadJobsAsync();
    }

    private Task StageChangedAsync()
    {
        Navigation.NavigateTo(
            BuildJobsUrl(
                strSelectedStage,
                Overdue,
                CompanyId,
                ServiceId),
            replace: true);

        return Task.CompletedTask;
    }

    private Task ServiceChangedAsync()
    {
        ServiceId =
            Guid.TryParse(
                strSelectedServiceId,
                out Guid objServiceId)
                ? objServiceId
                : null;

        Navigation.NavigateTo(
            BuildJobsUrl(
                strSelectedStage,
                Overdue,
                CompanyId,
                ServiceId),
            replace: true);

        return Task.CompletedTask;
    }

    private Task ClearCompanyFilterAsync()
    {
        Navigation.NavigateTo(
            BuildJobsUrl(
                strSelectedStage,
                Overdue,
                null,
                ServiceId),
            replace: true);

        return Task.CompletedTask;
    }

    private async Task LoadJobsAsync()
    {
        blnLoading =
            true;

        strErrorMessage =
            null;

        blnShowErrorAlert =
            true;

        try
        {
            colJobs =
                await JobService.GetJobsAsync(
                    strSearch,
                    SelectedStage,
                    CompanyId,
                    ServiceId,
                    blnIncludeArchived,
                    false,
                    Overdue);

            SetJobStats();

            SetResultSummary();
        }
        catch (Exception objError)
        {
            strErrorMessage =
                "We couldn’t retrieve the job records right now. " +
                objError.Message;

            colJobs =
                [];

            intTotalJobs =
                0;

            intOpenJobs =
                0;

            intClosingSoonJobs =
                0;

            intWonJobs =
                0;

            dcmOpenPipelineValue =
                0;

            dcmWonValue =
                0;

            SetResultSummary();
        }
        finally
        {
            blnLoading =
                false;
        }
    }

    private async Task ClearFiltersAsync()
    {
        strSearch =
            null;

        strSelectedStage =
            String.Empty;

        strSelectedServiceId =
            String.Empty;

        blnIncludeArchived =
            false;

        Stage =
            null;

        ServiceId =
            null;

        Overdue =
            false;

        CompanyId =
            null;

        Navigation.NavigateTo(
            "/jobs",
            replace: true);

        await LoadJobsAsync();
    }

    private void DismissErrorAlert()
    {
        blnShowErrorAlert =
            false;
    }

    private void SetJobStats()
    {
        DateTime dteTodayUtc =
            DateTime.UtcNow.Date;

        dteClosingSoonCutoffUtc =
            dteTodayUtc.AddDays(30);

        intTotalJobs =
            colJobs.Count;

        intOpenJobs =
            colJobs.Count(
                IsOpenJob);

        dcmOpenPipelineValue =
            colJobs
                .Where(IsOpenJob)
                .Sum(
                    objJob =>
                        objJob.Value ?? 0m);

        intClosingSoonJobs =
            colJobs.Count(
                objJob =>
                    IsOpenJob(objJob) &&
                    objJob.ExpectedCloseDateUtc.HasValue &&
                    objJob.ExpectedCloseDateUtc.Value.Date >=
                        dteTodayUtc &&
                    objJob.ExpectedCloseDateUtc.Value.Date <=
                        dteClosingSoonCutoffUtc);

        intWonJobs =
            colJobs.Count(
                objJob =>
                    !objJob.Entity.ArchivedUtc.HasValue &&
                    objJob.Stage ==
                        JobStage.Paid);

        dcmWonValue =
            colJobs
                .Where(
                    objJob =>
                        !objJob.Entity.ArchivedUtc.HasValue &&
                        objJob.Stage ==
                            JobStage.Paid)
                .Sum(
                    objJob =>
                        objJob.Value ?? 0m);
    }

    private void SetResultSummary()
    {
        List<String> colFilters =
            [];

        if (!String.IsNullOrWhiteSpace(
            strSearch))
        {
            colFilters.Add(
                $"matching \"{strSearch}\"");
        }

        if (SelectedStage.HasValue)
        {
            colFilters.Add(
                $"in {SelectedStage.Value.GetDisplay().Name}");
        }

        if (ServiceId.HasValue)
        {
            CrmService? objService =
                colServices.FirstOrDefault(
                    objService =>
                        objService.Id ==
                        ServiceId.Value);

            colFilters.Add(
                objService != null
                    ? $"for {objService.Name}"
                    : "for the selected service");
        }

        if (Overdue)
        {
            colFilters.Add(
                "overdue");
        }

        if (CompanyId.HasValue)
        {
            colFilters.Add(
                "for the selected company");
        }

        if (blnIncludeArchived)
        {
            colFilters.Add(
                "including archived");
        }

        if (colFilters.Count == 0)
        {
            strResultSummary =
                $"Showing {intTotalJobs} job record{GetPlural(intTotalJobs)}.";

            return;
        }

        strResultSummary =
            $"Showing {intTotalJobs} result{GetPlural(intTotalJobs)} " +
            String.Join(
                ", ",
                colFilters) +
            ".";
    }

    private String GetAddJobUrl()
    {
        if (CompanyId.HasValue)
        {
            return
                $"/jobs/add?companyId={CompanyId.Value}";
        }

        return "/jobs/add";
    }

    private static String BuildJobsUrl(
        String? strStage,
        Boolean blnOverdue,
        Guid? objCompanyId,
        Guid? objServiceId)
    {
        List<String> colQuery =
            [];

        if (!String.IsNullOrWhiteSpace(
            strStage))
        {
            colQuery.Add(
                $"stage={Uri.EscapeDataString(strStage)}");
        }

        if (blnOverdue)
        {
            colQuery.Add(
                "overdue=true");
        }

        if (objCompanyId.HasValue)
        {
            colQuery.Add(
                $"companyId={objCompanyId.Value}");
        }

        if (objServiceId.HasValue)
        {
            colQuery.Add(
                $"serviceId={objServiceId.Value}");
        }

        if (colQuery.Count == 0)
        {
            return "/jobs";
        }

        return
            "/jobs?" +
            String.Join(
                "&",
                colQuery);
    }

    private static Boolean IsOpenJob(
        Job objJob)
    {
        return
            !objJob.Entity.ArchivedUtc.HasValue &&
            objJob.Stage != JobStage.Paid &&
            objJob.Stage != JobStage.Lost;
    }

    private static Boolean HasAddress(
        Job objJob)
    {
        return
            !String.IsNullOrWhiteSpace(
                objJob.AddressLine1) ||
            !String.IsNullOrWhiteSpace(
                objJob.AddressLine2) ||
            !String.IsNullOrWhiteSpace(
                objJob.Town) ||
            !String.IsNullOrWhiteSpace(
                objJob.County) ||
            !String.IsNullOrWhiteSpace(
                objJob.Postcode);
    }

    private static String GetPrimaryAddressLine(
        Job objJob)
    {
        if (!String.IsNullOrWhiteSpace(
            objJob.AddressLine1))
        {
            return objJob.AddressLine1.Trim();
        }

        if (!String.IsNullOrWhiteSpace(
            objJob.Town))
        {
            return objJob.Town.Trim();
        }

        if (!String.IsNullOrWhiteSpace(
            objJob.Postcode))
        {
            return objJob.Postcode.Trim();
        }

        return "Site address";
    }

    private static String GetSecondaryAddressLine(
        Job objJob)
    {
        String strPrimary =
            GetPrimaryAddressLine(
                objJob);

        List<String> colParts =
            new[]
            {
                objJob.AddressLine2,
                objJob.Town,
                objJob.Postcode
            }
            .Where(
                strValue =>
                    !String.IsNullOrWhiteSpace(
                        strValue))
            .Select(
                strValue =>
                    strValue!.Trim())
            .Where(
                strValue =>
                    !String.Equals(
                        strValue,
                        strPrimary,
                        StringComparison.OrdinalIgnoreCase))
            .ToList();

        return colParts.Count == 0
            ? String.Empty
            : String.Join(
                ", ",
                colParts);
    }

    private static String GetCompactAddress(
        Job objJob)
    {
        List<String> colParts =
            new[]
            {
                objJob.AddressLine1,
                objJob.Town,
                objJob.Postcode
            }
            .Where(
                strValue =>
                    !String.IsNullOrWhiteSpace(
                        strValue))
            .Select(
                strValue =>
                    strValue!.Trim())
            .ToList();

        return colParts.Count == 0
            ? "No site address"
            : String.Join(
                ", ",
                colParts);
    }

    private static String FormatServiceCount(
        Int32 intCount)
    {
        return intCount switch
        {
            0 =>
                "None",

            1 =>
                "1 service",

            _ =>
                $"{intCount} services"
        };
    }

    private static String GetPlural(
        Int32 intCount)
    {
        return intCount == 1
            ? String.Empty
            : "s";
    }

    private static String GetJobUrl(
        Guid objJobId)
    {
        return $"/jobs/{objJobId}";
    }

    private static String GetCompanyUrl(
        Guid objCompanyId)
    {
        return $"/companies/{objCompanyId}";
    }

    private static String GetJobInitial(
        Job objJob)
    {
        if (String.IsNullOrWhiteSpace(
            objJob.Name))
        {
            return "?";
        }

        return objJob.Name
            .Trim()
            .Substring(0, 1)
            .ToUpperInvariant();
    }

    private static String GetStageBadgeClass(
        JobStage enmStage)
    {
        return enmStage switch
        {
            JobStage.New =>
                "job-stage job-stage-new",

            JobStage.Quoted =>
                "job-stage job-stage-quoted",

            JobStage.ToDo =>
                "job-stage job-stage-todo",

            JobStage.InProgress =>
                "job-stage job-stage-in-progress",

            JobStage.Invoiced =>
                "job-stage job-stage-invoiced",

            JobStage.Paid =>
                "job-stage job-stage-paid",

            JobStage.Lost =>
                "job-stage job-stage-lost",

            _ =>
                "job-stage"
        };
    }

    private static String GetCloseDateClass(
        Job objJob)
    {
        if (!IsOpenJob(objJob) ||
            !objJob.ExpectedCloseDateUtc.HasValue)
        {
            return String.Empty;
        }

        DateTime dteTodayUtc =
            DateTime.UtcNow.Date;

        DateTime dteCloseDateUtc =
            objJob.ExpectedCloseDateUtc.Value.Date;

        if (dteCloseDateUtc <
            dteTodayUtc)
        {
            return "jobs-close-date-overdue";
        }

        if (dteCloseDateUtc <=
            dteTodayUtc.AddDays(30))
        {
            return "jobs-close-date-soon";
        }

        return String.Empty;
    }

    private static String FormatMoney(
        Decimal dcmValue)
    {
        return dcmValue.ToString("C0");
    }

    private static String FormatMoney(
        Decimal? dcmValue)
    {
        return dcmValue.HasValue
            ? dcmValue.Value.ToString("C0")
            : "—";
    }

    private static String FormatDate(
        DateTime? dteDate)
    {
        return dteDate.HasValue
            ? dteDate.Value
                .ToLocalTime()
                .ToString("dd MMM yyyy")
            : "—";
    }

    private static String GetJobRowClass(
        Job objJob)
    {
        if (objJob.Entity.ArchivedUtc.HasValue)
        {
            return "jobs-row-archived";
        }

        if (objJob.Stage ==
            JobStage.Lost)
        {
            return "jobs-row-muted";
        }

        return String.Empty;
    }
}