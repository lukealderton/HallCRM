                                        <a href="@GetCompanyUrl(
                                                                                       objJob.Company.Id)">

                                            @objJob.Company.Name

                                        </a>

                                    </strong>
                                }
                                else
                                {
                                    <strong>
                                        -
                                    </strong>
                                }

                            </div>

                            <div>

                                <span>
                                    Contact
                                </span>

                                @if (objJob.Contact != null)
                                {
                                    <strong>

                                        <a href="@GetContactUrl(
                                                                                       objJob.Contact.Id)">

                                            @objJob.Contact.Entity.DisplayName

                                        </a>

                                    </strong>
                                }
                                else
                                {
                                    <strong>
                                        -
                                    </strong>
                                }

                            </div>

                            <div>

                                <span>
                                    Site
                                </span>

                                <strong>
                                    @GetCompactSiteAddress(
                                        objJob)
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Stage
                                </span>

                                <strong>
                                    @objJob.Stage.GetDisplay().Name
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Services
                                </span>

                                <strong>
                                    @GetServicesSummary(
                                        objJob)
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Source
                                </span>

