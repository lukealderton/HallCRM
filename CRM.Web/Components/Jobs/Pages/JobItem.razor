                </div>

                <div class="crm-card">

                    <div class="job-card-body">

                        <h4 class="job-side-heading">
                            Record details
                        </h4>

                        <div class="job-meta-list">

                            <div>

                                <span>
                                    Created
                                </span>

                                <strong>
                                    @FormatNullableDate(
                                        objJob.Entity.CreatedUtc)
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Updated
                                </span>

                                <strong>
                                    @FormatNullableDate(
                                        objJob.Entity.UpdatedUtc)
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Archived
                                </span>

                                <strong>
                                    @FormatNullableDate(
                                        objJob.Entity.ArchivedUtc)
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>

            </aside>

        </div>
    }

</section>

@code {
    [Parameter]
    public Guid JobId { get; set; }

    private Job? objJob;

    private User? objAssignedUser;

    private List<Invoice> colInvoices =
        [];

    private String strPageTitle =
        "Job";

    private String? strSuccessMessage;

    private String? strErrorMessage;

    private Boolean blnLoading =
        true;

    private Boolean blnSaving;

    private Boolean blnCreatingInvoice;

    private Boolean blnConfirmArchive;

    private Boolean blnConfirmDelete;

    private Boolean CanCreateInvoice =>
        objJob != null &&
        objJob.ServiceLinks.Count > 0 &&
        objJob.ServiceLinks.All(
            objLink =>
                objLink.UnitPrice.HasValue);

    protected override async Task OnParametersSetAsync()
    {
        await LoadJobAsync();
    }

    private RenderFragment GetHeaderActions()
    {
        return @<a href="/jobs"
               class="btn btn-soft-secondary">

            <span class="material-symbols-outlined">
                arrow_back
            </span>

            Back to jobs

        </a>;
    }

    private async Task LoadJobAsync()
    {
        blnLoading =
            true;

        strErrorMessage =
            null;

        strSuccessMessage =
            null;

        blnConfirmArchive =
            false;

        blnConfirmDelete =
            false;

        objAssignedUser =
            null;

        colInvoices =
            [];

        HeaderState.SetHeader(
            "Job",
            "Loading job...",
            GetHeaderActions());

        try
        {
            objJob =
                await JobService.GetJobByIdAsync(
                    JobId);

            if (objJob == null)
            {
                strPageTitle =
                    "Job not found";

                HeaderState.SetHeader(
                    "Job not found",
                    "The selected job could not be loaded",
                    GetHeaderActions());

                return;
            }

            Task<List<Invoice>> objInvoicesTask =
                InvoiceService.GetInvoicesAsync(
                    objJobId: JobId);

            if (objJob.AssignedUserId.HasValue)
            {
                objAssignedUser =
                    await UserService.GetUserAsync(
                        objJob.AssignedUserId.Value);
            }

            colInvoices =
                await objInvoicesTask;

            strPageTitle =
                objJob.Name;

            HeaderState.SetHeader(
                objJob.Name,
                objJob.Company?.Name ??
                    GetCompactSiteAddress(
                        objJob),
                GetHeaderActions());
        }
        catch (Exception objError)
        {
            strErrorMessage =
                "Failed to load job: " +
                objError.Message;

            HeaderState.SetHeader(
                "Job",
                "Unable to load job",
                GetHeaderActions());
        }
        finally
        {
            blnLoading =
                false;
        }
    }

    private async Task CreateInvoiceAsync()
    {
        if (blnCreatingInvoice ||
            !CanCreateInvoice)
        {
            return;
        }

        blnCreatingInvoice =
            true;

        strErrorMessage =
            null;

        strSuccessMessage =
            null;

        try
        {
            Guid? objUserId =
                await CurrentUserState
                    .GetCurrentUserIdAsync();

            Invoice objInvoice =
                await InvoiceService.CreateFromJobAsync(
                    JobId,
                    objUserId);

            Navigation.NavigateTo(
                GetInvoiceUrl(
                    objInvoice.Id));
        }
        catch (Exception objError)
        {
            Exception objCurrentError =
                objError;

            while (objCurrentError.InnerException != null)
            {
                objCurrentError =
                    objCurrentError.InnerException;
            }

            strErrorMessage =
                "Failed to create invoice: " +
                objCurrentError.Message;
        }
        finally
        {
            blnCreatingInvoice =
                false;
        }
    }

    private Decimal GetAmountPaid(
        Invoice objInvoice)
    {
        return objInvoice.Payments
            .Where(
                objPayment =>
                    !objPayment.Entity.DeletedUtc.HasValue)
            .Sum(
                objPayment =>
                    objPayment.Amount);
    }

    private Decimal GetOutstanding(
        Invoice objInvoice)
    {
        if (objInvoice.Status ==
                InvoiceStatus.Draft ||
            objInvoice.Status ==
                InvoiceStatus.Void)
        {
            return 0m;
        }

        return Math.Max(
            0m,
            objInvoice.Total -
            GetAmountPaid(
                objInvoice));
    }

    private Boolean IsActiveInvoice(
        Invoice objInvoice)
    {
        return
            objInvoice.Status !=
                InvoiceStatus.Draft &&
            objInvoice.Status !=
                InvoiceStatus.Void;
    }

    private Boolean IsOutstanding(
        Invoice objInvoice)
    {
        return
            IsActiveInvoice(
                objInvoice) &&
            GetOutstanding(
                objInvoice) > 0m;
    }

    private Boolean IsOverdue(
        Invoice objInvoice)
    {
        return
            IsOutstanding(
                objInvoice) &&
            objInvoice.DueDateUtc.HasValue &&
            objInvoice.DueDateUtc.Value.Date <
                DateTime.UtcNow.Date;
    }

    private Decimal GetInvoicedTotal()
    {
        return colInvoices
            .Where(
                IsActiveInvoice)
            .Sum(
                objInvoice =>
                    objInvoice.Total);
    }

    private Decimal GetPaidTotal()
    {
        return colInvoices
            .Where(
                IsActiveInvoice)
            .Sum(
                GetAmountPaid);
    }

    private Decimal GetOutstandingTotal()
    {
        return colInvoices
            .Where(
                IsOutstanding)
            .Sum(
                GetOutstanding);
    }

    private Decimal GetOverdueTotal()
    {
        return colInvoices
            .Where(
                IsOverdue)
            .Sum(
                GetOutstanding);
    }

    private Int32 GetActiveInvoiceCount()
    {
        return colInvoices.Count(
            IsActiveInvoice);
    }

    private Int32 GetOutstandingInvoiceCount()
    {
        return colInvoices.Count(
            IsOutstanding);
    }

    private Int32 GetOverdueInvoiceCount()
    {
        return colInvoices.Count(
            IsOverdue);
    }

    private String GetOutstandingValueClass()
    {
        return GetOutstandingTotal() > 0m
            ? "job-finance-outstanding"
            : "job-finance-paid";
    }

    private String GetSidebarOutstandingClass()
    {
        return GetOutstandingTotal() > 0m
            ? "job-side-outstanding"
            : "job-side-paid";
    }

    private String GetInvoiceOutstandingClass(
        Invoice objInvoice)
    {
        return IsOverdue(
            objInvoice)
            ? "job-invoice-outstanding job-invoice-overdue"
            : "job-invoice-outstanding";
    }

    private String GetInvoiceDateText(
        Invoice objInvoice)
    {
        if (IsOverdue(
            objInvoice))
        {
            return
                $"Overdue · due {FormatNullableDate(objInvoice.DueDateUtc)}";
        }

        if (objInvoice.DueDateUtc.HasValue &&
            IsOutstanding(
                objInvoice))
        {
            return
                $"Due {FormatNullableDate(objInvoice.DueDateUtc)}";
        }

        if (objInvoice.IssueDateUtc.HasValue)
        {
            return
                $"Issued {FormatNullableDate(objInvoice.IssueDateUtc)}";
        }

        return
            $"Created {FormatNullableDate(objInvoice.Entity.CreatedUtc)}";
    }

    private String GetInvoiceReadinessMessage()
    {
        if (objJob == null)
        {
            return
                "The job could not be loaded.";
        }

        if (objJob.ServiceLinks.Count == 0)
        {
            return
                "Add at least one service to the job before creating an invoice.";
        }

        Int32 intUnpricedCount =
            objJob.ServiceLinks.Count(
                objLink =>
                    !objLink.UnitPrice.HasValue);

        if (intUnpricedCount > 0)
        {
            return intUnpricedCount == 1
                ? "One service still needs a unit price before an invoice can be created."
                : $"{intUnpricedCount} services still need a unit price before an invoice can be created.";
        }

        return
            "The job is ready to invoice.";
    }

    private String GetAssigneeText()
    {
        if (objJob == null ||
            !objJob.AssignedUserId.HasValue)
        {
            return "Unassigned";
        }

        return objAssignedUser?.DisplayName ??
            "Unknown user";
    }

    private void GoToEdit()
    {
        Navigation.NavigateTo(
            $"/jobs/{JobId}/edit");
    }

    private String GetJobSheetUrl()
    {
        return
            $"/jobs/{JobId}/job-sheet.pdf";
    }

    private void ShowArchiveConfirmation()
    {
        blnConfirmArchive =
            true;

        blnConfirmDelete =
            false;

        strSuccessMessage =
            null;

        strErrorMessage =
            null;
    }

    private void ShowDeleteConfirmation()
    {
        blnConfirmDelete =
            true;

        blnConfirmArchive =
            false;

        strSuccessMessage =
            null;

        strErrorMessage =
            null;
    }

    private void CancelActions()
    {
        blnConfirmArchive =
            false;

        blnConfirmDelete =
            false;
    }

    private async Task ArchiveJobAsync()
    {
        await RunJobActionAsync(
            () =>
                JobService.ArchiveJobAsync(
                    JobId),
            "Job archived");
    }

    private async Task RestoreJobAsync()
    {
        await RunJobActionAsync(
            () =>
                JobService.RestoreJobAsync(
                    JobId),
            "Job restored");
    }

    private async Task DeleteJobAsync()
    {
        blnSaving =
            true;

        strErrorMessage =
            null;

        strSuccessMessage =
            null;

        try
        {
            Boolean blnDeleted =
                await JobService.DeleteJobAsync(
                    JobId);

            if (!blnDeleted)
            {
                strErrorMessage =
                    "The job could not be deleted. " +
                    "It may already have been deleted.";

                return;
            }

            Navigation.NavigateTo(
                "/jobs");
        }
        catch (Exception objError)
        {
            strErrorMessage =
                "Failed to delete job: " +
                objError.Message;
        }
        finally
        {
            blnSaving =
                false;

            blnConfirmDelete =
                false;
        }
    }

    private async Task RunJobActionAsync(
        Func<Task<Boolean>> objAction,
        String strSuccessMessageText)
    {
        blnSaving =
            true;

        strErrorMessage =
            null;

        strSuccessMessage =
            null;

        blnConfirmArchive =
            false;

        blnConfirmDelete =
            false;

        try
        {
            Boolean blnSuccess =
                await objAction();

            if (!blnSuccess)
            {
                strErrorMessage =
                    "The job could not be updated. " +
                    "It may have been deleted or no longer exists.";

                return;
            }

            await LoadJobAsync();

            strSuccessMessage =
                strSuccessMessageText;
        }
        catch (Exception objError)
        {
            strErrorMessage =
                "Failed to update job: " +
                objError.Message;
        }
        finally
        {
            blnSaving =
                false;
        }
    }

    private static Boolean HasAddress(
        Job objJob)
    {
        return
            !String.IsNullOrWhiteSpace(
                objJob.AddressLine1) ||
            !String.IsNullOrWhiteSpace(
                objJob.AddressLine2) ||
            !String.IsNullOrWhiteSpace(
                objJob.Town) ||
            !String.IsNullOrWhiteSpace(
                objJob.County) ||
            !String.IsNullOrWhiteSpace(
                objJob.Postcode);
    }

    private static Boolean HasSiteContact(
        Job objJob)
    {
        return
            !String.IsNullOrWhiteSpace(
                objJob.SiteContactName) ||
            !String.IsNullOrWhiteSpace(
                objJob.SiteContactPhone);
    }

    private static Boolean HasSiteDetails(
        Job objJob)
    {
        return
            HasAddress(
                objJob) ||
            HasSiteContact(
                objJob) ||
            !String.IsNullOrWhiteSpace(
                objJob.AccessNotes);
    }

    private static Boolean HasPricedServices(
        Job objJob)
    {
        return objJob.ServiceLinks.Any(
            objLink =>
                objLink.UnitPrice.HasValue);
    }

    private static Decimal GetServicesTotal(
        Job objJob)
    {
        return objJob.ServiceLinks
            .Where(
                objLink =>
                    objLink.UnitPrice.HasValue)
            .Sum(
                objLink =>
                    GetLineTotal(
                        objLink));
    }

    private static Decimal GetLineTotal(
        JobServiceLink objLink)
    {
        Decimal dcmQuantity =
            objLink.Quantity <= 0m
                ? 1m
                : objLink.Quantity;

        return dcmQuantity *
            (objLink.UnitPrice ?? 0m);
    }

    private static String FormatQuantity(
        Decimal dcmQuantity)
    {
        Decimal dcmValue =
            dcmQuantity <= 0m
                ? 1m
                : dcmQuantity;

        return dcmValue.ToString(
            dcmValue % 1m == 0m
                ? "0"
                : "0.##");
    }

    private static String FormatUnitPrice(
        Decimal? dcmPrice)
    {
        return dcmPrice.HasValue
            ? dcmPrice.Value.ToString("C")
            : "Not priced";
    }

    private static String FormatLineTotal(
        JobServiceLink objLink)
    {
        if (!objLink.UnitPrice.HasValue)
        {
            return "Not priced";
        }

        return GetLineTotal(
            objLink)
            .ToString("C");
    }

    private static String FormatSiteAddress(
        Job objJob)
    {
        List<String> colParts =
            new[]
            {
                objJob.AddressLine1,
                objJob.AddressLine2,
                objJob.Town,
                objJob.County,
                objJob.Postcode
            }
            .Where(
                strValue =>
                    !String.IsNullOrWhiteSpace(
                        strValue))
            .Select(
                strValue =>
                    strValue!.Trim())
            .ToList();

        return colParts.Count == 0
            ? "No address added"
            : String.Join(
                ", ",
                colParts);
    }

    private static String GetCompactSiteAddress(
        Job objJob)
    {
        List<String> colParts =
            new[]
            {
                objJob.AddressLine1,
                objJob.Town,
                objJob.Postcode
            }
            .Where(
                strValue =>
                    !String.IsNullOrWhiteSpace(
                        strValue))
            .Select(
                strValue =>
                    strValue!.Trim())
            .ToList();

        return colParts.Count == 0
            ? "-"
            : String.Join(
                ", ",
                colParts);
    }

    private static String GetTelephoneUrl(
        String strTelephone)
    {
        return
            "tel:" +
            strTelephone;
    }

    private static String GetCompanyUrl(
        Guid objCompanyId)
    {
        return
            $"/companies/{objCompanyId}";
    }

    private static String GetContactUrl(
        Guid objContactId)
    {
        return
            $"/contacts/{objContactId}";
    }

    private static String GetInvoiceUrl(
        Guid objInvoiceId)
    {
        return
            $"/invoices/{objInvoiceId}";
    }

    private static String GetJobInitial(
        Job objJob)
    {
        if (String.IsNullOrWhiteSpace(
            objJob.Name))
        {
            return "?";
        }

        return objJob.Name
            .Trim()
            .Substring(
                0,
                1)
            .ToUpperInvariant();
    }

    private static String GetStageBadgeClass(
        JobStage enmStage)
    {
        return enmStage switch
        {
            JobStage.New =>
                "job-stage job-stage-new",

            JobStage.Quoted =>
                "job-stage job-stage-quoted",

            JobStage.ToDo =>
                "job-stage job-stage-todo",

            JobStage.InProgress =>
                "job-stage job-stage-in-progress",

            JobStage.Invoiced =>
                "job-stage job-stage-invoiced",

            JobStage.Paid =>
                "job-stage job-stage-paid",

            JobStage.Lost =>
                "job-stage job-stage-lost",

            _ =>
                "job-stage"
        };
    }

    private static String GetInvoiceStatusStyle(
        InvoiceStatus enmStatus)
    {
        return
            $"--invoice-status-color: {enmStatus.GetUI().ColorHex};";
    }

    private static String GetServicesSummary(
        Job objJob)
    {
        Int32 intCount =
            objJob.ServiceLinks.Count;

        if (intCount == 0)
        {
            return "-";
        }

        if (intCount == 1)
        {
            return objJob.ServiceLinks
                .First()
                .Service.Name;
        }

        return
            $"{intCount} services";
    }

    private static String FormatServiceCount(
        Int32 intCount)
    {
        return intCount == 1
            ? "1 service"
            : $"{intCount} services";
    }

    private static String FormatInvoiceCount(
        Int32 intCount)
    {
        return intCount == 1
            ? "1 invoice"
            : $"{intCount} invoices";
    }

    private static String FormatOutstandingInvoiceCount(
        Int32 intCount)
    {
        return intCount == 1
            ? "1 invoice outstanding"
            : $"{intCount} invoices outstanding";
    }

    private static String FormatOverdueInvoiceCount(
        Int32 intCount)
    {
        return intCount == 1
            ? "1 overdue"
            : $"{intCount} overdue";
    }

    private static String FormatMoney(
        Decimal dcmValue)
    {
        return dcmValue.ToString("C");
    }

    private static String FormatMoney(
        Decimal? dcmValue)
    {
        return dcmValue.HasValue
            ? dcmValue.Value.ToString("C")
            : "-";
    }

    private static String FormatProbability(
        Int32? intProbability)
    {
        return intProbability.HasValue
            ? $"{intProbability.Value}%"
            : "-";
    }

    private static String FormatDate(
        DateTime? dteDate)
    {
        return dteDate.HasValue
            ? dteDate.Value
                .ToLocalTime()
                .ToString("dd MMM yyyy")
            : "-";
    }

    private static String FormatNullableDate(
        DateTime? dteDate)
    {
        return FormatDate(
            dteDate);
    }

    private static String DisplayValue(
        String? strValue)
    {
        return String.IsNullOrWhiteSpace(
            strValue)
            ? "-"
            : strValue;
    }
}