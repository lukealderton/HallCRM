@page "/jobs/{JobId:guid}"

@attribute [Authorize]
@rendermode InteractiveServer

@using CRM.Core.Jobs.Abstractions
@using CRM.Core.Jobs.Domain
@using CRM.Core.Users.Abstraction.Services
@using CRM.Core.Users.Domain
@using CRM.Web.Components.Activities.Shared
@using CRM.Web.State

@inject IJobService JobService
@inject IUserService UserService
@inject NavigationManager Navigation
@inject PageHeaderState HeaderState

<SeoHead Title="@strPageTitle" />

<section class="job-item-page">

    @if (!String.IsNullOrWhiteSpace(
        strSuccessMessage))
    {
        <div class="alert alert-success job-alert"
             role="alert">

            <span class="material-symbols-outlined">
                check_circle
            </span>

            <div class="alert-content">

                <strong class="alert-title">
                    @strSuccessMessage
                </strong>

                <p>
                    The job record has been updated.
                </p>

            </div>

        </div>
    }

    @if (!String.IsNullOrWhiteSpace(
        strErrorMessage))
    {
        <div class="alert alert-danger job-alert"
             role="alert">

            <span class="material-symbols-outlined">
                error
            </span>

            <div class="alert-content">

                <strong class="alert-title">
                    Unable to update job
                </strong>

                <p>
                    @strErrorMessage
                </p>

            </div>

        </div>
    }

    @if (blnConfirmArchive)
    {
        <div class="alert alert-warning job-alert">

            <span class="material-symbols-outlined">
                archive
            </span>

            <div class="alert-content">

                <strong class="alert-title">
                    Archive this job?
                </strong>

                <p>
                    Archived jobs are hidden from normal pipeline views
                    but can be restored later.
                </p>

            </div>

            <div class="alert-actions">

                <button class="btn btn-soft-danger btn-sm"
                        type="button"
                        @onclick="ArchiveJobAsync"
                        disabled="@blnSaving">
                    Archive job
                </button>

                <button class="btn btn-soft-secondary btn-sm"
                        type="button"
                        @onclick="CancelActions">
                    Cancel
                </button>

            </div>

        </div>
    }

    @if (blnConfirmDelete)
    {
        <div class="alert alert-danger job-alert">

            <span class="material-symbols-outlined">
                delete
            </span>

            <div class="alert-content">

                <strong class="alert-title">
                    Delete this job?
                </strong>

                <p>
                    This will mark the job as deleted.
                    It will no longer appear in normal job lists.
                </p>

            </div>

            <div class="alert-actions">

                <button class="btn btn-soft-danger btn-sm"
                        type="button"
                        @onclick="DeleteJobAsync"
                        disabled="@blnSaving">
                    Delete job
                </button>

                <button class="btn btn-soft-secondary btn-sm"
                        type="button"
                        @onclick="CancelActions">
                    Cancel
                </button>

            </div>

        </div>
    }

    @if (blnLoading)
    {
        <div class="crm-card">

            <div class="crm-loading">

                <span class="spinner-border spinner-border-sm"></span>

                Loading job...

            </div>

        </div>
    }
    else if (objJob == null)
    {
        <div class="alert alert-danger job-alert"
             role="alert">

            <span class="material-symbols-outlined">
                search_off
            </span>

            <div class="alert-content">

                <strong class="alert-title">
                    Job not found
                </strong>

                <p>
                    This job may have been deleted or moved.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="job-profile-card crm-card">

            <div class="job-profile-main">

                <div class="job-avatar">
                    @GetJobInitial(objJob)
                </div>

                <div>

                    <div class="job-title-row">

                        <h2>
                            @objJob.Name
                        </h2>

                        <span class="@GetStageBadgeClass(
                                                        objJob.Stage)">
                            @objJob.Stage.GetDisplay().Name
                        </span>

                        @if (objJob.Entity.ArchivedUtc.HasValue)
                        {
                            <span class="badge text-bg-secondary">
                                Archived
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">
                                Active
                            </span>
                        }

                    </div>

                    <p class="job-subtitle">
                        @(objJob.Company?.Name ??
                          "No company linked")
                    </p>

                    <div class="job-meta-row">

                        <span>

                            <span class="material-symbols-outlined">
                                assignment_ind
                            </span>

                            @GetAssigneeText()

                        </span>

                        @if (HasAddress(objJob))
                        {
                            <span>

                                <span class="material-symbols-outlined">
                                    location_on
                                </span>

                                @GetCompactSiteAddress(
                                    objJob)

                            </span>
                        }

                        <span>

                            <span class="material-symbols-outlined">
                                payments
                            </span>

                            @FormatMoney(
                                objJob.Value)

                        </span>

                        <span>

                            <span class="material-symbols-outlined">
                                percent
                            </span>

                            @FormatProbability(
                                objJob.ProbabilityPercent)

                        </span>

                        @if (objJob.ServiceLinks.Count > 0)
                        {
                            <span>

                                <span class="material-symbols-outlined">
                                    home_repair_service
                                </span>

                                @FormatServiceCount(
                                    objJob.ServiceLinks.Count)

                            </span>
                        }

                    </div>

                </div>

            </div>

            <div class="job-profile-actions">

                <a href="@GetJobSheetUrl()"
                   class="btn btn-soft-primary"
                   target="_blank">

                    <span class="material-symbols-outlined">
                        print
                    </span>

                    Job sheet

                </a>

                <button type="button"
                        class="btn btn-primary"
                        @onclick="GoToEdit">

                    <span class="material-symbols-outlined">
                        edit
                    </span>

                    Edit job

                </button>

                @if (objJob.Entity.ArchivedUtc.HasValue)
                {
                    <button type="button"
                            class="btn btn-soft-primary"
                            disabled="@blnSaving"
                            @onclick="RestoreJobAsync">

                        <span class="material-symbols-outlined">
                            unarchive
                        </span>

                        Restore

                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-soft-secondary"
                            disabled="@blnSaving"
                            @onclick="ShowArchiveConfirmation">

                        <span class="material-symbols-outlined">
                            archive
                        </span>

                        Archive

                    </button>
                }

                <button type="button"
                        class="btn btn-soft-danger"
                        disabled="@blnSaving"
                        @onclick="ShowDeleteConfirmation">

                    <span class="material-symbols-outlined">
                        delete
                    </span>

                    Delete

                </button>

            </div>

        </div>

        <div class="job-layout">

            <div class="job-main-column">

                <div class="crm-card">

                    <div class="crm-card-header">

                        <div>

                            <h3>
                                Job details
                            </h3>

                            <p>
                                Value, probability, source and expected close date.
                            </p>

                        </div>

                    </div>

                    <div class="job-card-body">

                        <div class="job-details-grid">

                            <div class="job-detail-item">

                                <span class="material-symbols-outlined">
                                    payments
                                </span>

                                <div>

                                    <small>
                                        Value
                                    </small>

                                    <strong>
                                        @FormatMoney(
                                            objJob.Value)
                                    </strong>

                                </div>

                            </div>

                            <div class="job-detail-item">

                                <span class="material-symbols-outlined">
                                    percent
                                </span>

                                <div>

                                    <small>
                                        Probability
                                    </small>

                                    <strong>
                                        @FormatProbability(
                                            objJob.ProbabilityPercent)
                                    </strong>

                                </div>

                            </div>

                            <div class="job-detail-item">

                                <span class="material-symbols-outlined">
                                    event
                                </span>

                                <div>

                                    <small>
                                        Expected close
                                    </small>

                                    <strong>
                                        @FormatDate(
                                            objJob.ExpectedCloseDateUtc)
                                    </strong>

                                </div>

                            </div>

                            <div class="job-detail-item">

                                <span class="material-symbols-outlined">
                                    campaign
                                </span>

                                <div>

                                    <small>
                                        Source
                                    </small>

                                    <strong>
                                        @DisplayValue(
                                            objJob.Source)
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="crm-card">

                    <div class="crm-card-header">

                        <div>

                            <h3>
                                Site
                            </h3>

                            <p>
                                Location and access information for this job.
                            </p>

                        </div>

                        <button type="button"
                                class="btn btn-soft-secondary btn-sm"
                                @onclick="GoToEdit">

                            <span class="material-symbols-outlined">
                                edit
                            </span>

                            Edit

                        </button>

                    </div>

                    <div class="job-card-body">

                        @if (!HasSiteDetails(
                            objJob))
                        {
                            <div class="job-muted-panel">

                                <span class="material-symbols-outlined">
                                    location_off
                                </span>

                                <span>
                                    No site information has been added yet.
                                </span>

                            </div>
                        }
                        else
                        {
                            <div class="job-site-layout">

                                <div class="job-site-address">

                                    <div class="job-site-icon">

                                        <span class="material-symbols-outlined">
                                            location_on
                                        </span>

                                    </div>

                                    <div>

                                        <small>
                                            Work address
                                        </small>

                                        <strong>
                                            @FormatSiteAddress(
                                                objJob)
                                        </strong>

                                    </div>

                                </div>

                                @if (HasSiteContact(
                                    objJob))
                                {
                                    <div class="job-site-detail">

                                        <span class="material-symbols-outlined">
                                            person_pin_circle
                                        </span>

                                        <div>

                                            <small>
                                                Site contact
                                            </small>

                                            <strong>
                                                @DisplayValue(
                                                    objJob.SiteContactName)
                                            </strong>

                                            @if (!String.IsNullOrWhiteSpace(
                                                objJob.SiteContactPhone))
                                            {
                                                <a href="@GetTelephoneUrl(
                                                                                                       objJob.SiteContactPhone)">

                                                    @objJob.SiteContactPhone

                                                </a>
                                            }

                                        </div>

                                    </div>
                                }

                            </div>

                            @if (!String.IsNullOrWhiteSpace(
                                objJob.AccessNotes))
                            {
                                <div class="job-access-panel">

                                    <span class="material-symbols-outlined">
                                        key
                                    </span>

                                    <div>

                                        <small>
                                            Access notes
                                        </small>

                                        <p>
                                            @objJob.AccessNotes
                                        </p>

                                    </div>

                                </div>
                            }
                        }

                    </div>

                </div>

                <div class="crm-card">

                    <div class="crm-card-header">

                        <div>

                            <h3>
                                Services
                            </h3>

                            <p>
                                Work and agreed pricing included in this job.
                            </p>

                        </div>

                        <button type="button"
                                class="btn btn-soft-secondary btn-sm"
                                @onclick="GoToEdit">

                            <span class="material-symbols-outlined">
                                edit
                            </span>

                            Manage

                        </button>

                    </div>

                    <div class="job-card-body">

                        @if (objJob.ServiceLinks.Count == 0)
                        {
                            <div class="job-services-empty">

                                <span class="material-symbols-outlined">
                                    home_repair_service
                                </span>

                                <div>

                                    <strong>
                                        No services linked
                                    </strong>

                                    <span>
                                        Add services to record the work included in this job.
                                    </span>

                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="job-services-list">

                                @foreach (JobServiceLink objLink
                                    in objJob.ServiceLinks
                                        .OrderBy(objLink =>
                                            objLink.Service.Name))
                                {
                                    <div class="job-service-card">

                                        <div class="job-service-icon">

                                            <span class="material-symbols-outlined">
                                                home_repair_service
                                            </span>

                                        </div>

                                        <div class="job-service-content">

                                            <strong>
                                                @objLink.Service.Name
                                            </strong>

                                            @if (!String.IsNullOrWhiteSpace(
                                                objLink.Service.Description))
                                            {
                                                <span>
                                                    @objLink.Service.Description
                                                </span>
                                            }

                                            <div class="job-service-line-meta">

                                                <span>
                                                    Qty
                                                    <strong>
                                                        @FormatQuantity(
                                                            objLink.Quantity)
                                                    </strong>
                                                </span>

                                                <span>
                                                    Unit
                                                    <strong>
                                                        @FormatUnitPrice(
                                                            objLink.UnitPrice)
                                                    </strong>
                                                </span>

                                            </div>

                                        </div>

                                        <div class="job-service-price">

                                            <small>
                                                Total
                                            </small>

                                            <strong>
                                                @FormatLineTotal(
                                                    objLink)
                                            </strong>

                                        </div>

                                    </div>
                                }

                            </div>

                            @if (HasPricedServices(
                                objJob))
                            {
                                <div class="job-services-total">

                                    <span>
                                        Services total
                                    </span>

                                    <strong>
                                        @FormatMoney(
                                            GetServicesTotal(
                                                objJob))
                                    </strong>

                                </div>
                            }
                        }

                    </div>

                </div>

                <div class="crm-card">

                    <div class="crm-card-header">

                        <div>

                            <h3>
                                Description
                            </h3>

                            <p>
                                Summary and context for this job.
                            </p>

                        </div>

                    </div>

                    <div class="job-card-body">

                        @if (!String.IsNullOrWhiteSpace(
                            objJob.Description))
                        {
                            <p class="job-description">
                                @objJob.Description
                            </p>
                        }
                        else
                        {
                            <div class="job-muted-panel">

                                <span class="material-symbols-outlined">
                                    notes
                                </span>

                                <span>
                                    No description has been added yet.
                                </span>

                            </div>
                        }

                    </div>

                </div>

                <EntityActivities JobId="@JobId"
                                  Title="Activities"
                                  Subtitle="Tasks, visits and follow-ups for this job."
                                  EmptyText="No open activities for this job." />

                <EntityNotes EntityId="@JobId"
                             Title="Notes"
                             Subtitle="Internal notes for this job."
                             EmptyText="No notes have been added for this job yet." />

            </div>

            <aside class="job-side-column">

                <div class="crm-card">

                    <div class="job-card-body">

                        <h4 class="job-side-heading">
                            Quick actions
                        </h4>

                        <div class="job-action-list">

                            <a href="@($"/activities/add?jobId={JobId}")"
                               class="btn btn-soft-primary w-100">

                                <span class="material-symbols-outlined">
                                    add_task
                                </span>

                                Add activity

                            </a>

                            <a href="@GetJobSheetUrl()"
                               target="_blank"
                               class="btn btn-soft-secondary w-100">

                                <span class="material-symbols-outlined">
                                    print
                                </span>

                                Open job sheet

                            </a>

                            @if (!String.IsNullOrWhiteSpace(
                                objJob.SiteContactPhone))
                            {
                                <a href="@GetTelephoneUrl(
                                                                       objJob.SiteContactPhone)"
                                   class="btn btn-soft-secondary w-100">

                                    <span class="material-symbols-outlined">
                                        call
                                    </span>

                                    Call site contact

                                </a>
                            }

                            @if (objJob.Company != null)
                            {
                                <a href="@GetCompanyUrl(
                                                                       objJob.Company.Id)"
                                   class="btn btn-soft-secondary w-100">

                                    <span class="material-symbols-outlined">
                                        business
                                    </span>

                                    Open company

                                </a>
                            }

                            @if (objJob.Contact != null)
                            {
                                <a href="@GetContactUrl(
                                                                       objJob.Contact.Id)"
                                   class="btn btn-soft-secondary w-100">

                                    <span class="material-symbols-outlined">
                                        person
                                    </span>

                                    Open contact

                                </a>
                            }

                            <button type="button"
                                    class="btn btn-soft-secondary w-100"
                                    @onclick="GoToEdit">

                                <span class="material-symbols-outlined">
                                    edit
                                </span>

                                Edit details

                            </button>

                        </div>

                    </div>

                </div>

                <div class="crm-card">

                    <div class="job-card-body">

                        <h4 class="job-side-heading">
                            Overview
                        </h4>

                        <div class="job-meta-list">

                            <div>

                                <span>
                                    Assigned to
                                </span>

                                <strong>
                                    @GetAssigneeText()
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Company
                                </span>

                                @if (objJob.Company != null)
                                {
                                    <strong>

                                        <a href="@GetCompanyUrl(
                                                                                       objJob.Company.Id)">
                                            @objJob.Company.Name
                                        </a>

                                    </strong>
                                }
                                else
                                {
                                    <strong>
                                        -
                                    </strong>
                                }

                            </div>

                            <div>

                                <span>
                                    Contact
                                </span>

                                @if (objJob.Contact != null)
                                {
                                    <strong>

                                        <a href="@GetContactUrl(
                                                                                       objJob.Contact.Id)">
                                            @objJob.Contact.Entity.DisplayName
                                        </a>

                                    </strong>
                                }
                                else
                                {
                                    <strong>
                                        -
                                    </strong>
                                }

                            </div>

                            <div>

                                <span>
                                    Site
                                </span>

                                <strong>
                                    @GetCompactSiteAddress(
                                        objJob)
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Stage
                                </span>

                                <strong>
                                    @objJob.Stage.GetDisplay().Name
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Services
                                </span>

                                <strong>
                                    @GetServicesSummary(
                                        objJob)
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Value
                                </span>

                                <strong>
                                    @FormatMoney(
                                        objJob.Value)
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Source
                                </span>

                                <strong>
                                    @DisplayValue(
                                        objJob.Source)
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="crm-card">

                    <div class="job-card-body">

                        <h4 class="job-side-heading">
                            Record details
                        </h4>

                        <div class="job-meta-list">

                            <div>

                                <span>
                                    Created
                                </span>

                                <strong>
                                    @FormatNullableDate(
                                        objJob.Entity.CreatedUtc)
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Updated
                                </span>

                                <strong>
                                    @FormatNullableDate(
                                        objJob.Entity.UpdatedUtc)
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Archived
                                </span>

                                <strong>
                                    @FormatNullableDate(
                                        objJob.Entity.ArchivedUtc)
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>

            </aside>

        </div>
    }

</section>

@code {
    [Parameter]
    public Guid JobId { get; set; }

    private Job? objJob;

    private User? objAssignedUser;

    private String strPageTitle =
        "Job";

    private String? strSuccessMessage;

    private String? strErrorMessage;

    private Boolean blnLoading =
        true;

    private Boolean blnSaving;

    private Boolean blnConfirmArchive;

    private Boolean blnConfirmDelete;

    protected override async Task OnParametersSetAsync()
    {
        await LoadJobAsync();
    }

    private RenderFragment GetHeaderActions()
    {
        return @<a href="/jobs"
               class="btn btn-soft-secondary">

            <span class="material-symbols-outlined">
                arrow_back
            </span>

            Back to jobs

        </a>;
    }

    private async Task LoadJobAsync()
    {
        blnLoading =
            true;

        strErrorMessage =
            null;

        strSuccessMessage =
            null;

        blnConfirmArchive =
            false;

        blnConfirmDelete =
            false;

        objAssignedUser =
            null;

        HeaderState.SetHeader(
            "Job",
            "Loading job...",
            GetHeaderActions());

        try
        {
            objJob =
                await JobService.GetJobByIdAsync(
                    JobId);

            if (objJob == null)
            {
                strPageTitle =
                    "Job not found";

                HeaderState.SetHeader(
                    "Job not found",
                    "The selected job could not be loaded",
                    GetHeaderActions());

                return;
            }

            if (objJob.AssignedUserId.HasValue)
            {
                objAssignedUser =
                    await UserService.GetUserAsync(
                        objJob.AssignedUserId.Value);
            }

            strPageTitle =
                objJob.Name;

            HeaderState.SetHeader(
                objJob.Name,
                objJob.Company?.Name ??
                    GetCompactSiteAddress(
                        objJob),
                GetHeaderActions());
        }
        catch (Exception objError)
        {
            strErrorMessage =
                "Failed to load job: " +
                objError.Message;

            HeaderState.SetHeader(
                "Job",
                "Unable to load job",
                GetHeaderActions());
        }
        finally
        {
            blnLoading =
                false;
        }
    }

    private String GetAssigneeText()
    {
        if (objJob == null ||
            !objJob.AssignedUserId.HasValue)
        {
            return "Unassigned";
        }

        return objAssignedUser?.DisplayName ??
            "Unknown user";
    }

    private void GoToEdit()
    {
        Navigation.NavigateTo(
            $"/jobs/{JobId}/edit");
    }

    private String GetJobSheetUrl()
    {
        return
            $"/jobs/{JobId}/job-sheet.pdf";
    }

    private void ShowArchiveConfirmation()
    {
        blnConfirmArchive =
            true;

        blnConfirmDelete =
            false;

        strSuccessMessage =
            null;

        strErrorMessage =
            null;
    }

    private void ShowDeleteConfirmation()
    {
        blnConfirmDelete =
            true;

        blnConfirmArchive =
            false;

        strSuccessMessage =
            null;

        strErrorMessage =
            null;
    }

    private void CancelActions()
    {
        blnConfirmArchive =
            false;

        blnConfirmDelete =
            false;
    }

    private async Task ArchiveJobAsync()
    {
        await RunJobActionAsync(
            () =>
                JobService.ArchiveJobAsync(
                    JobId),
            "Job archived");
    }

    private async Task RestoreJobAsync()
    {
        await RunJobActionAsync(
            () =>
                JobService.RestoreJobAsync(
                    JobId),
            "Job restored");
    }

    private async Task DeleteJobAsync()
    {
        blnSaving =
            true;

        strErrorMessage =
            null;

        strSuccessMessage =
            null;

        try
        {
            Boolean blnDeleted =
                await JobService.DeleteJobAsync(
                    JobId);

            if (!blnDeleted)
            {
                strErrorMessage =
                    "The job could not be deleted. " +
                    "It may already have been deleted.";

                return;
            }

            Navigation.NavigateTo(
                "/jobs");
        }
        catch (Exception objError)
        {
            strErrorMessage =
                "Failed to delete job: " +
                objError.Message;
        }
        finally
        {
            blnSaving =
                false;

            blnConfirmDelete =
                false;
        }
    }

    private async Task RunJobActionAsync(
        Func<Task<Boolean>> objAction,
        String strSuccessMessageText)
    {
        blnSaving =
            true;

        strErrorMessage =
            null;

        strSuccessMessage =
            null;

        blnConfirmArchive =
            false;

        blnConfirmDelete =
            false;

        try
        {
            Boolean blnSuccess =
                await objAction();

            if (!blnSuccess)
            {
                strErrorMessage =
                    "The job could not be updated. " +
                    "It may have been deleted or no longer exists.";

                return;
            }

            await LoadJobAsync();

            strSuccessMessage =
                strSuccessMessageText;
        }
        catch (Exception objError)
        {
            strErrorMessage =
                "Failed to update job: " +
                objError.Message;
        }
        finally
        {
            blnSaving =
                false;
        }
    }

    private static Boolean HasAddress(
        Job objJob)
    {
        return
            !String.IsNullOrWhiteSpace(
                objJob.AddressLine1) ||
            !String.IsNullOrWhiteSpace(
                objJob.AddressLine2) ||
            !String.IsNullOrWhiteSpace(
                objJob.Town) ||
            !String.IsNullOrWhiteSpace(
                objJob.County) ||
            !String.IsNullOrWhiteSpace(
                objJob.Postcode);
    }

    private static Boolean HasSiteContact(
        Job objJob)
    {
        return
            !String.IsNullOrWhiteSpace(
                objJob.SiteContactName) ||
            !String.IsNullOrWhiteSpace(
                objJob.SiteContactPhone);
    }

    private static Boolean HasSiteDetails(
        Job objJob)
    {
        return
            HasAddress(
                objJob) ||
            HasSiteContact(
                objJob) ||
            !String.IsNullOrWhiteSpace(
                objJob.AccessNotes);
    }

    private static Boolean HasPricedServices(
        Job objJob)
    {
        return objJob.ServiceLinks.Any(
            objLink =>
                objLink.UnitPrice.HasValue);
    }

    private static Decimal GetServicesTotal(
        Job objJob)
    {
        return objJob.ServiceLinks
            .Where(objLink =>
                objLink.UnitPrice.HasValue)
            .Sum(objLink =>
                GetLineTotal(
                    objLink));
    }

    private static Decimal GetLineTotal(
        JobServiceLink objLink)
    {
        Decimal dcmQuantity =
            objLink.Quantity <= 0m
                ? 1m
                : objLink.Quantity;

        return dcmQuantity *
            (objLink.UnitPrice ?? 0m);
    }

    private static String FormatQuantity(
        Decimal dcmQuantity)
    {
        Decimal dcmValue =
            dcmQuantity <= 0m
                ? 1m
                : dcmQuantity;

        return dcmValue.ToString(
            dcmValue % 1m == 0m
                ? "0"
                : "0.##");
    }

    private static String FormatUnitPrice(
        Decimal? dcmPrice)
    {
        return dcmPrice.HasValue
            ? dcmPrice.Value.ToString("C")
            : "Not priced";
    }

    private static String FormatLineTotal(
        JobServiceLink objLink)
    {
        if (!objLink.UnitPrice.HasValue)
        {
            return "Not priced";
        }

        return GetLineTotal(
            objLink)
            .ToString("C");
    }

    private static String FormatSiteAddress(
        Job objJob)
    {
        List<String> colParts =
            new[]
            {
                objJob.AddressLine1,
                objJob.AddressLine2,
                objJob.Town,
                objJob.County,
                objJob.Postcode
            }
            .Where(strValue =>
                !String.IsNullOrWhiteSpace(
                    strValue))
            .Select(strValue =>
                strValue!.Trim())
            .ToList();

        return colParts.Count == 0
            ? "No address added"
            : String.Join(
                ", ",
                colParts);
    }

    private static String GetCompactSiteAddress(
        Job objJob)
    {
        List<String> colParts =
            new[]
            {
                objJob.AddressLine1,
                objJob.Town,
                objJob.Postcode
            }
            .Where(strValue =>
                !String.IsNullOrWhiteSpace(
                    strValue))
            .Select(strValue =>
                strValue!.Trim())
            .ToList();

        return colParts.Count == 0
            ? "-"
            : String.Join(
                ", ",
                colParts);
    }

    private static String GetTelephoneUrl(
        String strTelephone)
    {
        return
            "tel:" +
            strTelephone;
    }

    private static String GetCompanyUrl(
        Guid objCompanyId)
    {
        return
            $"/companies/{objCompanyId}";
    }

    private static String GetContactUrl(
        Guid objContactId)
    {
        return
            $"/contacts/{objContactId}";
    }

    private static String GetJobInitial(
        Job objJob)
    {
        if (String.IsNullOrWhiteSpace(
            objJob.Name))
        {
            return "?";
        }

        return objJob.Name
            .Trim()
            .Substring(0, 1)
            .ToUpperInvariant();
    }

    private static String GetStageBadgeClass(
        JobStage enmStage)
    {
        return enmStage switch
        {
            JobStage.New =>
                "job-stage job-stage-new",

            JobStage.Quoted =>
                "job-stage job-stage-quoted",

            JobStage.ToDo =>
                "job-stage job-stage-todo",

            JobStage.InProgress =>
                "job-stage job-stage-in-progress",

            JobStage.Invoiced =>
                "job-stage job-stage-invoiced",

            JobStage.Paid =>
                "job-stage job-stage-paid",

            JobStage.Lost =>
                "job-stage job-stage-lost",

            _ =>
                "job-stage"
        };
    }

    private static String GetServicesSummary(
        Job objJob)
    {
        Int32 intCount =
            objJob.ServiceLinks.Count;

        if (intCount == 0)
        {
            return "-";
        }

        if (intCount == 1)
        {
            return objJob.ServiceLinks
                .First()
                .Service.Name;
        }

        return
            $"{intCount} services";
    }

    private static String FormatServiceCount(
        Int32 intCount)
    {
        return intCount == 1
            ? "1 service"
            : $"{intCount} services";
    }

    private static String FormatMoney(
        Decimal dcmValue)
    {
        return dcmValue.ToString("C");
    }

    private static String FormatMoney(
        Decimal? dcmValue)
    {
        return dcmValue.HasValue
            ? dcmValue.Value.ToString("C")
            : "-";
    }

    private static String FormatProbability(
        Int32? intProbability)
    {
        return intProbability.HasValue
            ? $"{intProbability.Value}%"
            : "-";
    }

    private static String FormatDate(
        DateTime? dteDate)
    {
        return dteDate.HasValue
            ? dteDate.Value
                .ToLocalTime()
                .ToString("dd MMM yyyy")
            : "-";
    }

    private static String FormatNullableDate(
        DateTime? dteDate)
    {
        return FormatDate(
            dteDate);
    }

    private static String DisplayValue(
        String? strValue)
    {
        return String.IsNullOrWhiteSpace(
            strValue)
            ? "-"
            : strValue;
    }
}