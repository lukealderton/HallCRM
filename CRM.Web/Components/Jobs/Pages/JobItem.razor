@page "/jobs/{JobId:guid}"

@attribute [Authorize]
@rendermode InteractiveServer

@using CRM.Core.Invoices.Abstractions
@using CRM.Core.Invoices.Domain
@using CRM.Core.Jobs.Abstractions
@using CRM.Core.Jobs.Domain
@using CRM.Core.Users.Abstraction.Services
@using CRM.Core.Users.Domain
@using CRM.Web.Components.Activities.Shared
@using CRM.Web.State
@using CRM.Web.Users.Abstraction

@inject IJobService JobService
@inject IInvoiceService InvoiceService
@inject IUserService UserService
@inject ICurrentUserState CurrentUserState
@inject NavigationManager Navigation
@inject PageHeaderState HeaderState

<SeoHead Title="@strPageTitle" />

<section class="job-item-page">

    @if (!String.IsNullOrWhiteSpace(
        strSuccessMessage))
    {
        <div class="alert alert-success job-alert"
             role="alert">

            <span class="material-symbols-outlined">
                check_circle
            </span>

            <div class="alert-content">

                <strong class="alert-title">
                    @strSuccessMessage
                </strong>

                <p>
                    The job record has been updated.
                </p>

            </div>

        </div>
    }

    @if (!String.IsNullOrWhiteSpace(
        strErrorMessage))
    {
        <div class="alert alert-danger job-alert"
             role="alert">

            <span class="material-symbols-outlined">
                error
            </span>

            <div class="alert-content">

                <strong class="alert-title">
                    Unable to update job
                </strong>

                <p>
                    @strErrorMessage
                </p>

            </div>

        </div>
    }

    @if (blnConfirmArchive)
    {
        <div class="alert alert-warning job-alert">

            <span class="material-symbols-outlined">
                archive
            </span>

            <div class="alert-content">

                <strong class="alert-title">
                    Archive this job?
                </strong>

                <p>
                    Archived jobs are hidden from normal pipeline views
                    but can be restored later.
                </p>

            </div>

            <div class="alert-actions">

                <button class="btn btn-soft-danger btn-sm"
                        type="button"
                        @onclick="ArchiveJobAsync"
                        disabled="@blnSaving">

                    Archive job

                </button>

                <button class="btn btn-soft-secondary btn-sm"
                        type="button"
                        @onclick="CancelActions">

                    Cancel

                </button>

            </div>

        </div>
    }

    @if (blnConfirmDelete)
    {
        <div class="alert alert-danger job-alert">

            <span class="material-symbols-outlined">
                delete
            </span>

            <div class="alert-content">

                <strong class="alert-title">
                    Delete this job?
                </strong>

                <p>
                    This will mark the job as deleted.
                    It will no longer appear in normal job lists.
                </p>

            </div>

            <div class="alert-actions">

                <button class="btn btn-soft-danger btn-sm"
                        type="button"
                        @onclick="DeleteJobAsync"
                        disabled="@blnSaving">

                    Delete job

                </button>

                <button class="btn btn-soft-secondary btn-sm"
                        type="button"
                        @onclick="CancelActions">

                    Cancel

                </button>

            </div>

        </div>
    }

    @if (blnLoading)
    {
        <div class="crm-card">

            <div class="crm-loading">

                <span class="spinner-border spinner-border-sm"></span>

                Loading job...

            </div>

        </div>
    }
    else if (objJob == null)
    {
        <div class="alert alert-danger job-alert"
             role="alert">

            <span class="material-symbols-outlined">
                search_off
            </span>

            <div class="alert-content">

                <strong class="alert-title">
                    Job not found
                </strong>

                <p>
                    This job may have been deleted or moved.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="job-profile-card crm-card">

            <div class="job-profile-main">

                <div class="job-avatar">
                    @GetJobInitial(objJob)
                </div>

                <div>

                    <div class="job-title-row">

                        <h2>
                            @objJob.Name
                        </h2>

                        <span class="@GetStageBadgeClass(
                                                        objJob.Stage)">

                            @objJob.Stage.GetDisplay().Name

                        </span>

                        @if (objJob.Entity.ArchivedUtc.HasValue)
                        {
                            <span class="badge text-bg-secondary">
                                Archived
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">
                                Active
                            </span>
                        }

                    </div>

                    <p class="job-subtitle">
                        @(objJob.Company?.Name ??
                          "No company linked")
                    </p>

                    <div class="job-meta-row">

                        <span>

                            <span class="material-symbols-outlined">
                                assignment_ind
                            </span>

                            @GetAssigneeText()

                        </span>

                        @if (HasAddress(
                            objJob))
                        {
                            <span>

                                <span class="material-symbols-outlined">
                                    location_on
                                </span>

                                @GetCompactSiteAddress(
                                    objJob)

                            </span>
                        }

                        <span>

                            <span class="material-symbols-outlined">
                                payments
                            </span>

                            @FormatMoney(
                                objJob.Value)

                        </span>

                        <span>

                            <span class="material-symbols-outlined">
                                percent
                            </span>

                            @FormatProbability(
                                objJob.ProbabilityPercent)

                        </span>

                        @if (objJob.ServiceLinks.Count > 0)
                        {
                            <span>

                                <span class="material-symbols-outlined">
                                    home_repair_service
                                </span>

                                @FormatServiceCount(
                                    objJob.ServiceLinks.Count)

                            </span>
                        }

                        @if (colInvoices.Count > 0)
                        {
                            <span>

                                <span class="material-symbols-outlined">
                                    receipt_long
                                </span>

                                @FormatInvoiceCount(
                                    colInvoices.Count)

                            </span>
                        }

                    </div>

                </div>

            </div>

            <div class="job-profile-actions">

                <a href="@GetJobSheetUrl()"
                   class="btn btn-soft-primary"
                   target="_blank">

                    <span class="material-symbols-outlined">
                        print
                    </span>

                    Job sheet

                </a>

                <button type="button"
                        class="btn btn-primary"
                        @onclick="GoToEdit">

                    <span class="material-symbols-outlined">
                        edit
                    </span>

                    Edit job

                </button>

                @if (objJob.Entity.ArchivedUtc.HasValue)
                {
                    <button type="button"
                            class="btn btn-soft-primary"
                            disabled="@blnSaving"
                            @onclick="RestoreJobAsync">

                        <span class="material-symbols-outlined">
                            unarchive
                        </span>

                        Restore

                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-soft-secondary"
                            disabled="@blnSaving"
                            @onclick="ShowArchiveConfirmation">

                        <span class="material-symbols-outlined">
                            archive
                        </span>

                        Archive

                    </button>
                }

                <button type="button"
                        class="btn btn-soft-danger"
                        disabled="@blnSaving"
                        @onclick="ShowDeleteConfirmation">

                    <span class="material-symbols-outlined">
                        delete
                    </span>

                    Delete

                </button>

            </div>

        </div>

        <div class="job-layout">

            <div class="job-main-column">

                <div class="crm-card">

                    <div class="crm-card-header">

                        <div>

                            <h3>
                                Job details
                            </h3>

                            <p>
                                Value, probability, source and expected close date.
                            </p>

                        </div>

                    </div>

                    <div class="job-card-body">

                        <div class="job-details-grid">

                            <div class="job-detail-item">

                                <span class="material-symbols-outlined">
                                    payments
                                </span>

                                <div>

                                    <small>
                                        Value
                                    </small>

                                    <strong>
                                        @FormatMoney(
                                            objJob.Value)
                                    </strong>

                                </div>

                            </div>

                            <div class="job-detail-item">

                                <span class="material-symbols-outlined">
                                    percent
                                </span>

                                <div>

                                    <small>
                                        Probability
                                    </small>

                                    <strong>
                                        @FormatProbability(
                                            objJob.ProbabilityPercent)
                                    </strong>

                                </div>

                            </div>

                            <div class="job-detail-item">

                                <span class="material-symbols-outlined">
                                    event
                                </span>

                                <div>

                                    <small>
                                        Expected close
                                    </small>

                                    <strong>
                                        @FormatDate(
                                            objJob.ExpectedCloseDateUtc)
                                    </strong>

                                </div>

                            </div>

                            <div class="job-detail-item">

                                <span class="material-symbols-outlined">
                                    campaign
                                </span>

                                <div>

                                    <small>
                                        Source
                                    </small>

                                    <strong>
                                        @DisplayValue(
                                            objJob.Source)
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="crm-card">

                    <div class="crm-card-header">

                        <div>

                            <h3>
                                Site
                            </h3>

                            <p>
                                Location and access information for this job.
                            </p>

                        </div>

                        <button type="button"
                                class="btn btn-soft-secondary btn-sm"
                                @onclick="GoToEdit">

                            <span class="material-symbols-outlined">
                                edit
                            </span>

                            Edit

                        </button>

                    </div>

                    <div class="job-card-body">

                        @if (!HasSiteDetails(
                            objJob))
                        {
                            <div class="job-muted-panel">

                                <span class="material-symbols-outlined">
                                    location_off
                                </span>

                                <span>
                                    No site information has been added yet.
                                </span>

                            </div>
                        }
                        else
                        {
                            <div class="job-site-layout">

                                <div class="job-site-address">

                                    <div class="job-site-icon">

                                        <span class="material-symbols-outlined">
                                            location_on
                                        </span>

                                    </div>

                                    <div>

                                        <small>
                                            Work address
                                        </small>

                                        <strong>
                                            @FormatSiteAddress(
                                                objJob)
                                        </strong>

                                    </div>

                                </div>

                                @if (HasSiteContact(
                                    objJob))
                                {
                                    <div class="job-site-detail">

                                        <span class="material-symbols-outlined">
                                            person_pin_circle
                                        </span>

                                        <div>

                                            <small>
                                                Site contact
                                            </small>

                                            <strong>
                                                @DisplayValue(
                                                    objJob.SiteContactName)
                                            </strong>

                                            @if (!String.IsNullOrWhiteSpace(
                                                objJob.SiteContactPhone))
                                            {
                                                <a href="@GetTelephoneUrl(
                                                                                                       objJob.SiteContactPhone)">

                                                    @objJob.SiteContactPhone

                                                </a>
                                            }

                                        </div>

                                    </div>
                                }

                            </div>

                            @if (!String.IsNullOrWhiteSpace(
                                objJob.AccessNotes))
                            {
                                <div class="job-access-panel">

                                    <span class="material-symbols-outlined">
                                        key
                                    </span>

                                    <div>

                                        <small>
                                            Access notes
                                        </small>

                                        <p>
                                            @objJob.AccessNotes
                                        </p>

                                    </div>

                                </div>
                            }
                        }

                    </div>

                </div>

                <div class="crm-card">

                    <div class="crm-card-header">

                        <div>

                            <h3>
                                Services
                            </h3>

                            <p>
                                Work and agreed pricing included in this job.
                            </p>

                        </div>

                        <button type="button"
                                class="btn btn-soft-secondary btn-sm"
                                @onclick="GoToEdit">

                            <span class="material-symbols-outlined">
                                edit
                            </span>

                            Manage

                        </button>

                    </div>

                    <div class="job-card-body">

                        @if (objJob.ServiceLinks.Count == 0)
                        {
                            <div class="job-services-empty">

                                <span class="material-symbols-outlined">
                                    home_repair_service
                                </span>

                                <div>

                                    <strong>
                                        No services linked
                                    </strong>

                                    <span>
                                        Add services to record the work included in this job.
                                    </span>

                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="job-services-list">

                                @foreach (JobServiceLink objLink
                                    in objJob.ServiceLinks
                                        .OrderBy(
                                            objLink =>
                                                objLink.Service.Name))
                                {
                                    <div class="job-service-card">

                                        <div class="job-service-icon">

                                            <span class="material-symbols-outlined">
                                                home_repair_service
                                            </span>

                                        </div>

                                        <div class="job-service-content">

                                            <strong>
                                                @objLink.Service.Name
                                            </strong>

                                            @if (!String.IsNullOrWhiteSpace(
                                                objLink.Service.Description))
                                            {
                                                <span>
                                                    @objLink.Service.Description
                                                </span>
                                            }

                                            <div class="job-service-line-meta">

                                                <span>
                                                    Qty

                                                    <strong>
                                                        @FormatQuantity(
                                                            objLink.Quantity)
                                                    </strong>

                                                </span>

                                                <span>
                                                    Unit

                                                    <strong>
                                                        @FormatUnitPrice(
                                                            objLink.UnitPrice)
                                                    </strong>

                                                </span>

                                            </div>

                                        </div>

                                        <div class="job-service-price">

                                            <small>
                                                Total
                                            </small>

                                            <strong>
                                                @FormatLineTotal(
                                                    objLink)
                                            </strong>

                                        </div>

                                    </div>
                                }

                            </div>

                            @if (HasPricedServices(
                                objJob))
                            {
                                <div class="job-services-total">

                                    <span>
                                        Services total
                                    </span>

                                    <strong>
                                        @FormatMoney(
                                            GetServicesTotal(
                                                objJob))
                                    </strong>

                                </div>
                            }
                        }

                    </div>

                </div>

                <div class="crm-card job-finance-card">

                    <div class="crm-card-header">

                        <div>

                            <h3>
                                Finance
                            </h3>

                            <p>
                                Invoices, payments and outstanding balance for this job.
                            </p>

                        </div>

                        <button type="button"
                                class="btn btn-soft-primary btn-sm"
                                disabled="@(blnCreatingInvoice || !CanCreateInvoice)"
                                @onclick="CreateInvoiceAsync">

                            @if (blnCreatingInvoice)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined">
                                    receipt_long
                                </span>
                            }

                            @(blnCreatingInvoice
                                ? "Creating..."
                                : "Create invoice")

                        </button>

                    </div>

                    <div class="job-card-body">

                        <div class="job-finance-summary">

                            <div class="job-finance-stat">

                                <span class="job-finance-stat-icon">

                                    <span class="material-symbols-outlined">
                                        request_quote
                                    </span>

                                </span>

                                <span class="job-finance-stat-content">

                                    <small>
                                        Job value
                                    </small>

                                    <strong>
                                        @FormatMoney(
                                            objJob.Value)
                                    </strong>

                                    <span>
                                        Current job value
                                    </span>

                                </span>

                            </div>

                            <div class="job-finance-stat">

                                <span class="job-finance-stat-icon">

                                    <span class="material-symbols-outlined">
                                        receipt_long
                                    </span>

                                </span>

                                <span class="job-finance-stat-content">

                                    <small>
                                        Invoiced
                                    </small>

                                    <strong>
                                        @FormatMoney(
                                            GetInvoicedTotal())
                                    </strong>

                                    <span>
                                        @FormatInvoiceCount(
                                            GetActiveInvoiceCount())
                                    </span>

                                </span>

                            </div>

                            <div class="job-finance-stat">

                                <span class="job-finance-stat-icon job-finance-stat-icon-paid">

                                    <span class="material-symbols-outlined">
                                        payments
                                    </span>

                                </span>

                                <span class="job-finance-stat-content">

                                    <small>
                                        Paid
                                    </small>

                                    <strong class="job-finance-paid">
                                        @FormatMoney(
                                            GetPaidTotal())
                                    </strong>

                                    <span>
                                        Payments received
                                    </span>

                                </span>

                            </div>

                            <div class="job-finance-stat">

                                <span class="job-finance-stat-icon job-finance-stat-icon-outstanding">

                                    <span class="material-symbols-outlined">
                                        account_balance_wallet
                                    </span>

                                </span>

                                <span class="job-finance-stat-content">

                                    <small>
                                        Outstanding
                                    </small>

                                    <strong class="@GetOutstandingValueClass()">
                                        @FormatMoney(
                                            GetOutstandingTotal())
                                    </strong>

                                    <span>
                                        @FormatOutstandingInvoiceCount(
                                            GetOutstandingInvoiceCount())
                                    </span>

                                </span>

                            </div>

                        </div>

                        @if (!CanCreateInvoice &&
                             colInvoices.Count == 0)
                        {
                            <div class="job-invoice-warning">

                                <span class="material-symbols-outlined">
                                    info
                                </span>

                                <div>

                                    <strong>
                                        Invoice not ready
                                    </strong>

                                    <span>
                                        @GetInvoiceReadinessMessage()
                                    </span>

                                </div>

                            </div>
                        }

                        <div class="job-finance-history">

                            <div class="job-finance-history-heading">

                                <div>

                                    <h4>
                                        Invoices
                                    </h4>

                                    <span>
                                        Billing records created from this job.
                                    </span>

                                </div>

                                @if (GetOverdueInvoiceCount() > 0)
                                {
                                    <span class="job-finance-overdue-badge">

                                        <span class="material-symbols-outlined">
                                            warning
                                        </span>

                                        @FormatOverdueInvoiceCount(
                                            GetOverdueInvoiceCount())

                                    </span>
                                }

                            </div>

                            @if (colInvoices.Count == 0)
                            {
                                <div class="job-invoices-empty">

                                    <span class="material-symbols-outlined">
                                        receipt_long
                                    </span>

                                    <div>

                                        <strong>
                                            No invoices yet
                                        </strong>

                                        <span>
                                            Once the job services are priced,
                                            you can create a draft invoice here.
                                        </span>

                                    </div>

                                </div>
                            }
                            else
                            {
                                <div class="job-invoices-list">

                                    @foreach (Invoice objInvoice
                                        in colInvoices
                                            .OrderByDescending(
                                                objInvoice =>
                                                    objInvoice.IssueDateUtc ??
                                                    objInvoice.Entity.CreatedUtc))
                                    {
                                        <a href="@GetInvoiceUrl(
                                                                                       objInvoice.Id)"
                                           class="job-invoice-item">

                                            <div class="job-invoice-icon">

                                                <span class="material-symbols-outlined">
                                                    receipt_long
                                                </span>

                                            </div>

                                            <div class="job-invoice-main">

                                                <strong>
                                                    @objInvoice.InvoiceNumber
                                                </strong>

                                                <span>
                                                    @GetInvoiceDateText(
                                                        objInvoice)
                                                </span>

                                            </div>

                                            <div class="job-invoice-status">

                                                <span class="invoice-status-pill"
                                                      style="@GetInvoiceStatusStyle(
                                                                                                              objInvoice.Status)">

                                                    <span class="material-symbols-outlined">
                                                        @objInvoice.Status.GetUI().IconName
                                                    </span>

                                                    @objInvoice.Status.GetDisplay().Name

                                                </span>

                                            </div>

                                            <div class="job-invoice-total">

                                                <small>
                                                    Total
                                                </small>

                                                <strong>
                                                    @objInvoice.Total.ToString("C")
                                                </strong>

                                                @if (IsOutstanding(
                                                    objInvoice))
                                                {
                                                    <span class="@GetInvoiceOutstandingClass(
                                                                                                                objInvoice)">

                                                        @GetOutstanding(
                                                            objInvoice).ToString("C")
                                                        outstanding

                                                    </span>
                                                }
                                                else if (objInvoice.Status ==
                                                    InvoiceStatus.Paid)
                                                {
                                                    <span class="job-invoice-paid">
                                                        Paid
                                                    </span>
                                                }

                                            </div>

                                            <span class="material-symbols-outlined job-invoice-arrow">
                                                chevron_right
                                            </span>

                                        </a>
                                    }

                                </div>
                            }

                        </div>

                    </div>

                </div>

                <div class="crm-card">

                    <div class="crm-card-header">

                        <div>

                            <h3>
                                Description
                            </h3>

                            <p>
                                Summary and context for this job.
                            </p>

                        </div>

                    </div>

                    <div class="job-card-body">

                        @if (!String.IsNullOrWhiteSpace(
                            objJob.Description))
                        {
                            <p class="job-description">
                                @objJob.Description
                            </p>
                        }
                        else
                        {
                            <div class="job-muted-panel">

                                <span class="material-symbols-outlined">
                                    notes
                                </span>

                                <span>
                                    No description has been added yet.
                                </span>

                            </div>
                        }

                    </div>

                </div>

                <EntityActivities JobId="@JobId"
                                  Title="Activities"
                                  Subtitle="Tasks, visits and follow-ups for this job."
                                  EmptyText="No open activities for this job." />

                <EntityNotes EntityId="@JobId"
                             Title="Notes"
                             Subtitle="Internal notes for this job."
                             EmptyText="No notes have been added for this job yet." />

            </div>

            <aside class="job-side-column">

                <div class="crm-card">

                    <div class="job-card-body">

                        <h4 class="job-side-heading">
                            Quick actions
                        </h4>

                        <div class="job-action-list">

                            <a href="@($"/activities/add?jobId={JobId}")"
                               class="btn btn-soft-primary w-100">

                                <span class="material-symbols-outlined">
                                    add_task
                                </span>

                                Add activity

                            </a>

                            @if (CanCreateInvoice)
                            {
                                <button type="button"
                                        class="btn btn-soft-primary w-100"
                                        disabled="@blnCreatingInvoice"
                                        @onclick="CreateInvoiceAsync">

                                    @if (blnCreatingInvoice)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined">
                                            receipt_long
                                        </span>
                                    }

                                    Create invoice

                                </button>
                            }

                            <a href="@GetJobSheetUrl()"
                               target="_blank"
                               class="btn btn-soft-secondary w-100">

                                <span class="material-symbols-outlined">
                                    print
                                </span>

                                Open job sheet

                            </a>

                            @if (!String.IsNullOrWhiteSpace(
                                objJob.SiteContactPhone))
                            {
                                <a href="@GetTelephoneUrl(
                                                                       objJob.SiteContactPhone)"
                                   class="btn btn-soft-secondary w-100">

                                    <span class="material-symbols-outlined">
                                        call
                                    </span>

                                    Call site contact

                                </a>
                            }

                            @if (objJob.Company != null)
                            {
                                <a href="@GetCompanyUrl(
                                                                       objJob.Company.Id)"
                                   class="btn btn-soft-secondary w-100">

                                    <span class="material-symbols-outlined">
                                        business
                                    </span>

                                    Open company

                                </a>
                            }

                            @if (objJob.Contact != null)
                            {
                                <a href="@GetContactUrl(
                                                                       objJob.Contact.Id)"
                                   class="btn btn-soft-secondary w-100">

                                    <span class="material-symbols-outlined">
                                        person
                                    </span>

                                    Open contact

                                </a>
                            }

                            <button type="button"
                                    class="btn btn-soft-secondary w-100"
                                    @onclick="GoToEdit">

                                <span class="material-symbols-outlined">
                                    edit
                                </span>

                                Edit details

                            </button>

                        </div>

                    </div>

                </div>

                <div class="crm-card">

                    <div class="job-card-body">

                        <h4 class="job-side-heading">
                            Finance
                        </h4>

                        <div class="job-meta-list">

                            <div>

                                <span>
                                    Job value
                                </span>

                                <strong>
                                    @FormatMoney(
                                        objJob.Value)
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Invoiced
                                </span>

                                <strong>
                                    @FormatMoney(
                                        GetInvoicedTotal())
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Paid
                                </span>

                                <strong class="job-side-paid">
                                    @FormatMoney(
