                        </h4>

                        <div class="job-meta-list">

                            <div>

                                <span>
                                    Assigned to
                                </span>

                                <strong>
                                    @GetAssigneeText()
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Company
                                </span>

                                @if (objJob.Company != null)
                                {
