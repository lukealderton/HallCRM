@page "/invoices/{InvoiceId:guid}"

@attribute [Authorize]
@rendermode InteractiveServer

@using CRM.Core.Invoices.Abstractions
@using CRM.Core.Invoices.Domain
@using CRM.Core.Payments.Abstractions
@using CRM.Core.Payments.Domain
@using CRM.Web.State
@using CRM.Web.Users.Abstraction

@inject IInvoiceService InvoiceService
@inject IPaymentService PaymentService
@inject ICurrentUserState CurrentUserState
@inject NavigationManager Navigation
@inject PageHeaderState HeaderState

<SeoHead Title="@strPageTitle" />

<section class="invoice-page">

    @if (!String.IsNullOrWhiteSpace(
        strSuccessMessage))
    {
        <div class="alert alert-success invoice-alert"
             role="alert">

            <span class="material-symbols-outlined">
                check_circle
            </span>

            <div class="alert-content">

                <strong>
                    @strSuccessMessage
                </strong>

            </div>

        </div>
    }

    @if (!String.IsNullOrWhiteSpace(
        strErrorMessage))
    {
        <div class="alert alert-danger invoice-alert"
             role="alert">

            <span class="material-symbols-outlined">
                error
            </span>

            <div class="alert-content">

                <strong>
                    Unable to update invoice
                </strong>

                <p>
                    @strErrorMessage
                </p>

            </div>

        </div>
    }

    @if (objDeletePaymentId.HasValue)
    {
        Payment? objDeletePayment =
            colPayments.FirstOrDefault(
                objPayment =>
                    objPayment.Id ==
                    objDeletePaymentId.Value);

        @if (objDeletePayment != null)
        {
            <div class="alert alert-warning invoice-alert">

                <span class="material-symbols-outlined">
                    delete
                </span>

                <div class="alert-content">

                    <strong>
                        Remove this payment?
                    </strong>

                    <p>
                        This will remove the
                        @objDeletePayment.Amount.ToString("C")
                        payment from the invoice balance.
                    </p>

                </div>

                <div class="alert-actions">

                    <button type="button"
                            class="btn btn-soft-danger btn-sm"
                            disabled="@blnDeletingPayment"
                            @onclick="DeletePaymentAsync">

                        @if (blnDeletingPayment)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }

                        Remove payment

                    </button>

                    <button type="button"
                            class="btn btn-soft-secondary btn-sm"
                            disabled="@blnDeletingPayment"
                            @onclick="CancelDeletePayment">

                        Cancel

                    </button>

                </div>

            </div>
        }
    }

    @if (blnLoading)
    {
        <div class="crm-card">

            <div class="crm-loading">

                <span class="spinner-border spinner-border-sm"></span>

                Loading invoice...

            </div>

        </div>
    }
    else if (objInvoice == null)
    {
        <div class="alert alert-danger invoice-alert"
             role="alert">

            <span class="material-symbols-outlined">
                search_off
            </span>

            <div class="alert-content">

                <strong>
                    Invoice not found
                </strong>

                <p>
                    This invoice could not be loaded.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="invoice-profile-card crm-card">

            <div class="invoice-profile-main">

                <div class="invoice-avatar">

                    <span class="material-symbols-outlined">
                        receipt_long
                    </span>

                </div>

                <div>

                    <div class="invoice-title-row">

                        <h2>
                            @objInvoice.InvoiceNumber
                        </h2>

                        <span class="invoice-status-pill"
                              style="@GetStatusStyle(
                                                              objInvoice.Status)">

                            <span class="material-symbols-outlined">
                                @objInvoice.Status.GetUI().IconName
                            </span>

                            @objInvoice.Status.GetDisplay().Name

                        </span>

                        @if (objInvoice.Entity.ArchivedUtc.HasValue)
                        {
                            <span class="badge text-bg-secondary">
                                Archived
                            </span>
                        }

                    </div>

                    <p class="invoice-subtitle">
                        @DisplayValue(
                            objInvoice.CustomerName)
                    </p>

                    <div class="invoice-meta-row">

                        <span>

                            <span class="material-symbols-outlined">
                                work
                            </span>

                            @objInvoice.Job.Name

                        </span>

                        <span>

                            <span class="material-symbols-outlined">
                                payments
                            </span>

                            @objInvoice.Total.ToString("C")

                        </span>

                        <span>

                            <span class="material-symbols-outlined">
                                event
                            </span>

                            @GetDateSummary(
                                objInvoice)

                        </span>

                    </div>

                </div>

            </div>

            <div class="invoice-profile-actions">

                @if (objInvoice.Status ==
                    InvoiceStatus.Draft)
                {
                    <a href="@GetEditUrl(
                                               objInvoice.Id)"
                       class="btn btn-primary">

                        <span class="material-symbols-outlined">
                            edit
                        </span>

                        Edit invoice

                    </a>
                }
                else
                {
                    <a href="@GetInvoicePdfUrl(
                                               objInvoice.Id)"
                       class="btn btn-primary"
                       target="_blank">

                        <span class="material-symbols-outlined">
                            picture_as_pdf
                        </span>

                        Open PDF

                    </a>
                }

                <a href="@GetJobUrl(
                                       objInvoice.JobId)"
                   class="btn btn-soft-secondary">

                    <span class="material-symbols-outlined">
                        work
                    </span>

                    Open job

                </a>

            </div>

        </div>

        @if (objInvoice.Status !=
             InvoiceStatus.Draft &&
            objInvoice.Status !=
             InvoiceStatus.Void)
        {
            <div class="invoice-finance-grid">

                <div class="invoice-finance-card crm-card">

                    <div class="invoice-finance-icon">

                        <span class="material-symbols-outlined">
                            receipt_long
                        </span>

                    </div>

                    <div>

                        <small>
                            Invoice total
                        </small>

                        <strong>
                            @objInvoice.Total.ToString("C")
                        </strong>

                    </div>

                </div>

                <div class="invoice-finance-card crm-card">

                    <div class="invoice-finance-icon invoice-finance-icon-paid">

                        <span class="material-symbols-outlined">
                            payments
                        </span>

                    </div>

                    <div>

                        <small>
                            Paid
                        </small>

                        <strong>
                            @GetAmountPaid().ToString("C")
                        </strong>

                    </div>

                </div>

                <div class="invoice-finance-card crm-card">

                    <div class="invoice-finance-icon invoice-finance-icon-outstanding">

                        <span class="material-symbols-outlined">
                            account_balance_wallet
                        </span>

                    </div>

                    <div>

                        <small>
                            Outstanding
                        </small>

                        <strong>
                            @GetOutstanding().ToString("C")
                        </strong>

                    </div>

                </div>

            </div>
        }

        <div class="invoice-layout">

            <div class="invoice-main-column">

                <div class="crm-card">

                    <div class="crm-card-header">

                        <div>

                            <h3>
                                Invoice lines
                            </h3>

                            <p>
                                Items and agreed prices captured on this invoice.
                            </p>

                        </div>

                    </div>

                    <div class="invoice-card-body">

                        @if (objInvoice.Lines.Count == 0)
                        {
                            <div class="invoice-empty">

                                <span class="material-symbols-outlined">
                                    receipt_long
                                </span>

                                <span>
                                    This invoice has no lines.
                                </span>

                            </div>
                        }
                        else
                        {
                            <div class="invoice-lines-desktop">

                                <table class="table invoice-lines-table">

                                    <thead>

                                        <tr>

                                            <th>
                                                Description
                                            </th>

                                            <th class="text-end">
                                                Qty
                                            </th>

                                            <th class="text-end">
                                                Unit price
                                            </th>

                                            <th class="text-end">
                                                Total
                                            </th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (InvoiceLine objLine
                                            in objInvoice.Lines
                                                .OrderBy(objLine =>
                                                    objLine.SortOrder))
                                        {
                                            <tr>

                                                <td>

                                                    <strong>
                                                        @objLine.Description
                                                    </strong>

                                                </td>

                                                <td class="text-end">
                                                    @FormatQuantity(
                                                        objLine.Quantity)
                                                </td>

                                                <td class="text-end">
                                                    @objLine.UnitPrice.ToString("C")
                                                </td>

                                                <td class="text-end invoice-line-total">
                                                    @objLine.LineTotal.ToString("C")
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                            <div class="invoice-lines-mobile">

                                @foreach (InvoiceLine objLine
                                    in objInvoice.Lines
                                        .OrderBy(objLine =>
                                            objLine.SortOrder))
                                {
                                    <div class="invoice-line-card">

                                        <strong>
                                            @objLine.Description
                                        </strong>

                                        <div class="invoice-line-meta">

                                            <span>
                                                @FormatQuantity(
                                                    objLine.Quantity)
                                                ×
                                                @objLine.UnitPrice.ToString("C")
                                            </span>

                                            <strong>
                                                @objLine.LineTotal.ToString("C")
                                            </strong>

                                        </div>

                                    </div>
                                }

                            </div>

                            <div class="invoice-totals">

                                <div>

                                    <span>
                                        Subtotal
                                    </span>

                                    <strong>
                                        @objInvoice.Subtotal.ToString("C")
                                    </strong>

                                </div>

                                <div class="invoice-total-row">

                                    <span>
                                        Total
                                    </span>

                                    <strong>
                                        @objInvoice.Total.ToString("C")
                                    </strong>

                                </div>

                            </div>
                        }

                    </div>

                </div>

                @if (objInvoice.Status !=
                     InvoiceStatus.Draft &&
                    objInvoice.Status !=
                     InvoiceStatus.Void)
                {
                    <div class="crm-card">

                        <div class="crm-card-header">

                            <div>

                                <h3>
                                    Payments
                                </h3>

                                <p>
                                    Payments recorded against this invoice.
                                </p>

                            </div>

                            @if (GetOutstanding() > 0m)
                            {
                                <button type="button"
                                        class="btn btn-soft-primary btn-sm"
                                        @onclick="ShowPaymentForm">

                                    <span class="material-symbols-outlined">
                                        add_card
                                    </span>

                                    Record payment

                                </button>
                            }

                        </div>

                        <div class="invoice-card-body">

                            @if (blnShowPaymentForm)
                            {
                                <div class="invoice-payment-form">

                                    <div class="invoice-payment-form-header">

                                        <div>

                                            <strong>
                                                Record payment
                                            </strong>

                                            <span>
                                                Outstanding balance:
                                                @GetOutstanding().ToString("C")
                                            </span>

                                        </div>

                                        <button type="button"
                                                class="btn btn-sm btn-soft-secondary"
                                                @onclick="CancelPayment">

                                            <span class="material-symbols-outlined">
                                                close
                                            </span>

                                        </button>

                                    </div>

                                    <div class="row g-3">

                                        <div class="col-md-6">

                                            <label class="form-label"
                                                   for="paymentAmount">
                                                Amount
                                            </label>

                                            <div class="input-group">

                                                <span class="input-group-text">
                                                    £
                                                </span>

                                                <InputNumber id="paymentAmount"
                                                             class="form-control"
                                                             min="0.01"
                                                             step="0.01"
                                                             @bind-Value="objPaymentForm.Amount" />

                                            </div>

                                        </div>

                                        <div class="col-md-6">

                                            <label class="form-label"
                                                   for="paymentDate">
                                                Payment date
                                            </label>

                                            <InputDate id="paymentDate"
                                                       class="form-control"
                                                       @bind-Value="objPaymentForm.PaymentDateUtc" />

                                        </div>

                                        <div class="col-md-6">

                                            <label class="form-label"
                                                   for="paymentMethod">
                                                Payment method
                                            </label>

                                            <InputSelect id="paymentMethod"
                                                         class="form-select"
                                                         @bind-Value="objPaymentForm.Method">

                                                @foreach (PaymentMethod enmMethod
                                                    in Enum.GetValues<PaymentMethod>())
                                                {
                                                    <option value="@enmMethod">
                                                        @enmMethod.GetDisplay().Name
                                                    </option>
                                                }

                                            </InputSelect>

                                        </div>

                                        <div class="col-md-6">

                                            <label class="form-label"
                                                   for="paymentReference">
                                                Reference
                                            </label>

                                            <InputText id="paymentReference"
                                                       class="form-control"
                                                       @bind-Value="objPaymentForm.Reference"
                                                       placeholder="Bank reference, receipt number..." />

                                        </div>

                                        <div class="col-12">

                                            <label class="form-label"
                                                   for="paymentNotes">
                                                Notes
                                            </label>

                                            <InputTextArea id="paymentNotes"
                                                           class="form-control invoice-payment-notes"
                                                           @bind-Value="objPaymentForm.Notes"
                                                           placeholder="Optional internal note..." />

                                        </div>

                                    </div>

                                    <div class="invoice-payment-form-actions">

                                        <button type="button"
                                                class="btn btn-primary"
                                                disabled="@blnSavingPayment"
                                                @onclick="SavePaymentAsync">

                                            @if (blnSavingPayment)
                                            {
                                                <span class="spinner-border spinner-border-sm"></span>

                                                <span>
                                                    Saving...
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="material-symbols-outlined">
                                                    payments
                                                </span>

                                                <span>
                                                    Record payment
                                                </span>
                                            }

                                        </button>

                                        <button type="button"
                                                class="btn btn-soft-secondary"
                                                disabled="@blnSavingPayment"
                                                @onclick="CancelPayment">

                                            Cancel

                                        </button>

                                    </div>

                                </div>
                            }

                            @if (colPayments.Count == 0)
                            {
                                <div class="invoice-payments-empty">

                                    <span class="material-symbols-outlined">
                                        payments
                                    </span>

                                    <div>

                                        <strong>
                                            No payments recorded
                                        </strong>

                                        <span>
                                            @if (GetOutstanding() > 0m)
                                            {
                                                <text>
                                                    The full
                                                    @GetOutstanding().ToString("C")
                                                    remains outstanding.
                                                </text>
                                            }
                                            else
                                            {
                                                <text>
                                                    There is no outstanding balance.
                                                </text>
                                            }
                                        </span>

                                    </div>

                                </div>
                            }
                            else
                            {
                                <div class="invoice-payments-list">

                                    @foreach (Payment objPayment
                                        in colPayments
                                            .OrderByDescending(objPayment =>
                                                objPayment.PaymentDateUtc)
                                            .ThenByDescending(objPayment =>
                                                objPayment.Entity.CreatedUtc))
                                    {
                                        <div class="invoice-payment-item">

                                            <div class="invoice-payment-method-icon"
                                                 style="@GetPaymentMethodStyle(
                                                                                                     objPayment.Method)">

                                                <span class="material-symbols-outlined">
                                                    @objPayment.Method.GetUI().IconName
                                                </span>

                                            </div>

                                            <div class="invoice-payment-main">

                                                <div class="invoice-payment-title">

                                                    <strong>
                                                        @objPayment.Amount.ToString("C")
                                                    </strong>

                                                    <span>
                                                        @objPayment.Method.GetDisplay().Name
                                                    </span>

                                                </div>

                                                <div class="invoice-payment-meta">

                                                    <span>

                                                        <span class="material-symbols-outlined">
                                                            calendar_today
                                                        </span>

                                                        @FormatDate(
                                                            objPayment.PaymentDateUtc)

                                                    </span>

                                                    @if (!String.IsNullOrWhiteSpace(
                                                        objPayment.Reference))
                                                    {
                                                        <span>

                                                            <span class="material-symbols-outlined">
                                                                tag
                                                            </span>

                                                            @objPayment.Reference

                                                        </span>
                                                    }

                                                </div>

                                                @if (!String.IsNullOrWhiteSpace(
                                                    objPayment.Notes))
                                                {
                                                    <p>
                                                        @objPayment.Notes
                                                    </p>
                                                }

                                            </div>

                                            <button type="button"
                                                    class="btn btn-sm btn-soft-danger invoice-payment-delete"
                                                    title="Remove payment"
                                                    @onclick="@(() => ConfirmDeletePayment(
                                                                                                        objPayment.Id))">

                                                <span class="material-symbols-outlined">
                                                    delete
                                                </span>

                                            </button>

                                        </div>
                                    }

                                </div>
                            }

                        </div>

                    </div>
                }

                <div class="crm-card">

                    <div class="crm-card-header">

                        <div>

                            <h3>
                                Customer
                            </h3>

                            <p>
                                Billing details captured when the invoice was created.
                            </p>

                        </div>

                    </div>

                    <div class="invoice-card-body">

                        <div class="invoice-details-grid">

                            <div>

                                <small>
                                    Customer
                                </small>

                                <strong>
                                    @DisplayValue(
                                        objInvoice.CustomerName)
                                </strong>

                            </div>

                            <div>

                                <small>
                                    Address
                                </small>

                                <strong>
                                    @FormatAddress(
                                        objInvoice)
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>

                @if (!String.IsNullOrWhiteSpace(
                    objInvoice.Notes))
                {
                    <div class="crm-card">

                        <div class="crm-card-header">

                            <div>

                                <h3>
                                    Notes
                                </h3>

                            </div>

                        </div>

                        <div class="invoice-card-body">

                            <p class="invoice-notes">
                                @objInvoice.Notes
                            </p>

                        </div>

                    </div>
                }

            </div>

            <aside class="invoice-side-column">

                <div class="crm-card">

                    <div class="invoice-card-body">

                        <h4 class="invoice-side-heading">
                            Finance
                        </h4>

                        <div class="invoice-finance-summary">

                            <div>

                                <span>
                                    Invoice total
                                </span>

                                <strong>
                                    @objInvoice.Total.ToString("C")
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Paid
                                </span>

                                <strong class="invoice-paid-value">
                                    @GetAmountPaid().ToString("C")
                                </strong>

                            </div>

                            <div class="invoice-outstanding-row">

                                <span>
                                    Outstanding
                                </span>

                                <strong>
                                    @GetOutstanding().ToString("C")
                                </strong>

                            </div>

                        </div>

                        @if (objInvoice.Status !=
                             InvoiceStatus.Draft &&
                            objInvoice.Status !=
                             InvoiceStatus.Void &&
                            GetOutstanding() > 0m)
                        {
                            <button type="button"
                                    class="btn btn-primary w-100 invoice-sidebar-payment-button"
                                    @onclick="ShowPaymentForm">

                                <span class="material-symbols-outlined">
                                    add_card
                                </span>

                                Record payment

                            </button>
                        }

                    </div>

                </div>

                <div class="crm-card">

                    <div class="invoice-card-body">

                        <h4 class="invoice-side-heading">
                            Overview
                        </h4>

                        <div class="invoice-summary-list">

                            <div>

                                <span>
                                    Status
                                </span>

                                <strong>
                                    @objInvoice.Status.GetDisplay().Name
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Issue date
                                </span>

                                <strong>
                                    @FormatDate(
                                        objInvoice.IssueDateUtc)
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Due date
                                </span>

                                <strong>
                                    @FormatDate(
                                        objInvoice.DueDateUtc)
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Payments
                                </span>

                                <strong>
                                    @FormatPaymentCount(
                                        colPayments.Count)
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Created
                                </span>

                                <strong>
                                    @FormatDate(
                                        objInvoice.Entity.CreatedUtc)
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="crm-card">

                    <div class="invoice-card-body">

                        <h4 class="invoice-side-heading">
                            Actions
                        </h4>

                        <div class="invoice-action-list">

                            @if (objInvoice.Status ==
                                InvoiceStatus.Draft)
                            {
                                <a href="@GetEditUrl(
                                                                       objInvoice.Id)"
                                   class="btn btn-soft-primary w-100">

                                    <span class="material-symbols-outlined">
                                        edit
                                    </span>

                                    Edit invoice

                                </a>
                            }
                            else
                            {
                                <a href="@GetInvoicePdfUrl(
                                                                       objInvoice.Id)"
                                   target="_blank"
                                   class="btn btn-soft-primary w-100">

                                    <span class="material-symbols-outlined">
                                        picture_as_pdf
                                    </span>

                                    Open invoice PDF

                                </a>
                            }

                            <a href="@GetJobUrl(
                                                               objInvoice.JobId)"
                               class="btn btn-soft-secondary w-100">

                                <span class="material-symbols-outlined">
                                    work
                                </span>

                                @objInvoice.Job.Name

                            </a>

                            @if (objInvoice.CompanyId.HasValue)
                            {
                                <a href="@GetCompanyUrl(
                                                                       objInvoice.CompanyId.Value)"
                                   class="btn btn-soft-secondary w-100">

                                    <span class="material-symbols-outlined">
                                        business
                                    </span>

                                    Open company

                                </a>
                            }

                            @if (objInvoice.ContactId.HasValue)
                            {
                                <a href="@GetContactUrl(
                                                                       objInvoice.ContactId.Value)"
                                   class="btn btn-soft-secondary w-100">

                                    <span class="material-symbols-outlined">
                                        person
                                    </span>

                                    Open contact

                                </a>
                            }

                        </div>

                    </div>

                </div>

            </aside>

        </div>
    }

</section>

@code {
    [Parameter]
    public Guid InvoiceId { get; set; }

    private Invoice? objInvoice;

    private List<Payment> colPayments =
        [];

    private Payment objPaymentForm =
        new();

    private Guid? objDeletePaymentId;

    private String strPageTitle =
        "Invoice";

    private String? strSuccessMessage;

    private String? strErrorMessage;

    private Boolean blnLoading =
        true;

    private Boolean blnShowPaymentForm;

    private Boolean blnSavingPayment;

    private Boolean blnDeletingPayment;

    protected override async Task OnParametersSetAsync()
    {
        await LoadInvoiceAsync();
    }

    private RenderFragment GetHeaderActions()
    {
        return @<a href="/invoices"
               class="btn btn-soft-secondary">

            <span class="material-symbols-outlined">
                arrow_back
            </span>

            Invoices

        </a>;
    }

    private async Task LoadInvoiceAsync(
        Boolean blnClearMessages = true)
    {
        blnLoading =
            true;

        if (blnClearMessages)
        {
            strSuccessMessage =
                null;

            strErrorMessage =
                null;
        }

        objDeletePaymentId =
            null;

        HeaderState.SetHeader(
            "Invoice",
            "Loading invoice...",
            GetHeaderActions());

        try
        {
            Task<Invoice?> objInvoiceTask =
                InvoiceService.GetInvoiceByIdAsync(
                    InvoiceId);

            Task<List<Payment>> objPaymentsTask =
                PaymentService.GetPaymentsForInvoiceAsync(
                    InvoiceId);

            objInvoice =
                await objInvoiceTask;

            colPayments =
                await objPaymentsTask;

            if (objInvoice == null)
            {
                strPageTitle =
                    "Invoice not found";

                HeaderState.SetHeader(
                    "Invoice not found",
                    "The selected invoice could not be loaded",
                    GetHeaderActions());

                return;
            }

            strPageTitle =
                objInvoice.InvoiceNumber;

            HeaderState.SetHeader(
                objInvoice.InvoiceNumber,
                objInvoice.CustomerName ??
                    objInvoice.Job.Name,
                GetHeaderActions());

            ResetPaymentForm();
        }
        catch (Exception objError)
        {
            strErrorMessage =
                "Failed to load invoice: " +
                objError.Message;

            HeaderState.SetHeader(
                "Invoice",
                "Unable to load invoice",
                GetHeaderActions());
        }
        finally
        {
            blnLoading =
                false;
        }
    }

    private void ShowPaymentForm()
    {
        if (objInvoice == null ||
            GetOutstanding() <= 0m)
        {
            return;
        }

        ResetPaymentForm();

        blnShowPaymentForm =
            true;
    }

    private void CancelPayment()
    {
        blnShowPaymentForm =
            false;

        ResetPaymentForm();
    }

    private void ResetPaymentForm()
    {
        objPaymentForm =
            new Payment
            {
                InvoiceId =
                    InvoiceId,

                Amount =
                    GetOutstanding(),

                PaymentDateUtc =
                    DateTime.Today,

                Method =
                    PaymentMethod.BankTransfer
            };
    }

    private async Task SavePaymentAsync()
    {
        if (objInvoice == null ||
            blnSavingPayment)
        {
            return;
        }

        strErrorMessage =
            null;

        strSuccessMessage =
            null;

        if (objPaymentForm.Amount <= 0m)
        {
            strErrorMessage =
                "Payment amount must be greater than zero.";

            return;
        }

        if (objPaymentForm.Amount >
            GetOutstanding())
        {
            strErrorMessage =
                $"Payment cannot exceed the outstanding balance of {GetOutstanding():C}.";

            return;
        }

        blnSavingPayment =
            true;

        try
        {
            Guid? objUserId =
                await CurrentUserState
                    .GetCurrentUserIdAsync();

            objPaymentForm.InvoiceId =
                InvoiceId;

            await PaymentService.AddPaymentAsync(
                objPaymentForm,
                objUserId);

            blnShowPaymentForm =
                false;

            await LoadInvoiceAsync(
                false);

            strSuccessMessage =
                "Payment recorded";
        }
        catch (Exception objError)
        {
            strErrorMessage =
                "Failed to record payment: " +
                objError.Message;
        }
        finally
        {
            blnSavingPayment =
                false;
        }
    }

    private void ConfirmDeletePayment(
        Guid objPaymentId)
    {
        objDeletePaymentId =
            objPaymentId;

        strSuccessMessage =
            null;

        strErrorMessage =
            null;
    }

    private void CancelDeletePayment()
    {
        objDeletePaymentId =
            null;
    }

    private async Task DeletePaymentAsync()
    {
        if (!objDeletePaymentId.HasValue ||
            blnDeletingPayment)
        {
            return;
        }

        blnDeletingPayment =
            true;

        strErrorMessage =
            null;

        strSuccessMessage =
            null;

        try
        {
            Guid? objUserId =
                await CurrentUserState
                    .GetCurrentUserIdAsync();

            Boolean blnDeleted =
                await PaymentService.DeletePaymentAsync(
                    objDeletePaymentId.Value,
                    objUserId);

            if (!blnDeleted)
            {
                strErrorMessage =
                    "The payment could not be removed.";

                return;
            }

            objDeletePaymentId =
                null;

            await LoadInvoiceAsync(
                false);

            strSuccessMessage =
                "Payment removed";
        }
        catch (Exception objError)
        {
            strErrorMessage =
                "Failed to remove payment: " +
                objError.Message;
        }
        finally
        {
            blnDeletingPayment =
                false;
        }
    }

    private Decimal GetAmountPaid()
    {
        return colPayments.Sum(
            objPayment =>
                objPayment.Amount);
    }

    private Decimal GetOutstanding()
    {
        if (objInvoice == null)
        {
            return 0m;
        }

        return Math.Max(
            0m,
            objInvoice.Total -
            GetAmountPaid());
    }

    private static String GetStatusStyle(
        InvoiceStatus enmStatus)
    {
        return
            $"--invoice-status-color: {enmStatus.GetUI().ColorHex};";
    }

    private static String GetPaymentMethodStyle(
        PaymentMethod enmMethod)
    {
        return
            $"--payment-method-color: {enmMethod.GetUI().ColorHex};";
    }

    private static String GetDateSummary(
        Invoice objInvoice)
    {
        if (!objInvoice.IssueDateUtc.HasValue)
        {
            return "Not issued";
        }

        if (objInvoice.DueDateUtc.HasValue)
        {
            return
                $"Due {FormatDate(objInvoice.DueDateUtc)}";
        }

        return
            $"Issued {FormatDate(objInvoice.IssueDateUtc)}";
    }

    private static String FormatAddress(
        Invoice objInvoice)
    {
        List<String> colParts =
            new[]
            {
                objInvoice.AddressLine1,
                objInvoice.AddressLine2,
                objInvoice.Town,
                objInvoice.County,
                objInvoice.Postcode
            }
            .Where(strValue =>
                !String.IsNullOrWhiteSpace(
                    strValue))
            .Select(strValue =>
                strValue!.Trim())
            .ToList();

        return colParts.Count == 0
            ? "-"
            : String.Join(
                ", ",
                colParts);
    }

    private static String FormatQuantity(
        Decimal dcmQuantity)
    {
        return dcmQuantity.ToString(
            dcmQuantity % 1m == 0m
                ? "0"
                : "0.##");
    }

    private static String FormatPaymentCount(
        Int32 intCount)
    {
        return intCount == 1
            ? "1 payment"
            : $"{intCount} payments";
    }

    private static String FormatDate(
        DateTime? dteDate)
    {
        return dteDate.HasValue
            ? dteDate.Value
                .ToLocalTime()
                .ToString("dd MMM yyyy")
            : "-";
    }

    private static String FormatDate(
        DateTime dteDate)
    {
        return dteDate
            .ToLocalTime()
            .ToString("dd MMM yyyy");
    }

    private static String DisplayValue(
        String? strValue)
    {
        return String.IsNullOrWhiteSpace(
            strValue)
            ? "-"
            : strValue;
    }

