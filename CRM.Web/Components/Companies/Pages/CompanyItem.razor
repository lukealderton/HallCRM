                        </div>

                    </div>

                </div>

            </aside>

        </div>
    }

</div>

@code {
    [Parameter]
    public Guid CompanyId { get; set; }

    private Company objCompany =
        new();

    private List<Contact> colContacts =
        [];

    private List<Job> colJobs =
        [];

    private List<Activity> colActivities =
        [];

    private List<Ticket> colTickets =
        [];

    private List<Invoice> colInvoices =
        [];

    private Boolean blnLoading =
        true;

    private Boolean blnFound;

    private Boolean blnConfirmArchive;

    private Boolean blnConfirmDelete;

    private String strPageTitle =
        "Company";

    private String? strMessage;

    private String? strErrorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadCompanyAsync();
    }

    private RenderFragment GetHeaderActions()
    {
        return @<a href="/companies"
               class="btn btn-soft-secondary">

            <span class="material-symbols-outlined">
                arrow_back
            </span>

            Back to companies

        </a>;
    }

    private async Task LoadCompanyAsync()
    {
        blnLoading =
            true;

        blnFound =
            false;

        strMessage =
            null;

        strErrorMessage =
            null;

        blnConfirmArchive =
            false;

        blnConfirmDelete =
            false;

        colContacts =
            [];

        colJobs =
            [];

        colActivities =
            [];

        colTickets =
            [];

        colInvoices =
            [];

        HeaderState.SetHeader(
            "Company",
            "Loading company...",
            GetHeaderActions());

        try
        {
            Company? objLoadedCompany =
                await CompanyService.GetCompanyByIdAsync(
                    CompanyId);

            if (objLoadedCompany == null)
            {
                HeaderState.SetHeader(
                    "Company not found",
                    "The company could not be loaded",
                    GetHeaderActions());

                return;
            }

            objCompany =
                objLoadedCompany;

            await LoadRelatedRecordsAsync();

            blnFound =
                true;

            strPageTitle =
                objCompany.Name;

            HeaderState.SetHeader(
                objCompany.Name,
                "Company record",
                GetHeaderActions());
        }
        catch (Exception objError)
        {
            strErrorMessage =
                objError.Message;

            HeaderState.SetHeader(
                "Company",
                "Unable to load company",
                GetHeaderActions());
        }
        finally
        {
            blnLoading =
                false;
        }
    }

    private async Task LoadRelatedRecordsAsync()
    {
        Task<List<Contact>> objContactsTask =
            ContactService.GetContactsAsync(
                objCompanyId: CompanyId);

        Task<List<Job>> objJobsTask =
            JobService.GetJobsAsync(
                objCompanyId: CompanyId);

        Task<List<Activity>> objActivitiesTask =
            ActivityService.GetActivitiesAsync(
                objCompanyId: CompanyId);

        Task<List<Invoice>> objInvoicesTask =
            InvoiceService.GetInvoicesAsync(
                objCompanyId: CompanyId);

        Task<TicketSearchResult> objTicketsTask =
            TicketService.GetTicketsAsync(
                new TicketSearchRequest
                {
                    CompanyId =
                        CompanyId
                });

        await Task.WhenAll(
            objContactsTask,
            objJobsTask,
            objActivitiesTask,
            objInvoicesTask,
            objTicketsTask);

        colContacts =
            await objContactsTask;

        colJobs =
            await objJobsTask;

        colActivities =
            await objActivitiesTask;

        colInvoices =
            await objInvoicesTask;

        TicketSearchResult objTicketResult =
            await objTicketsTask;

        colTickets =
            objTicketResult.Tickets?.ToList() ??
            [];
    }

    private IEnumerable<Invoice> GetRecentInvoices()
    {
        return colInvoices
            .OrderByDescending(
                objInvoice =>
                    objInvoice.IssueDateUtc ??
                    objInvoice.Entity.CreatedUtc)
            .Take(5);
    }

    private static Decimal GetAmountPaid(
        Invoice objInvoice)
    {
        return objInvoice.Payments
            .Where(
                objPayment =>
                    !objPayment.Entity.DeletedUtc.HasValue)
            .Sum(
                objPayment =>
                    objPayment.Amount);
    }

    private static Decimal GetOutstanding(
        Invoice objInvoice)
    {
        if (objInvoice.Status ==
                InvoiceStatus.Draft ||
            objInvoice.Status ==
                InvoiceStatus.Void)
        {
            return 0m;
        }

        return Math.Max(
            0m,
            objInvoice.Total -
            GetAmountPaid(
                objInvoice));
    }

    private static Boolean IsActiveInvoice(
        Invoice objInvoice)
    {
        return
            objInvoice.Status !=
                InvoiceStatus.Draft &&
            objInvoice.Status !=
                InvoiceStatus.Void;
    }

    private static Boolean IsOutstanding(
        Invoice objInvoice)
    {
        return
            IsActiveInvoice(
                objInvoice) &&
            GetOutstanding(
                objInvoice) > 0m;
    }

    private static Boolean IsOverdue(
        Invoice objInvoice)
    {
        return
            IsOutstanding(
                objInvoice) &&
            objInvoice.DueDateUtc.HasValue &&
            objInvoice.DueDateUtc.Value.Date <
                DateTime.UtcNow.Date;
    }

    private Decimal GetTotalInvoiced()
    {
        return colInvoices
            .Where(
                IsActiveInvoice)
            .Sum(
                objInvoice =>
                    objInvoice.Total);
    }

    private Decimal GetTotalPaid()
    {
        return colInvoices
            .Where(
                IsActiveInvoice)
            .Sum(
                GetAmountPaid);
    }

    private Decimal GetTotalOutstanding()
    {
        return colInvoices
            .Where(
                IsOutstanding)
            .Sum(
                GetOutstanding);
    }

    private Decimal GetTotalOverdue()
    {
        return colInvoices
            .Where(
                IsOverdue)
            .Sum(
                GetOutstanding);
    }

    private Int32 GetIssuedInvoiceCount()
    {
        return colInvoices.Count(
            IsActiveInvoice);
    }

    private Int32 GetOutstandingInvoiceCount()
    {
        return colInvoices.Count(
            IsOutstanding);
    }

    private Int32 GetOverdueInvoiceCount()
    {
        return colInvoices.Count(
            IsOverdue);
    }

    private String GetOutstandingValueClass()
    {
        return GetTotalOutstanding() > 0m
            ? "company-finance-outstanding"
            : "company-finance-paid";
    }

    private String GetOverdueValueClass()
    {
        return GetTotalOverdue() > 0m
            ? "company-finance-overdue"
            : "company-finance-paid";
    }

    private String GetSidebarOutstandingClass()
    {
        return GetTotalOutstanding() > 0m
            ? "company-side-outstanding"
            : "company-side-paid";
    }

    private static String GetInvoiceOutstandingClass(
        Invoice objInvoice)
    {
        return IsOverdue(
            objInvoice)
            ? "company-invoice-outstanding company-invoice-overdue"
            : "company-invoice-outstanding";
    }

    private static String GetInvoiceStatusStyle(
        InvoiceStatus enmStatus)
    {
        return
            $"--invoice-status-color: {enmStatus.GetUI().ColorHex};";
    }

    private static String GetInvoiceDateText(
        Invoice objInvoice)
    {
        if (IsOverdue(
            objInvoice))
        {
            return
                $"Overdue · due {FormatNullableDate(objInvoice.DueDateUtc)}";
        }

        if (objInvoice.DueDateUtc.HasValue &&
            IsOutstanding(
                objInvoice))
        {
            return
                $"Due {FormatNullableDate(objInvoice.DueDateUtc)}";
        }

        if (objInvoice.IssueDateUtc.HasValue)
        {
            return
                $"Issued {FormatNullableDate(objInvoice.IssueDateUtc)}";
        }

        return
            $"Created {FormatNullableDate(objInvoice.Entity.CreatedUtc)}";
    }

    private String GetCompanyInvoicesUrl(
        String? strStatus = null,
        Boolean blnOutstanding = false,
        Boolean blnOverdue = false)
    {
        Dictionary<String, Object?> dicQuery =
            new()
            {
                ["companyId"] =
                    CompanyId,

                ["status"] =
                    strStatus,

                ["outstanding"] =
                    blnOutstanding
                        ? true
                        : null,

                ["overdue"] =
                    blnOverdue
                        ? true
                        : null
            };

        return objNavigationManager
            .GetUriWithQueryParameters(
                "/invoices",
                dicQuery);
    }

    private static String GetContactName(
        Contact objContact)
    {
        String strName =
            $"{objContact.FirstName} {objContact.LastName}"
                .Trim();

        if (!String.IsNullOrWhiteSpace(
            strName))
        {
            return strName;
        }

        if (!String.IsNullOrWhiteSpace(
            objContact.PrimaryEmail))
        {
            return objContact.PrimaryEmail;
        }

        if (!String.IsNullOrWhiteSpace(
            objContact.PrimaryPhone))
        {
            return objContact.PrimaryPhone;
        }

        if (!String.IsNullOrWhiteSpace(
            objContact.MobilePhone))
        {
            return objContact.MobilePhone;
        }

        return "Contact";
    }

    private static String GetContactSubtitle(
        Contact objContact)
    {
        if (!String.IsNullOrWhiteSpace(
            objContact.JobTitle))
        {
            if (!String.IsNullOrWhiteSpace(
                objContact.PrimaryPhone))
            {
                return
                    $"{objContact.JobTitle} · {objContact.PrimaryPhone}";
            }

            return objContact.JobTitle;
        }

        if (!String.IsNullOrWhiteSpace(
            objContact.Department))
        {
            return objContact.Department;
        }

        if (!String.IsNullOrWhiteSpace(
            objContact.PrimaryEmail))
        {
            return objContact.PrimaryEmail;
        }

        if (!String.IsNullOrWhiteSpace(
            objContact.PrimaryPhone))
        {
            return objContact.PrimaryPhone;
        }

        return "Contact";
    }

    private static String GetContactInitials(
        Contact objContact)
    {
        String strFirstName =
            objContact.FirstName?.Trim() ??
            String.Empty;

        String strLastName =
            objContact.LastName?.Trim() ??
            String.Empty;

        if (!String.IsNullOrWhiteSpace(
                strFirstName) &&
            !String.IsNullOrWhiteSpace(
                strLastName))
        {
            return
                $"{strFirstName[0]}{strLastName[0]}"
                    .ToUpperInvariant();
        }

        if (!String.IsNullOrWhiteSpace(
            strFirstName))
        {
            return
                strFirstName[0]
                    .ToString()
                    .ToUpperInvariant();
        }

        if (!String.IsNullOrWhiteSpace(
            strLastName))
        {
            return
                strLastName[0]
                    .ToString()
                    .ToUpperInvariant();
        }

        return "?";
    }

    private void ShowArchiveConfirmation()
    {
        blnConfirmArchive =
            true;

        blnConfirmDelete =
            false;

        strMessage =
            null;

        strErrorMessage =
            null;
    }

    private void ShowDeleteConfirmation()
    {
        blnConfirmDelete =
            true;

        blnConfirmArchive =
            false;

        strMessage =
            null;

        strErrorMessage =
            null;
    }

    private void CancelActions()
    {
        blnConfirmArchive =
            false;

        blnConfirmDelete =
            false;
    }

    private async Task ArchiveCompanyAsync()
    {
        await RunCompanyActionAsync(
            () =>
                CompanyService.ArchiveCompanyAsync(
                    CompanyId),
            "Company archived");
    }

    private async Task RestoreCompanyAsync()
    {
        await RunCompanyActionAsync(
            () =>
                CompanyService.RestoreCompanyAsync(
                    CompanyId),
            "Company restored");
    }

    private async Task DeleteCompanyAsync()
    {
        strErrorMessage =
            null;

        try
        {
            Boolean blnDeleted =
                await CompanyService.DeleteCompanyAsync(
                    CompanyId);

            if (!blnDeleted)
            {
                strErrorMessage =
                    "The company could not be deleted. " +
                    "It may already have been deleted.";

                return;
            }

            objNavigationManager.NavigateTo(
                "/companies");
        }
        catch (Exception objError)
        {
            strErrorMessage =
                objError.Message;
        }
    }

    private async Task RunCompanyActionAsync(
        Func<Task<Boolean>> objAction,
        String strSuccessMessage)
    {
        strErrorMessage =
            null;

        strMessage =
            null;

        blnConfirmArchive =
            false;

        blnConfirmDelete =
            false;

        try
        {
            Boolean blnSuccess =
                await objAction();

            if (!blnSuccess)
            {
                strErrorMessage =
                    "The company could not be updated. " +
                    "It may have been deleted or no longer exists.";

                return;
            }

            await LoadCompanyAsync();

            strMessage =
                strSuccessMessage;
        }
        catch (Exception objError)
        {
            strErrorMessage =
                objError.Message;
        }
    }

    private Boolean IsArchived()
    {
        return
            objCompany.Entity?.ArchivedUtc.HasValue == true &&
            objCompany.Entity?.DeletedUtc.HasValue != true;
    }

    private Boolean IsDeleted()
    {
        return
            objCompany.Entity?.DeletedUtc.HasValue == true;
    }

    private String GetStatusText()
    {
        if (IsDeleted())
        {
            return "Deleted";
        }

        if (IsArchived())
        {
            return "Archived";
        }

        return "Active";
    }

    private String GetStatusBadgeClass()
    {
        if (IsDeleted())
        {
            return
                "badge text-bg-danger";
        }

        if (IsArchived())
        {
            return
                "badge text-bg-secondary";
        }

        return
            "badge text-bg-success";
    }

    private String GetCompanyInitial()
    {
        if (String.IsNullOrWhiteSpace(
            objCompany.Name))
        {
            return "?";
        }

        return objCompany.Name
            .Trim()
            .Substring(
                0,
                1)
            .ToUpperInvariant();
    }

    private Boolean HasAddress()
    {
        return
            !String.IsNullOrWhiteSpace(
                objCompany.AddressLine1) ||
            !String.IsNullOrWhiteSpace(
                objCompany.AddressLine2) ||
            !String.IsNullOrWhiteSpace(
                objCompany.Town) ||
            !String.IsNullOrWhiteSpace(
                objCompany.County) ||
            !String.IsNullOrWhiteSpace(
                objCompany.Postcode) ||
            !String.IsNullOrWhiteSpace(
                objCompany.Country);
    }

    private String GetLocation()
    {
        List<String> colLocationParts =
            [];

        if (!String.IsNullOrWhiteSpace(
            objCompany.Town))
        {
            colLocationParts.Add(
                objCompany.Town);
        }

        if (!String.IsNullOrWhiteSpace(
            objCompany.County))
        {
            colLocationParts.Add(
                objCompany.County);
        }

        if (!String.IsNullOrWhiteSpace(
            objCompany.Country))
        {
            colLocationParts.Add(
                objCompany.Country);
        }

        if (!colLocationParts.Any())
        {
            return "-";
        }

        return String.Join(
            ", ",
            colLocationParts);
    }

    private static String FormatNullableDate(
        DateTime? dtmDate)
    {
        if (!dtmDate.HasValue)
        {
            return "-";
        }

        return dtmDate.Value
            .ToLocalTime()
            .ToString(
                "dd MMM yyyy");
    }

    private static String GetPluralText(
        Int32 intCount,
        String strSingular,
        String strPlural)
    {
        return intCount == 1
            ? $"{intCount} {strSingular}"
            : $"{intCount} {strPlural}";
    }
}