@page "/companies/{CompanyId:guid}"

@using CRM.Core.Activities.Abstractions
@using CRM.Core.Activities.Domain
@using CRM.Core.Companies.Abstractions
@using CRM.Core.Companies.Domain
@using CRM.Core.Contacts.Abstractions
@using CRM.Core.Contacts.Domain
@using CRM.Core.Jobs.Abstractions
@using CRM.Core.Jobs.Domain
@using CRM.Core.Tickets.Abstractions
@using CRM.Core.Tickets.Domain
@using CRM.Web.State

@attribute [Authorize]

@inject ICompanyService CompanyService
@inject IContactService ContactService
@inject IJobService JobService
@inject IActivityService ActivityService
@inject ITicketService TicketService
@inject NavigationManager objNavigationManager
@inject PageHeaderState HeaderState

<SeoHead Title="@strPageTitle" />

<div class="company-page">
    @if (blnLoading)
    {
        <div class="crm-card">
            <div class="crm-loading">
                <span class="spinner-border spinner-border-sm"></span>
                Loading company...
            </div>
        </div>
    }
    else if (!blnFound)
    {
        <div class="alert alert-danger">
            <span class="material-symbols-outlined">error</span>

            <div class="alert-content">
                <strong class="alert-title">Company not found</strong>

                <p>
                    @if (!String.IsNullOrWhiteSpace(strErrorMessage))
                    {
                        @strErrorMessage
                    }
                    else
                    {
                        <text>The company could not be found or may have been deleted.</text>
                    }
                </p>
            </div>
        </div>
    }
    else
    {
        @if (!String.IsNullOrWhiteSpace(strMessage))
        {
            <div class="alert alert-success">
                <span class="material-symbols-outlined">check_circle</span>

                <div class="alert-content">
                    <strong class="alert-title">@strMessage</strong>
                    <p>The company record has been updated.</p>
                </div>
            </div>
        }

        @if (!String.IsNullOrWhiteSpace(strErrorMessage))
        {
            <div class="alert alert-danger">
                <span class="material-symbols-outlined">error</span>

                <div class="alert-content">
                    <strong class="alert-title">Unable to update company</strong>
                    <p>@strErrorMessage</p>
                </div>
            </div>
        }

        @if (blnConfirmArchive)
        {
            <div class="alert alert-warning">
                <span class="material-symbols-outlined">archive</span>

                <div class="alert-content">
                    <strong class="alert-title">Archive this company?</strong>
                    <p>
                        Archived companies are hidden from normal CRM views
                        but can be restored later.
                    </p>
                </div>

                <div class="alert-actions">
                    <button class="btn btn-soft-danger btn-sm"
                            type="button"
                            @onclick="ArchiveCompanyAsync">
                        Archive company
                    </button>

                    <button class="btn btn-soft-secondary btn-sm"
                            type="button"
                            @onclick="CancelActions">
                        Cancel
                    </button>
                </div>
            </div>
        }

        @if (blnConfirmDelete)
        {
            <div class="alert alert-danger">
                <span class="material-symbols-outlined">delete</span>

                <div class="alert-content">
                    <strong class="alert-title">Delete this company?</strong>
                    <p>
                        This will mark the company as deleted.
                        It will no longer appear in normal company lists.
                    </p>
                </div>

                <div class="alert-actions">
                    <button class="btn btn-soft-danger btn-sm"
                            type="button"
                            @onclick="DeleteCompanyAsync">
                        Delete company
                    </button>

                    <button class="btn btn-soft-secondary btn-sm"
                            type="button"
                            @onclick="CancelActions">
                        Cancel
                    </button>
                </div>
            </div>
        }

        <div class="company-profile-card crm-card">
            <div class="company-profile-main">
                <div class="company-avatar">
                    @GetCompanyInitial()
                </div>

                <div>
                    <div class="company-title-row">
                        <h2>@objCompany.Name</h2>
                        <span class="@GetStatusBadgeClass()">
                            @GetStatusText()
                        </span>
                    </div>

                    @if (!String.IsNullOrWhiteSpace(objCompany.TradingName))
                    {
                        <p class="company-trading-name">
                            Trading as @objCompany.TradingName
                        </p>
                    }

                    <div class="company-meta-row">
                        @if (!String.IsNullOrWhiteSpace(objCompany.Industry))
                        {
                            <span>
                                <span class="material-symbols-outlined">
                                    category
                                </span>

                                @objCompany.Industry
                            </span>
                        }

                        <span>
                            <span class="material-symbols-outlined">
                                location_on
                            </span>

                            @GetLocation()
                        </span>
                    </div>
                </div>
            </div>

            <div class="company-profile-actions">
                <a href="@($"/companies/{CompanyId}/edit")"
                   class="btn btn-primary">

                    <span class="material-symbols-outlined">
                        edit
                    </span>

                    Edit company
                </a>

                @if (IsArchived())
                {
                    <button class="btn btn-soft-primary"
                            type="button"
                            @onclick="RestoreCompanyAsync">

                        <span class="material-symbols-outlined">
                            unarchive
                        </span>

                        Restore
                    </button>
                }
                else
                {
                    <button class="btn btn-soft-secondary"
                            type="button"
                            @onclick="ShowArchiveConfirmation"
                            disabled="@IsDeleted()">

                        <span class="material-symbols-outlined">
                            archive
                        </span>

                        Archive
                    </button>
                }

                <button class="btn btn-soft-danger"
                        type="button"
                        @onclick="ShowDeleteConfirmation"
                        disabled="@IsDeleted()">

                    <span class="material-symbols-outlined">
                        delete
                    </span>

                    Delete
                </button>
            </div>
        </div>

        <div class="company-layout">
            <div class="company-main">

                <div class="crm-card">
                    <div class="crm-card-header">
                        <div>
                            <h3>Contact information</h3>
                            <p>Main ways to contact this company.</p>
                        </div>
                    </div>

                    <div class="company-card-body">
                        <div class="company-info-grid">

                            <div class="company-info-item">
                                <span class="material-symbols-outlined">
                                    mail
                                </span>

                                <div>
                                    <small>Email</small>

                                    @if (!String.IsNullOrWhiteSpace(objCompany.PrimaryEmail))
                                    {
                                        <a href="mailto:@objCompany.PrimaryEmail">
                                            @objCompany.PrimaryEmail
                                        </a>
                                    }
                                    else
                                    {
                                        <strong>-</strong>
                                    }
                                </div>
                            </div>

                            <div class="company-info-item">
                                <span class="material-symbols-outlined">
                                    call
                                </span>

                                <div>
                                    <small>Phone</small>

                                    @if (!String.IsNullOrWhiteSpace(objCompany.PrimaryPhone))
                                    {
                                        <a href="tel:@objCompany.PrimaryPhone">
                                            @objCompany.PrimaryPhone
                                        </a>
                                    }
                                    else
                                    {
                                        <strong>-</strong>
                                    }
                                </div>
                            </div>

                            <div class="company-info-item">
                                <span class="material-symbols-outlined">
                                    language
                                </span>

                                <div>
                                    <small>Website</small>

                                    @if (!String.IsNullOrWhiteSpace(objCompany.Website))
                                    {
                                        <a href="@objCompany.Website"
                                           target="_blank"
                                           rel="noopener noreferrer">
                                            @objCompany.Website
                                        </a>
                                    }
                                    else
                                    {
                                        <strong>-</strong>
                                    }
                                </div>
                            </div>

                            <div class="company-info-item">
                                <span class="material-symbols-outlined">
                                    category
                                </span>

                                <div>
                                    <small>Industry</small>
                                    <strong>@(objCompany.Industry ?? "-")</strong>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="crm-card">
                    <div class="crm-card-header">
                        <div>
                            <h3>Address</h3>
                            <p>Registered or primary trading location.</p>
                        </div>
                    </div>

                    <div class="company-card-body">
                        <div class="company-address">
                            <span class="material-symbols-outlined">
                                location_on
                            </span>

                            <div>
                                @if (HasAddress())
                                {
                                    @if (!String.IsNullOrWhiteSpace(objCompany.AddressLine1))
                                    {
                                        <div>@objCompany.AddressLine1</div>
                                    }

                                    @if (!String.IsNullOrWhiteSpace(objCompany.AddressLine2))
                                    {
                                        <div>@objCompany.AddressLine2</div>
                                    }

                                    <div>@GetLocation()</div>

                                    @if (!String.IsNullOrWhiteSpace(objCompany.Postcode))
                                    {
                                        <div>@objCompany.Postcode</div>
                                    }
                                }
                                else
                                {
                                    <div>
                                        No address has been added yet.
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="crm-card">
                    <div class="crm-card-header">
                        <div>
                            <h3>Related records</h3>
                            <p>
                                Contacts, jobs, tickets and activities linked
                                to this company.
                            </p>
                        </div>
                    </div>

                    <div class="company-card-body">

                        <div class="company-related-summary">

                            <a href="@($"/contacts?companyId={CompanyId}")"
                               class="company-related-stat">

                                <span class="company-related-icon">
                                    <span class="material-symbols-outlined">
                                        person
                                    </span>
                                </span>

                                <span class="company-related-stat-content">
                                    <strong>@colContacts.Count</strong>
                                    <small>Contacts</small>
                                </span>

                                <span class="material-symbols-outlined company-related-arrow">
                                    chevron_right
                                </span>
                            </a>

                            <a href="@($"/jobs?companyId={CompanyId}")"
                               class="company-related-stat">

                                <span class="company-related-icon">
                                    <span class="material-symbols-outlined">
                                        work
                                    </span>
                                </span>

                                <span class="company-related-stat-content">
                                    <strong>@colJobs.Count</strong>
                                    <small>Jobs</small>
                                </span>

                                <span class="material-symbols-outlined company-related-arrow">
                                    chevron_right
                                </span>
                            </a>

                            <a href="@($"/tickets?companyId={CompanyId}")"
                               class="company-related-stat">

                                <span class="company-related-icon">
                                    <span class="material-symbols-outlined">
                                        confirmation_number
                                    </span>
                                </span>

                                <span class="company-related-stat-content">
                                    <strong>@colTickets.Count</strong>
                                    <small>Tickets</small>
                                </span>

                                <span class="material-symbols-outlined company-related-arrow">
                                    chevron_right
                                </span>
                            </a>

                            <a href="@($"/activities?companyId={CompanyId}")"
                               class="company-related-stat">

                                <span class="company-related-icon">
                                    <span class="material-symbols-outlined">
                                        event_note
                                    </span>
                                </span>

                                <span class="company-related-stat-content">
                                    <strong>@colActivities.Count</strong>
                                    <small>Activities</small>
                                </span>

                                <span class="material-symbols-outlined company-related-arrow">
                                    chevron_right
                                </span>
                            </a>

                        </div>

                        <div class="company-related-grid">

                            <section class="company-related-section">
                                <div class="company-related-heading">
                                    <div>
                                        <h4>Contacts</h4>
                                        <span>
                                            People linked to this company.
                                        </span>
                                    </div>

                                    <a href="@($"/contacts?companyId={CompanyId}")">
                                        View all
                                    </a>
                                </div>

                                @if (colContacts.Count == 0)
                                {
                                    <div class="company-related-empty">
                                        <span class="material-symbols-outlined">
                                            person_off
                                        </span>

                                        <span>
                                            No contacts are linked to this company.
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="company-related-list">
                                        @foreach (Contact objContact in colContacts.Take(5))
                                        {
                                            <a href="@($"/contacts/{objContact.Id}")"
                                               class="company-related-list-item">

                                                <span class="company-related-avatar">
                                                    @GetContactInitials(objContact)
                                                </span>

                                                <span class="company-related-list-content">
                                                    <strong>
                                                        @GetContactName(objContact)
                                                    </strong>

                                                    <small>
                                                        @GetContactSubtitle(objContact)
                                                    </small>
                                                </span>

                                                <span class="material-symbols-outlined">
                                                    chevron_right
                                                </span>
                                            </a>
                                        }
                                    </div>
                                }
                            </section>

                            <section class="company-related-section">
                                <div class="company-related-heading">
                                    <div>
                                        <h4>Jobs</h4>

                                        <span>
                                            Work and opportunities for this company.
                                        </span>
                                    </div>

                                    <a href="@($"/jobs?companyId={CompanyId}")">
                                        View all
                                    </a>
                                </div>

                                @if (colJobs.Count == 0)
                                {
                                    <div class="company-related-empty">
                                        <span class="material-symbols-outlined">
                                            work_off
                                        </span>

                                        <span>
                                            No jobs are linked to this company.
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="company-related-list">
                                        @foreach (Job objJob in colJobs.Take(5))
                                        {
                                            <a href="@($"/jobs/{objJob.Id}")"
                                               class="company-related-list-item">

                                                <span class="company-related-record-icon">
                                                    <span class="material-symbols-outlined">
                                                        work
                                                    </span>
                                                </span>

                                                <span class="company-related-list-content">
                                                    <strong>
                                                        @objJob.Name
                                                    </strong>

                                                    <small>
                                                        @objJob.Stage.GetDisplay().Name

                                                        @if (objJob.Value.HasValue)
                                                        {
                                                            <text>
                                                                · @objJob.Value.Value.ToString("C")
                                                            </text>
                                                        }
                                                    </small>
                                                </span>

                                                <span class="material-symbols-outlined">
                                                    chevron_right
                                                </span>
                                            </a>
                                        }
                                    </div>
                                }
                            </section>

                            <section class="company-related-section">
                                <div class="company-related-heading">
                                    <div>
                                        <h4>Tickets</h4>

                                        <span>
                                            Maintenance and support work.
                                        </span>
                                    </div>

                                    <a href="@($"/tickets?companyId={CompanyId}")">
                                        View all
                                    </a>
                                </div>

                                @if (colTickets.Count == 0)
                                {
                                    <div class="company-related-empty">
                                        <span class="material-symbols-outlined">
                                            confirmation_number
                                        </span>

                                        <span>
                                            No tickets are linked to this company.
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="company-related-list">
                                        @foreach (Ticket objTicket in colTickets.Take(5))
                                        {
                                            <a href="@($"/tickets/{objTicket.Id}")"
                                               class="company-related-list-item">

                                                <span class="company-related-record-icon">
                                                    <span class="material-symbols-outlined">
                                                        confirmation_number
                                                    </span>
                                                </span>

                                                <span class="company-related-list-content">
                                                    <strong>
                                                        @objTicket.Title
                                                    </strong>

                                                    <small>
                                                        @objTicket.Status.GetDisplay().Name
                                                        ·
                                                        @objTicket.Priority.GetDisplay().Name
                                                    </small>
                                                </span>

                                                <span class="material-symbols-outlined">
                                                    chevron_right
                                                </span>
                                            </a>
                                        }
                                    </div>
                                }
                            </section>

                            <section class="company-related-section">
                                <div class="company-related-heading">
                                    <div>
                                        <h4>Recent activities</h4>

                                        <span>
                                            Tasks and follow-ups for this company.
                                        </span>
                                    </div>

                                    <a href="@($"/activities?companyId={CompanyId}")">
                                        View all
                                    </a>
                                </div>

                                @if (colActivities.Count == 0)
                                {
                                    <div class="company-related-empty">
                                        <span class="material-symbols-outlined">
                                            event_busy
                                        </span>

                                        <span>
                                            No activities are linked to this company.
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="company-related-list">
                                        @foreach (Activity objActivity in GetRecentActivities())
                                        {
                                            <a href="@($"/activities/{objActivity.Id}")"
                                               class="company-related-list-item">

                                                <span class="company-related-record-icon">
                                                    <span class="material-symbols-outlined">
                                                        event_note
                                                    </span>
                                                </span>

                                                <span class="company-related-list-content">
                                                    <strong>
                                                        @objActivity.Subject
                                                    </strong>

                                                    <small>
                                                        @objActivity.Type.GetDisplay().Name

                                                        @if (objActivity.DueUtc.HasValue)
                                                        {
                                                            <text>
                                                                ·
                                                                @objActivity.DueUtc.Value
                                                                    .ToLocalTime()
                                                                    .ToString("dd MMM yyyy")
                                                            </text>
                                                        }
                                                    </small>
                                                </span>

                                                <span class="material-symbols-outlined">
                                                    chevron_right
                                                </span>
                                            </a>
                                        }
                                    </div>
                                }
                            </section>

                        </div>
                    </div>
                </div>

                <EntityActivities CompanyId="@CompanyId"
                                  Title="Activities"
                                  Subtitle="Upcoming tasks and follow-ups for this company."
                                  EmptyText="No open activities for this company." />

                <EntityNotes EntityId="@CompanyId"
                             Title="Notes"
                             Subtitle="Internal notes for this company."
                             EmptyText="No notes have been added for this company yet." />

            </div>

            <aside class="company-side">

                <div class="crm-card">
                    <div class="company-card-body">
                        <h4 class="company-side-heading">
                            Quick actions
                        </h4>

                        <div class="company-action-list">

                            <a href="@($"/contacts/add?companyId={CompanyId}")"
                               class="btn btn-soft-primary w-100">

                                <span class="material-symbols-outlined">
                                    person_add
                                </span>

                                Add contact
                            </a>

                            <a href="@($"/jobs/add?companyId={CompanyId}")"
                               class="btn btn-soft-primary w-100">

                                <span class="material-symbols-outlined">
                                    add_business
                                </span>

                                Add job
                            </a>

                            <a href="@($"/tickets/add?companyId={CompanyId}")"
                               class="btn btn-soft-primary w-100">

                                <span class="material-symbols-outlined">
                                    confirmation_number
                                </span>

                                Add ticket
                            </a>

                            <a href="@($"/activities/add?companyId={CompanyId}")"
                               class="btn btn-soft-primary w-100">

                                <span class="material-symbols-outlined">
                                    add_task
                                </span>

                                Add activity
                            </a>

                            @if (!String.IsNullOrWhiteSpace(objCompany.PrimaryEmail))
                            {
                                <a href="mailto:@objCompany.PrimaryEmail"
                                   class="btn btn-soft-secondary w-100">

                                    <span class="material-symbols-outlined">
                                        mail
                                    </span>

                                    Send email
                                </a>
                            }

                            @if (!String.IsNullOrWhiteSpace(objCompany.PrimaryPhone))
                            {
                                <a href="tel:@objCompany.PrimaryPhone"
                                   class="btn btn-soft-secondary w-100">

                                    <span class="material-symbols-outlined">
                                        call
                                    </span>

                                    Call company
                                </a>
                            }

                            @if (!String.IsNullOrWhiteSpace(objCompany.Website))
                            {
                                <a href="@objCompany.Website"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn btn-soft-secondary w-100">

                                    <span class="material-symbols-outlined">
                                        open_in_new
                                    </span>

                                    Open website
                                </a>
                            }

                        </div>
                    </div>
                </div>

                <div class="crm-card">
                    <div class="company-card-body">
                        <h4 class="company-side-heading">
                            Registration
                        </h4>

                        <div class="company-meta-list">
                            <div>
                                <span>Company number</span>
                                <strong>
                                    @(objCompany.CompanyNumber ?? "-")
                                </strong>
                            </div>

                            @if (!String.IsNullOrWhiteSpace(objCompany.CharityNumber))
                            {
                                <div>
                                    <span>Charity number</span>
                                    <strong>
                                        @objCompany.CharityNumber
                                    </strong>
                                </div>
                            }

                            <div>
                                <span>VAT number</span>
                                <strong>
                                    @(objCompany.VatNumber ?? "-")
                                </strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="crm-card">
                    <div class="company-card-body">
                        <h4 class="company-side-heading">
                            Record details
                        </h4>

                        <div class="company-meta-list">
                            <div>
                                <span>Created</span>

                                <strong>
                                    @FormatNullableDate(
                                        objCompany.Entity?.CreatedUtc)
                                </strong>
                            </div>

                            <div>
                                <span>Updated</span>

                                <strong>
                                    @FormatNullableDate(
                                        objCompany.Entity?.UpdatedUtc)
                                </strong>
                            </div>

                            @if (objCompany.Entity?.ArchivedUtc != null)
                            {
                                <div>
                                    <span>Archived</span>

                                    <strong>
                                        @FormatNullableDate(
                                            objCompany.Entity.ArchivedUtc)
                                    </strong>
                                </div>
                            }

                            @if (objCompany.Entity?.DeletedUtc != null)
                            {
                                <div>
                                    <span>Deleted</span>

                                    <strong>
                                        @FormatNullableDate(
                                            objCompany.Entity.DeletedUtc)
                                    </strong>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </aside>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid CompanyId { get; set; }

    private Company objCompany = new();

    private List<Contact> colContacts = [];
    private List<Job> colJobs = [];
    private List<Activity> colActivities = [];
    private List<Ticket> colTickets = [];

    private Boolean blnLoading = true;
    private Boolean blnFound;
    private Boolean blnConfirmArchive;
    private Boolean blnConfirmDelete;

    private String strPageTitle = "Company";
    private String? strMessage;
    private String? strErrorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadCompanyAsync();
    }

    private RenderFragment GetHeaderActions()
    {
        return @<a href="/companies"
                   class="btn btn-soft-secondary">
            <span class="material-symbols-outlined">
                arrow_back
            </span>

            Back to companies
        </a>;
    }

    private async Task LoadCompanyAsync()
    {
        blnLoading = true;
        blnFound = false;

        strMessage = null;
        strErrorMessage = null;

        blnConfirmArchive = false;
        blnConfirmDelete = false;

        colContacts = [];
        colJobs = [];
        colActivities = [];
        colTickets = [];

        HeaderState.SetHeader(
            "Company",
            "Loading company...",
            GetHeaderActions());

        try
        {
            Company? objLoadedCompany =
                await CompanyService.GetCompanyByIdAsync(
                    CompanyId);

            if (objLoadedCompany == null)
            {
                HeaderState.SetHeader(
                    "Company not found",
                    "The company could not be loaded",
                    GetHeaderActions());

                return;
            }

            objCompany = objLoadedCompany;

            await LoadRelatedRecordsAsync();

            blnFound = true;
            strPageTitle = objCompany.Name;

            HeaderState.SetHeader(
                objCompany.Name,
                "Company record",
                GetHeaderActions());
        }
        catch (Exception objError)
        {
            strErrorMessage = objError.Message;

            HeaderState.SetHeader(
                "Company",
                "Unable to load company",
                GetHeaderActions());
        }
        finally
        {
            blnLoading = false;
        }
    }

    private async Task LoadRelatedRecordsAsync()
    {
        Task<List<Contact>> objContactsTask =
            ContactService.GetContactsAsync(
                objCompanyId: CompanyId);

        Task<List<Job>> objJobsTask =
            JobService.GetJobsAsync(
                objCompanyId: CompanyId);

        Task<List<Activity>> objActivitiesTask =
            ActivityService.GetActivitiesAsync(
                objCompanyId: CompanyId);

        Task<TicketSearchResult> objTicketsTask =
            TicketService.GetTicketsAsync(
                new TicketSearchRequest
                {
                    CompanyId = CompanyId
                });

        await Task.WhenAll(
            objContactsTask,
            objJobsTask,
            objActivitiesTask,
            objTicketsTask);

        colContacts =
            await objContactsTask;

        colJobs =
            await objJobsTask;

        colActivities =
            await objActivitiesTask;

        TicketSearchResult objTicketResult =
            await objTicketsTask;

        colTickets =
            objTicketResult.Tickets?.ToList() ?? [];
    }

    private IEnumerable<Activity> GetRecentActivities()
    {
        return colActivities
            .OrderByDescending(
                x => x.Entity?.CreatedUtc ?? DateTime.MinValue)
            .Take(5);
    }

    private static String GetContactName(
        Contact objContact)
    {
        String strName =
            $"{objContact.FirstName} {objContact.LastName}"
                .Trim();

        if (!String.IsNullOrWhiteSpace(strName))
        {
            return strName;
        }

        if (!String.IsNullOrWhiteSpace(objContact.PrimaryEmail))
        {
            return objContact.PrimaryEmail;
        }

        if (!String.IsNullOrWhiteSpace(objContact.PrimaryPhone))
        {
            return objContact.PrimaryPhone;
        }

        if (!String.IsNullOrWhiteSpace(objContact.MobilePhone))
        {
            return objContact.MobilePhone;
        }

        return "Contact";
    }

    private static String GetContactSubtitle(
        Contact objContact)
    {
        if (!String.IsNullOrWhiteSpace(objContact.JobTitle))
        {
            return objContact.JobTitle;
        }

        if (!String.IsNullOrWhiteSpace(objContact.Department))
        {
            return objContact.Department;
        }

        if (!String.IsNullOrWhiteSpace(objContact.PrimaryEmail))
        {
            return objContact.PrimaryEmail;
        }

        return "Contact";
    }

    private static String GetContactInitials(
        Contact objContact)
    {
        String strFirstName =
            objContact.FirstName?.Trim() ??
            String.Empty;

        String strLastName =
            objContact.LastName?.Trim() ??
            String.Empty;

        if (!String.IsNullOrWhiteSpace(strFirstName) &&
            !String.IsNullOrWhiteSpace(strLastName))
        {
            return $"{strFirstName[0]}{strLastName[0]}"
                .ToUpperInvariant();
        }

        if (!String.IsNullOrWhiteSpace(strFirstName))
        {
            return strFirstName[0]
                .ToString()
                .ToUpperInvariant();
        }

        if (!String.IsNullOrWhiteSpace(strLastName))
        {
            return strLastName[0]
                .ToString()
                .ToUpperInvariant();
        }

        return "?";
    }

    private void ShowArchiveConfirmation()
    {
        blnConfirmArchive = true;
        blnConfirmDelete = false;

        strMessage = null;
        strErrorMessage = null;
    }

    private void ShowDeleteConfirmation()
    {
        blnConfirmDelete = true;
        blnConfirmArchive = false;

        strMessage = null;
        strErrorMessage = null;
    }

    private void CancelActions()
    {
        blnConfirmArchive = false;
        blnConfirmDelete = false;
    }

    private async Task ArchiveCompanyAsync()
    {
        await RunCompanyActionAsync(
            () => CompanyService.ArchiveCompanyAsync(
                CompanyId),
            "Company archived");
    }

    private async Task RestoreCompanyAsync()
    {
        await RunCompanyActionAsync(
            () => CompanyService.RestoreCompanyAsync(
                CompanyId),
            "Company restored");
    }

    private async Task DeleteCompanyAsync()
    {
        strErrorMessage = null;

        try
        {
            Boolean blnDeleted =
                await CompanyService.DeleteCompanyAsync(
                    CompanyId);

            if (!blnDeleted)
            {
                strErrorMessage =
                    "The company could not be deleted. " +
                    "It may already have been deleted.";

                return;
            }

            objNavigationManager.NavigateTo(
                "/companies");
        }
        catch (Exception objError)
        {
            strErrorMessage =
                objError.Message;
        }
    }

    private async Task RunCompanyActionAsync(
        Func<Task<Boolean>> objAction,
        String strSuccessMessage)
    {
        strErrorMessage = null;
        strMessage = null;

        blnConfirmArchive = false;
        blnConfirmDelete = false;

        try
        {
            Boolean blnSuccess =
                await objAction();

            if (!blnSuccess)
            {
                strErrorMessage =
                    "The company could not be updated. " +
                    "It may have been deleted or no longer exists.";

                return;
            }

            await LoadCompanyAsync();

            strMessage =
                strSuccessMessage;
        }
        catch (Exception objError)
        {
            strErrorMessage =
                objError.Message;
        }
    }

    private Boolean IsArchived()
    {
        return
            objCompany.Entity?.ArchivedUtc.HasValue == true &&
            objCompany.Entity?.DeletedUtc.HasValue != true;
    }

    private Boolean IsDeleted()
    {
        return
            objCompany.Entity?.DeletedUtc.HasValue == true;
    }

    private String GetStatusText()
    {
        if (IsDeleted())
        {
            return "Deleted";
        }

        if (IsArchived())
        {
            return "Archived";
        }

        return "Active";
    }

    private String GetStatusBadgeClass()
    {
        if (IsDeleted())
        {
            return "badge text-bg-danger";
        }

        if (IsArchived())
        {
            return "badge text-bg-secondary";
        }

        return "badge text-bg-success";
    }

    private String GetCompanyInitial()
    {
        if (String.IsNullOrWhiteSpace(objCompany.Name))
        {
            return "?";
        }

        return objCompany.Name
            .Trim()
            .Substring(0, 1)
            .ToUpperInvariant();
    }

    private Boolean HasAddress()
    {
        return
            !String.IsNullOrWhiteSpace(objCompany.AddressLine1) ||
            !String.IsNullOrWhiteSpace(objCompany.AddressLine2) ||
            !String.IsNullOrWhiteSpace(objCompany.Town) ||
            !String.IsNullOrWhiteSpace(objCompany.County) ||
            !String.IsNullOrWhiteSpace(objCompany.Postcode) ||
            !String.IsNullOrWhiteSpace(objCompany.Country);
    }

    private String GetLocation()
    {
        List<String> colLocationParts = [];

        if (!String.IsNullOrWhiteSpace(objCompany.Town))
        {
            colLocationParts.Add(
                objCompany.Town);
        }

        if (!String.IsNullOrWhiteSpace(objCompany.County))
        {
            colLocationParts.Add(
                objCompany.County);
        }

        if (!String.IsNullOrWhiteSpace(objCompany.Country))
        {
            colLocationParts.Add(
                objCompany.Country);
        }

        if (!colLocationParts.Any())
        {
            return "-";
        }

        return String.Join(
            ", ",
            colLocationParts);
    }

    private static String FormatNullableDate(
        DateTime? dtmDate)
    {
        if (!dtmDate.HasValue)
        {
            return "-";
        }

        return dtmDate.Value
            .ToLocalTime()
            .ToString("dd MMM yyyy");
    }
}