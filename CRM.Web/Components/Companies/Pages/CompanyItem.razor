                                    @GetTotalPaid().ToString("C")
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Outstanding
                                </span>

                                <strong class="@GetSidebarOutstandingClass()">
                                    @GetTotalOutstanding().ToString("C")
