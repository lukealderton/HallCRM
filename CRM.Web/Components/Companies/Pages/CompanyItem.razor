@page "/companies/{CompanyId:guid}"

@using CRM.Core.Activities.Abstractions
@using CRM.Core.Activities.Domain
@using CRM.Core.Companies.Abstractions
@using CRM.Core.Companies.Domain
@using CRM.Core.Contacts.Abstractions
@using CRM.Core.Contacts.Domain
@using CRM.Core.Invoices.Abstractions
@using CRM.Core.Invoices.Domain
@using CRM.Core.Jobs.Abstractions
@using CRM.Core.Jobs.Domain
@using CRM.Core.Tickets.Abstractions
@using CRM.Core.Tickets.Domain
@using CRM.Web.Components.Activities.Shared
@using CRM.Web.State

@attribute [Authorize]

@inject ICompanyService CompanyService
@inject IContactService ContactService
@inject IJobService JobService
@inject IInvoiceService InvoiceService
@inject IActivityService ActivityService
@inject ITicketService TicketService
@inject NavigationManager objNavigationManager
@inject PageHeaderState HeaderState

<SeoHead Title="@strPageTitle" />

<div class="company-page">

    @if (blnLoading)
    {
        <div class="crm-card">

            <div class="crm-loading">

                <span class="spinner-border spinner-border-sm"></span>

                Loading company...

            </div>

        </div>
    }
    else if (!blnFound)
    {
        <div class="alert alert-danger">

            <span class="material-symbols-outlined">
                error
            </span>

            <div class="alert-content">

                <strong class="alert-title">
                    Company not found
                </strong>

                <p>
                    @if (!String.IsNullOrWhiteSpace(
                        strErrorMessage))
                    {
                        @strErrorMessage
                    }
                    else
                    {
                        <text>
                            The company could not be found or may have been deleted.
                        </text>
                    }
                </p>

            </div>

        </div>
    }
    else
    {
        @if (!String.IsNullOrWhiteSpace(
            strMessage))
        {
            <div class="alert alert-success">

                <span class="material-symbols-outlined">
                    check_circle
                </span>

                <div class="alert-content">

                    <strong class="alert-title">
                        @strMessage
                    </strong>

                    <p>
                        The company record has been updated.
                    </p>

                </div>

            </div>
        }

        @if (!String.IsNullOrWhiteSpace(
            strErrorMessage))
        {
            <div class="alert alert-danger">

                <span class="material-symbols-outlined">
                    error
                </span>

                <div class="alert-content">

                    <strong class="alert-title">
                        Unable to update company
                    </strong>

                    <p>
                        @strErrorMessage
                    </p>

                </div>

            </div>
        }

        @if (blnConfirmArchive)
        {
            <div class="alert alert-warning">

                <span class="material-symbols-outlined">
                    archive
                </span>

                <div class="alert-content">

                    <strong class="alert-title">
                        Archive this company?
                    </strong>

                    <p>
                        Archived companies are hidden from normal CRM views
                        but can be restored later.
                    </p>

                </div>

                <div class="alert-actions">

                    <button class="btn btn-soft-danger btn-sm"
                            type="button"
                            @onclick="ArchiveCompanyAsync">

                        Archive company

                    </button>

                    <button class="btn btn-soft-secondary btn-sm"
                            type="button"
                            @onclick="CancelActions">

                        Cancel

                    </button>

                </div>

            </div>
        }

        @if (blnConfirmDelete)
        {
            <div class="alert alert-danger">

                <span class="material-symbols-outlined">
                    delete
                </span>

                <div class="alert-content">

                    <strong class="alert-title">
                        Delete this company?
                    </strong>

                    <p>
                        This will mark the company as deleted.
                        It will no longer appear in normal company lists.
                    </p>

                </div>

                <div class="alert-actions">

                    <button class="btn btn-soft-danger btn-sm"
                            type="button"
                            @onclick="DeleteCompanyAsync">

                        Delete company

                    </button>

                    <button class="btn btn-soft-secondary btn-sm"
                            type="button"
                            @onclick="CancelActions">

                        Cancel

                    </button>

                </div>

            </div>
        }

        <div class="company-profile-card crm-card">

            <div class="company-profile-main">

                <div class="company-avatar">
                    @GetCompanyInitial()
                </div>

                <div>

                    <div class="company-title-row">

                        <h2>
                            @objCompany.Name
                        </h2>

                        <span class="@GetStatusBadgeClass()">
                            @GetStatusText()
                        </span>

                    </div>

                    @if (!String.IsNullOrWhiteSpace(
                        objCompany.TradingName))
                    {
                        <p class="company-trading-name">
                            Trading as @objCompany.TradingName
                        </p>
                    }

                    <div class="company-meta-row">

                        @if (!String.IsNullOrWhiteSpace(
                            objCompany.Industry))
                        {
                            <span>

                                <span class="material-symbols-outlined">
                                    category
                                </span>

                                @objCompany.Industry

                            </span>
                        }

                        <span>

                            <span class="material-symbols-outlined">
                                location_on
                            </span>

                            @GetLocation()

                        </span>

                        @if (colInvoices.Count > 0)
                        {
                            <span>

                                <span class="material-symbols-outlined">
                                    receipt_long
                                </span>

                                @GetPluralText(
                                    colInvoices.Count,
                                    "invoice",
                                    "invoices")

                            </span>
                        }

                    </div>

                </div>

            </div>

            <div class="company-profile-actions">

                <a href="@($"/companies/{CompanyId}/edit")"
                   class="btn btn-primary">

                    <span class="material-symbols-outlined">
                        edit
                    </span>

                    Edit company

                </a>

                @if (IsArchived())
                {
                    <button class="btn btn-soft-primary"
                            type="button"
                            @onclick="RestoreCompanyAsync">

                        <span class="material-symbols-outlined">
                            unarchive
                        </span>

                        Restore

                    </button>
                }
                else
                {
                    <button class="btn btn-soft-secondary"
                            type="button"
                            @onclick="ShowArchiveConfirmation"
                            disabled="@IsDeleted()">

                        <span class="material-symbols-outlined">
                            archive
                        </span>

                        Archive

                    </button>
                }

                <button class="btn btn-soft-danger"
                        type="button"
                        @onclick="ShowDeleteConfirmation"
                        disabled="@IsDeleted()">

                    <span class="material-symbols-outlined">
                        delete
                    </span>

                    Delete

                </button>

            </div>

        </div>

        <div class="company-layout">

            <div class="company-main">

                <div class="crm-card">

                    <div class="crm-card-header">

                        <div>

                            <h3>
                                Company details
                            </h3>

                            <p>
                                Contact details and primary company address.
                            </p>

                        </div>

                    </div>

                    <div class="company-card-body">

                        <div class="company-info-grid">

                            <div class="company-info-item">

                                <span class="material-symbols-outlined">
                                    mail
                                </span>

                                <div>

                                    <small>
                                        Email
                                    </small>

                                    @if (!String.IsNullOrWhiteSpace(
                                        objCompany.PrimaryEmail))
                                    {
                                        <a href="mailto:@objCompany.PrimaryEmail">
                                            @objCompany.PrimaryEmail
                                        </a>
                                    }
                                    else
                                    {
                                        <strong>
                                            -
                                        </strong>
                                    }

                                </div>

                            </div>

                            <div class="company-info-item">

                                <span class="material-symbols-outlined">
                                    call
                                </span>

                                <div>

                                    <small>
                                        Phone
                                    </small>

                                    @if (!String.IsNullOrWhiteSpace(
                                        objCompany.PrimaryPhone))
                                    {
                                        <a href="tel:@objCompany.PrimaryPhone">
                                            @objCompany.PrimaryPhone
                                        </a>
                                    }
                                    else
                                    {
                                        <strong>
                                            -
                                        </strong>
                                    }

                                </div>

                            </div>

                            <div class="company-info-item">

                                <span class="material-symbols-outlined">
                                    language
                                </span>

                                <div>

                                    <small>
                                        Website
                                    </small>

                                    @if (!String.IsNullOrWhiteSpace(
                                        objCompany.Website))
                                    {
                                        <a href="@objCompany.Website"
                                           target="_blank"
                                           rel="noopener noreferrer">

                                            @objCompany.Website

                                        </a>
                                    }
                                    else
                                    {
                                        <strong>
                                            -
                                        </strong>
                                    }

                                </div>

                            </div>

                            <div class="company-info-item">

                                <span class="material-symbols-outlined">
                                    category
                                </span>

                                <div>

                                    <small>
                                        Industry
                                    </small>

                                    <strong>
                                        @(objCompany.Industry ?? "-")
                                    </strong>

                                </div>

                            </div>

                        </div>

                        <div class="company-details-address">

                            <div class="company-details-address-icon">

                                <span class="material-symbols-outlined">
                                    location_on
                                </span>

                            </div>

                            <div>

                                <small>
                                    Address
                                </small>

                                @if (HasAddress())
                                {
                                    <div class="company-address-lines">

                                        @if (!String.IsNullOrWhiteSpace(
                                            objCompany.AddressLine1))
                                        {
                                            <div>
                                                @objCompany.AddressLine1
                                            </div>
                                        }

                                        @if (!String.IsNullOrWhiteSpace(
                                            objCompany.AddressLine2))
                                        {
                                            <div>
                                                @objCompany.AddressLine2
                                            </div>
                                        }

                                        @if (!String.IsNullOrWhiteSpace(
                                            objCompany.Town))
                                        {
                                            <div>
                                                @objCompany.Town
                                            </div>
                                        }

                                        @if (!String.IsNullOrWhiteSpace(
                                            objCompany.County))
                                        {
                                            <div>
                                                @objCompany.County
                                            </div>
                                        }

                                        @if (!String.IsNullOrWhiteSpace(
                                            objCompany.Postcode))
                                        {
                                            <div>
                                                @objCompany.Postcode
                                            </div>
                                        }

                                        @if (!String.IsNullOrWhiteSpace(
                                            objCompany.Country))
                                        {
                                            <div>
                                                @objCompany.Country
                                            </div>
                                        }

                                    </div>
                                }
                                else
                                {
                                    <strong>
                                        No address has been added yet.
                                    </strong>
                                }

                            </div>

                        </div>

                    </div>

                </div>

                <div class="crm-card company-finance-card">

                    <div class="crm-card-header">

                        <div>

                            <h3>
                                Finance
                            </h3>

                            <p>
                                Invoice history, payments and outstanding balances.
                            </p>

                        </div>

                        <a href="@GetCompanyInvoicesUrl()"
                           class="btn btn-sm btn-light">

                            View all invoices

                        </a>

                    </div>

                    <div class="company-card-body">

                        <div class="company-finance-summary">

                            <a href="@GetCompanyInvoicesUrl()"
                               class="company-finance-stat">

                                <span class="company-finance-stat-icon">

                                    <span class="material-symbols-outlined">
                                        receipt_long
                                    </span>

                                </span>

                                <span class="company-finance-stat-content">

                                    <small>
                                        Invoiced
                                    </small>

                                    <strong>
                                        @GetTotalInvoiced().ToString("C")
                                    </strong>

                                    <span>
                                        @GetPluralText(
                                            GetIssuedInvoiceCount(),
                                            "issued invoice",
                                            "issued invoices")
                                    </span>

                                </span>

                            </a>

                            <a href="@GetCompanyInvoicesUrl(
                                                               "Paid")"
                               class="company-finance-stat">

                                <span class="company-finance-stat-icon company-finance-stat-icon-paid">

                                    <span class="material-symbols-outlined">
                                        payments
                                    </span>

                                </span>

                                <span class="company-finance-stat-content">

                                    <small>
                                        Paid
                                    </small>

                                    <strong class="company-finance-paid">
                                        @GetTotalPaid().ToString("C")
                                    </strong>

                                    <span>
                                        Payments received
                                    </span>

                                </span>

                            </a>

                            <a href="@GetCompanyInvoicesUrl(
                                                               blnOutstanding: true)"
                               class="company-finance-stat">

                                <span class="company-finance-stat-icon company-finance-stat-icon-outstanding">

                                    <span class="material-symbols-outlined">
                                        account_balance_wallet
                                    </span>

                                </span>

                                <span class="company-finance-stat-content">

                                    <small>
                                        Outstanding
                                    </small>

                                    <strong class="@GetOutstandingValueClass()">
                                        @GetTotalOutstanding().ToString("C")
                                    </strong>

                                    <span>
                                        @GetPluralText(
                                            GetOutstandingInvoiceCount(),
                                            "invoice",
                                            "invoices")
                                    </span>

                                </span>

                            </a>

                            <a href="@GetCompanyInvoicesUrl(
                                                               blnOverdue: true)"
                               class="company-finance-stat">

                                <span class="company-finance-stat-icon company-finance-stat-icon-overdue">

                                    <span class="material-symbols-outlined">
                                        warning
                                    </span>

                                </span>

                                <span class="company-finance-stat-content">

                                    <small>
                                        Overdue
                                    </small>

                                    <strong class="@GetOverdueValueClass()">
                                        @GetTotalOverdue().ToString("C")
                                    </strong>

                                    <span>
                                        @GetPluralText(
                                            GetOverdueInvoiceCount(),
                                            "invoice",
                                            "invoices")
                                    </span>

                                </span>

                            </a>

                        </div>

                        <div class="company-finance-history">

                            <div class="company-finance-history-heading">

                                <div>

                                    <h4>
                                        Recent invoices
                                    </h4>

                                    <span>
                                        Latest billing activity for this company.
                                    </span>

                                </div>

                            </div>

                            @if (colInvoices.Count == 0)
                            {
                                <div class="company-finance-empty">

                                    <span class="material-symbols-outlined">
                                        receipt_long
                                    </span>

                                    <div>

                                        <strong>
                                            No invoices yet
                                        </strong>

                                        <span>
                                            Invoices created for this company will appear here.
                                        </span>

                                    </div>

                                </div>
                            }
                            else
                            {
                                <div class="company-invoice-list">

                                    @foreach (Invoice objInvoice
                                        in GetRecentInvoices())
                                    {
                                        <a href="@($"/invoices/{objInvoice.Id}")"
                                           class="company-invoice-item">

                                            <span class="company-invoice-icon">

                                                <span class="material-symbols-outlined">
                                                    receipt_long
                                                </span>

                                            </span>

                                            <span class="company-invoice-main">

                                                <span class="company-invoice-title-row">

                                                    <strong>
                                                        @objInvoice.InvoiceNumber
                                                    </strong>

                                                    <span class="company-invoice-status"
                                                          style="@GetInvoiceStatusStyle(
                                                                                                                      objInvoice.Status)">

                                                        @objInvoice.Status.GetDisplay().Name

                                                    </span>

                                                </span>

                                                <span class="company-invoice-meta">

                                                    <span>
                                                        @objInvoice.Job.Name
                                                    </span>

                                                    <span>
                                                        @GetInvoiceDateText(
                                                            objInvoice)
                                                    </span>

                                                </span>

                                            </span>

                                            <span class="company-invoice-money">

                                                <strong>
                                                    @objInvoice.Total.ToString("C")
                                                </strong>

                                                @if (IsOutstanding(
                                                    objInvoice))
                                                {
                                                    <small class="@GetInvoiceOutstandingClass(
                                                                                                                objInvoice)">

                                                        @GetOutstanding(
                                                            objInvoice).ToString("C")
                                                        outstanding

                                                    </small>
                                                }
                                                else if (objInvoice.Status ==
                                                    InvoiceStatus.Paid)
                                                {
                                                    <small class="company-invoice-paid">
                                                        Paid
                                                    </small>
                                                }

                                            </span>

                                            <span class="material-symbols-outlined company-invoice-arrow">
                                                chevron_right
                                            </span>

                                        </a>
                                    }

                                </div>
                            }

                        </div>

                    </div>

                </div>

                <div class="crm-card">

                    <div class="crm-card-header">

                        <div>

                            <h3>
                                Related records
                            </h3>

                            <p>
                                Contacts, jobs, tickets, activities and notes
                                linked to this company.
                            </p>

                        </div>

                    </div>

                    <div class="company-card-body">

                        <div class="company-related-grid">

                            <section class="company-related-section">

                                <div class="company-related-heading">

                                    <div>

                                        <div class="company-related-title-row">

                                            <h4>
                                                Contacts
                                            </h4>

                                            <span class="company-related-count">
                                                @colContacts.Count
                                            </span>

                                        </div>

                                        <span>
                                            People linked to this company.
                                        </span>

                                    </div>

                                    <a href="@($"/contacts?companyId={CompanyId}")">
                                        View all
                                    </a>

                                </div>

                                @if (colContacts.Count == 0)
                                {
                                    <div class="company-related-empty">

                                        <span class="material-symbols-outlined">
                                            person_off
                                        </span>

                                        <span>
                                            No contacts are linked to this company.
                                        </span>

                                    </div>
                                }
                                else
                                {
                                    <div class="company-related-list">

                                        @foreach (Contact objContact
                                            in colContacts.Take(5))
                                        {
                                            <a href="@($"/contacts/{objContact.Id}")"
                                               class="company-related-list-item">

                                                <span class="company-related-avatar">
                                                    @GetContactInitials(
                                                        objContact)
                                                </span>

                                                <span class="company-related-list-content">

                                                    <strong>
                                                        @GetContactName(
                                                            objContact)
                                                    </strong>

                                                    <small>
                                                        @GetContactSubtitle(
                                                            objContact)
                                                    </small>

                                                </span>

                                                <span class="material-symbols-outlined">
                                                    chevron_right
                                                </span>

                                            </a>
                                        }

                                    </div>
                                }

                            </section>

                            <section class="company-related-section">

                                <div class="company-related-heading">

                                    <div>

                                        <div class="company-related-title-row">

                                            <h4>
                                                Jobs
                                            </h4>

                                            <span class="company-related-count">
                                                @colJobs.Count
                                            </span>

                                        </div>

                                        <span>
                                            Work and opportunities for this company.
                                        </span>

                                    </div>

                                    <a href="@($"/jobs?companyId={CompanyId}")">
                                        View all
                                    </a>

                                </div>

                                @if (colJobs.Count == 0)
                                {
                                    <div class="company-related-empty">

                                        <span class="material-symbols-outlined">
                                            work_off
                                        </span>

                                        <span>
                                            No jobs are linked to this company.
                                        </span>

                                    </div>
                                }
                                else
                                {
                                    <div class="company-related-list">

                                        @foreach (Job objJob
                                            in colJobs.Take(5))
                                        {
                                            <a href="@($"/jobs/{objJob.Id}")"
                                               class="company-related-list-item">

                                                <span class="company-related-record-icon">

                                                    <span class="material-symbols-outlined">
                                                        work
                                                    </span>

                                                </span>

                                                <span class="company-related-list-content">

                                                    <strong>
                                                        @objJob.Name
                                                    </strong>

                                                    <small>

                                                        @objJob.Stage.GetDisplay().Name

                                                        @if (objJob.Value.HasValue)
                                                        {
                                                            <text>
                                                                · @objJob.Value.Value.ToString("C")
                                                            </text>
                                                        }

                                                    </small>

                                                </span>

                                                <span class="material-symbols-outlined">
                                                    chevron_right
                                                </span>

                                            </a>
                                        }

                                    </div>
                                }

                            </section>

                            <section class="company-related-section company-related-section-wide">

                                <div class="company-related-heading">

                                    <div>

                                        <div class="company-related-title-row">

                                            <h4>
                                                Tickets
                                            </h4>

                                            <span class="company-related-count">
                                                @colTickets.Count
                                            </span>

                                        </div>

                                        <span>
                                            Maintenance and support work.
                                        </span>

                                    </div>

                                    <a href="@($"/tickets?companyId={CompanyId}")">
                                        View all
                                    </a>

                                </div>

                                @if (colTickets.Count == 0)
                                {
                                    <div class="company-related-empty">

                                        <span class="material-symbols-outlined">
                                            confirmation_number
                                        </span>

                                        <span>
                                            No tickets are linked to this company.
                                        </span>

                                    </div>
                                }
                                else
                                {
                                    <div class="company-related-list">

                                        @foreach (Ticket objTicket
                                            in colTickets.Take(5))
                                        {
                                            <a href="@($"/tickets/{objTicket.Id}")"
                                               class="company-related-list-item">

                                                <span class="company-related-record-icon">

                                                    <span class="material-symbols-outlined">
                                                        confirmation_number
                                                    </span>

                                                </span>

                                                <span class="company-related-list-content">

                                                    <strong>
                                                        @objTicket.Title
                                                    </strong>

                                                    <small>
                                                        @objTicket.Status.GetDisplay().Name
                                                        ·
                                                        @objTicket.Priority.GetDisplay().Name
                                                    </small>

                                                </span>

                                                <span class="material-symbols-outlined">
                                                    chevron_right
                                                </span>

                                            </a>
                                        }

                                    </div>
                                }

                            </section>

                        </div>

                    </div>

                </div>

                <EntityActivities CompanyId="@CompanyId"
                                  Title="Activities"
                                  Subtitle="Upcoming tasks and follow-ups for this company."
                                  EmptyText="No open activities for this company." />

                <EntityNotes EntityId="@CompanyId"
                             Title="Notes"
                             Subtitle="Internal notes for this company."
                             EmptyText="No notes have been added for this company yet." />

            </div>

            <aside class="company-side">

                <div class="crm-card">

                    <div class="company-card-body">

                        <h4 class="company-side-heading">
                            Create
                        </h4>

                        <div class="company-action-list">

                            <a href="@($"/contacts/add?companyId={CompanyId}")"
                               class="btn btn-soft-primary w-100">

                                <span class="material-symbols-outlined">
                                    person_add
                                </span>

                                Add contact

                            </a>

                            <a href="@($"/jobs/add?companyId={CompanyId}")"
                               class="btn btn-soft-primary w-100">

                                <span class="material-symbols-outlined">
                                    add_business
                                </span>

                                Add job

                            </a>

                            <a href="@($"/tickets/new?companyId={CompanyId}")"
                               class="btn btn-soft-primary w-100">

                                <span class="material-symbols-outlined">
                                    confirmation_number
                                </span>

                                Add ticket

                            </a>

                            <a href="@($"/activities/add?companyId={CompanyId}")"
                               class="btn btn-soft-primary w-100">

                                <span class="material-symbols-outlined">
                                    add_task
                                </span>

                                Add activity

                            </a>

                        </div>

                    </div>

                </div>

                @if (!String.IsNullOrWhiteSpace(
                         objCompany.PrimaryEmail) ||
                     !String.IsNullOrWhiteSpace(
                         objCompany.PrimaryPhone) ||
                     !String.IsNullOrWhiteSpace(
                         objCompany.Website))
                {
                    <div class="crm-card">

                        <div class="company-card-body">

                            <h4 class="company-side-heading">
                                Contact
                            </h4>

                            <div class="company-action-list">

                                @if (!String.IsNullOrWhiteSpace(
                                    objCompany.PrimaryEmail))
                                {
                                    <a href="mailto:@objCompany.PrimaryEmail"
                                       class="btn btn-soft-secondary w-100">

                                        <span class="material-symbols-outlined">
                                            mail
                                        </span>

                                        Send email

                                    </a>
                                }

                                @if (!String.IsNullOrWhiteSpace(
                                    objCompany.PrimaryPhone))
                                {
                                    <a href="tel:@objCompany.PrimaryPhone"
                                       class="btn btn-soft-secondary w-100">

                                        <span class="material-symbols-outlined">
                                            call
                                        </span>

                                        Call company

                                    </a>
                                }

                                @if (!String.IsNullOrWhiteSpace(
                                    objCompany.Website))
                                {
                                    <a href="@objCompany.Website"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-soft-secondary w-100">

                                        <span class="material-symbols-outlined">
                                            open_in_new
                                        </span>

                                        Open website

                                    </a>
                                }

                            </div>

                        </div>

                    </div>
                }

                <div class="crm-card">

                    <div class="company-card-body">

                        <h4 class="company-side-heading">
                            Finance
                        </h4>

                        <div class="company-meta-list">

                            <div>

                                <span>
