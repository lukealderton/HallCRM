                        </div>

                        <a href="@GetCompanyInvoicesUrl()"
                           class="btn btn-soft-secondary w-100 company-finance-view-button">

                            <span class="material-symbols-outlined">
                                receipt_long
                            </span>

                            View invoices

                        </a>

                    </div>

                </div>

                <div class="crm-card">

                    <div class="company-card-body">

                        <h4 class="company-side-heading">
                            Registration
                        </h4>

                        <div class="company-meta-list">

                            <div>

                                <span>
                                    Company number
                                </span>

                                <strong>
                                    @(objCompany.CompanyNumber ?? "-")
                                </strong>

                            </div>

                            @if (!String.IsNullOrWhiteSpace(
                                objCompany.CharityNumber))
                            {
                                <div>

                                    <span>
                                        Charity number
                                    </span>

                                    <strong>
                                        @objCompany.CharityNumber
                                    </strong>

                                </div>
                            }

                            <div>

                                <span>
                                    VAT number
                                </span>

                                <strong>
                                    @(objCompany.VatNumber ?? "-")
                                </strong>

                            </div>

                        </div>

