@page "/contacts"
@attribute [Authorize]
@rendermode InteractiveServer

@using CRM.Core.Contacts.Abstractions
@using CRM.Core.Contacts.Domain
@using Microsoft.AspNetCore.Components

@inject IContactService ContactService
@inject NavigationManager Navigation

<SeoHead Title="Contacts" />

<section class="contacts-page">

    @if (CompanyId.HasValue)
    {
        <div class="contacts-context-filter">
            <div class="contacts-context-filter-main">
                <span class="material-symbols-outlined">
                    apartment
                </span>

                <div>
                    <strong>Company filter active</strong>

                    <span>
                        Showing contacts linked to this company.
                    </span>
                </div>
            </div>

            <a href="/contacts"
               class="btn btn-soft-secondary btn-sm">

                <span class="material-symbols-outlined">
                    close
                </span>

                Clear company filter
            </a>
        </div>
    }

    <div class="crm-card contacts-toolbar">

        <div class="contacts-search">
            <div class="input-group">

                <span class="input-group-text">
                    <span class="material-symbols-outlined">
                        search
                    </span>
                </span>

                <input id="contactSearch"
                       class="form-control"
                       placeholder="Search contacts..."
                       @bind="strSearch"
                       @bind:event="oninput" />

            </div>
        </div>

        <div class="contacts-filters">

            <div class="form-check form-switch">
                <input id="includeArchived"
                       class="form-check-input"
                       type="checkbox"
                       @bind="blnIncludeArchived"
                       @bind:after="LoadContactsAsync" />

                <label class="form-check-label"
                       for="includeArchived">
                    Include archived
                </label>
            </div>

        </div>

        <div class="contacts-toolbar-actions">

            <button class="btn btn-primary"
                    type="button"
                    @onclick="SearchAsync">

                <span class="material-symbols-outlined">
                    search
                </span>

                Search
            </button>

        </div>

    </div>

    <div class="contacts-summary">

        <div class="contacts-summary-card contacts-summary-card-primary">

            <span class="material-symbols-outlined">
                groups
            </span>

            <div class="contacts-summary-content">

                <small>
                    Active shown
                </small>

                <strong>
                    @intActiveContacts
                </strong>

                <span class="contacts-summary-note">
                    @intTotalContacts total result@(GetPlural(intTotalContacts))
                </span>

            </div>

        </div>

        <div class="contacts-summary-card contacts-summary-card-success">

            <span class="material-symbols-outlined">
                alternate_email
            </span>

            <div class="contacts-summary-content">

                <small>
                    Contactable
                </small>

                <strong>
                    @intContactableContacts
                </strong>

                <span class="contacts-summary-note">
                    @intContactablePercentage% have email or phone
                </span>

            </div>

        </div>

        <div class="contacts-summary-card contacts-summary-card-info">

            <span class="material-symbols-outlined">
                apartment
            </span>

            <div class="contacts-summary-content">

                <small>
                    Linked to companies
                </small>

                <strong>
                    @intLinkedContacts
                </strong>

                <span class="contacts-summary-note">
                    @intLinkedPercentage% are attached to a company
                </span>

            </div>

        </div>

        <div class="contacts-summary-card contacts-summary-card-warning">

            <span class="material-symbols-outlined">
                priority_high
            </span>

            <div class="contacts-summary-content">

                <small>
                    Needs details
                </small>

                <strong>
                    @intNeedsDetailsContacts
                </strong>

                <span class="contacts-summary-note">
                    Missing company or contact details
                </span>

            </div>

        </div>

    </div>

    @if (blnShowErrorAlert &&
         !String.IsNullOrWhiteSpace(strErrorMessage))
    {
        <div class="alert alert-danger contacts-alert"
             role="alert">

            <span class="material-symbols-outlined">
                error
            </span>

            <div class="alert-content">

                <strong class="alert-title">
                    Unable to load contacts
                </strong>

                <p>
                    @strErrorMessage
                </p>

            </div>

            <div class="alert-actions">

                <button class="btn btn-soft-danger btn-sm"
                        type="button"
                        @onclick="LoadContactsAsync">

                    <span class="material-symbols-outlined">
                        refresh
                    </span>

                    Try again
                </button>

                <button class="btn btn-soft-danger btn-sm contacts-alert-close"
                        type="button"
                        aria-label="Dismiss"
                        @onclick="DismissErrorAlert">

                    <span class="material-symbols-outlined">
                        close
                    </span>

                </button>

            </div>
        </div>
    }

    <div class="crm-card contacts-results">

        <div class="crm-card-header">

            <div>
                <h3>
                    Contact records
                </h3>

                <p>
                    @strResultSummary
                </p>
            </div>

            @if (!String.IsNullOrWhiteSpace(strSearch))
            {
                <button class="btn btn-soft-secondary btn-sm"
                        type="button"
                        @onclick="ClearSearchAsync">

                    <span class="material-symbols-outlined">
                        filter_alt_off
                    </span>

                    Clear search
                </button>
            }

        </div>

        @if (blnLoading)
        {
            <div class="crm-loading">

                <span class="spinner-border spinner-border-sm">
                </span>

                Loading contacts...

            </div>
        }
        else if (!colContacts.Any())
        {
            <div class="crm-empty-state">

                <span class="material-symbols-outlined">
                    contacts
                </span>

                <h4>
                    No contacts found
                </h4>

                <p>
                    @if (CompanyId.HasValue)
                    {
                        <text>
                            No contacts are currently linked to this company.
                        </text>
                    }
                    else
                    {
                        <text>
                            Add your first contact or adjust the search filters.
                        </text>
                    }
                </p>

                <a class="btn btn-primary"
                   href="@GetAddContactUrl()">

                    <span class="material-symbols-outlined">
                        person_add
                    </span>

                    Add contact
                </a>

            </div>
        }
        else
        {
            <div class="contacts-table-view">

                <div class="table-responsive">

                    <table class="table table-hover align-middle crm-table contacts-table">

                        <thead>
                            <tr>
                                <th>Contact</th>
                                <th>Company</th>
                                <th>Role</th>
                                <th>Contact details</th>
                                <th>Status</th>
                                <th class="text-end">
                                    Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (Contact objContact in colContacts)
                            {
                                <tr class="@GetContactRowClass(objContact)">

                                    <td>
                                        <div class="contacts-person-cell">

                                            <div class="contacts-avatar">
                                                @GetInitials(objContact)
                                            </div>

                                            <div class="contacts-person-name">

                                                <a class="contacts-name-link"
                                                   href="@GetContactUrl(objContact.Id)">
                                                    @GetContactName(objContact)
                                                </a>

                                                @if (!String.IsNullOrWhiteSpace(objContact.Department))
                                                {
                                                    <small class="d-block text-muted">
                                                        @objContact.Department
                                                    </small>
                                                }

                                            </div>

                                        </div>
                                    </td>

                                    <td>
                                        @if (objContact.Company != null)
                                        {
                                            <a class="contacts-company-link"
                                               href="@GetCompanyUrl(objContact.Company.Id)">
                                                @objContact.Company.Name
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not linked
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @DisplayValue(objContact.JobTitle)
                                    </td>

                                    <td>
                                        @if (!String.IsNullOrWhiteSpace(objContact.PrimaryEmail))
                                        {
                                            <a href="mailto:@objContact.PrimaryEmail">
                                                @objContact.PrimaryEmail
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                        @if (!String.IsNullOrWhiteSpace(GetBestPhoneNumber(objContact)))
                                        {
                                            <small class="d-block text-muted">
                                                @GetBestPhoneNumber(objContact)
                                            </small>
                                        }
                                    </td>

                                    <td>
                                        @if (objContact.Entity.ArchivedUtc.HasValue)
                                        {
                                            <span class="badge text-bg-secondary">
                                                Archived
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success">
                                                Active
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <div class="contacts-row-actions">

                                            <a href="@GetContactUrl(objContact.Id)"
                                               class="btn btn-soft-primary btn-sm">

                                                <span class="material-symbols-outlined">
                                                    visibility
                                                </span>

                                                View
                                            </a>

                                            <a href="@($"/contacts/{objContact.Id}/edit")"
                                               class="btn btn-soft-secondary btn-sm">

                                                <span class="material-symbols-outlined">
                                                    edit
                                                </span>

                                                Edit
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

            <div class="contacts-mobile-list">

                @foreach (Contact objContact in colContacts)
                {
                    <article class="contacts-mobile-card @GetContactRowClass(objContact)">

                        <a href="@GetContactUrl(objContact.Id)"
                           class="contacts-mobile-main">

                            <div class="contacts-avatar contacts-mobile-avatar">
                                @GetInitials(objContact)
                            </div>

                            <div class="contacts-mobile-heading">

                                <div class="contacts-mobile-title-row">

                                    <div class="contacts-mobile-title">
                                        @GetContactName(objContact)
                                    </div>

                                    @if (objContact.Entity.ArchivedUtc.HasValue)
                                    {
                                        <span class="badge text-bg-secondary">
                                            Archived
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-success">
                                            Active
                                        </span>
                                    }

                                </div>

                                @if (!String.IsNullOrWhiteSpace(objContact.JobTitle))
                                {
                                    <div class="contacts-mobile-role">
                                        @objContact.JobTitle
                                    </div>
                                }

                                @if (!String.IsNullOrWhiteSpace(objContact.Department))
                                {
                                    <div class="contacts-mobile-department">
                                        @objContact.Department
                                    </div>
                                }

                            </div>

                            <span class="material-symbols-outlined contacts-mobile-chevron">
                                chevron_right
                            </span>

                        </a>

                        <div class="contacts-mobile-details">

                            @if (objContact.Company != null)
                            {
                                <a href="@GetCompanyUrl(objContact.Company.Id)"
                                   class="contacts-mobile-detail">

                                    <span class="material-symbols-outlined">
                                        apartment
                                    </span>

                                    <span>
                                        @objContact.Company.Name
                                    </span>

                                </a>
                            }
                            else
                            {
                                <div class="contacts-mobile-detail contacts-mobile-detail-muted">

                                    <span class="material-symbols-outlined">
                                        apartment
                                    </span>

                                    <span>
                                        Not linked to a company
                                    </span>

                                </div>
                            }

                            @if (!String.IsNullOrWhiteSpace(objContact.PrimaryEmail))
                            {
                                <a href="mailto:@objContact.PrimaryEmail"
                                   class="contacts-mobile-detail">

                                    <span class="material-symbols-outlined">
                                        mail
                                    </span>

                                    <span>
                                        @objContact.PrimaryEmail
                                    </span>

                                </a>
                            }

                            @if (!String.IsNullOrWhiteSpace(GetBestPhoneNumber(objContact)))
                            {
                                <a href="tel:@GetBestPhoneNumber(objContact)"
                                   class="contacts-mobile-detail">

                                    <span class="material-symbols-outlined">
                                        call
                                    </span>

                                    <span>
                                        @GetBestPhoneNumber(objContact)
                                    </span>

                                </a>
                            }

                        </div>

                        <div class="contacts-mobile-actions">

                            <a href="@GetContactUrl(objContact.Id)"
                               class="btn btn-soft-primary">

                                <span class="material-symbols-outlined">
                                    visibility
                                </span>

                                View
                            </a>

                            <a href="@($"/contacts/{objContact.Id}/edit")"
                               class="btn btn-soft-secondary">

                                <span class="material-symbols-outlined">
                                    edit
                                </span>

                                Edit
                            </a>

                        </div>

                    </article>
                }

            </div>
        }

    </div>

</section>

@code {
    [SupplyParameterFromQuery(Name = "companyId")]
    public Guid? CompanyId { get; set; }

    private List<Contact> colContacts = [];

    private String? strSearch;
    private String? strErrorMessage;

    private String strResultSummary =
        "Showing active contact records.";

    private Boolean blnIncludeArchived;
    private Boolean blnLoading = true;
    private Boolean blnShowErrorAlert = true;

    private Int32 intTotalContacts;
    private Int32 intActiveContacts;
    private Int32 intArchivedContacts;
    private Int32 intContactableContacts;
    private Int32 intContactablePercentage;
    private Int32 intLinkedContacts;
    private Int32 intLinkedPercentage;
    private Int32 intNeedsDetailsContacts;

    protected override async Task OnParametersSetAsync()
    {
        HeaderState.SetHeader(
            "Contacts",
            CompanyId.HasValue
                ? "Contacts linked to the selected company."
                : "Manage people, decision makers and customer relationships.",
            @<a class="btn btn-primary"
                href="@GetAddContactUrl()">

                <span class="material-symbols-outlined">
                    person_add
                </span>

                Add contact
            </a>);

        await LoadContactsAsync();
    }

    private Task SearchAsync()
    {
        return LoadContactsAsync();
    }

    private async Task LoadContactsAsync()
    {
        blnLoading = true;
        strErrorMessage = null;
        blnShowErrorAlert = true;

        try
        {
            colContacts =
                await ContactService.GetContactsAsync(
                    strSearch,
                    CompanyId,
                    blnIncludeArchived,
                    false);

            SetContactStats();
            SetResultSummary();
        }
        catch (Exception objError)
        {
            strErrorMessage =
                "We couldn’t retrieve the contact records right now. " +
                objError.Message;

            colContacts = [];

            intTotalContacts = 0;
            intActiveContacts = 0;
            intArchivedContacts = 0;
            intContactableContacts = 0;
            intContactablePercentage = 0;
            intLinkedContacts = 0;
            intLinkedPercentage = 0;
            intNeedsDetailsContacts = 0;

            SetResultSummary();
        }
        finally
        {
            blnLoading = false;
        }
    }

    private async Task ClearSearchAsync()
    {
        strSearch = null;

        await LoadContactsAsync();
    }

    private void DismissErrorAlert()
    {
        blnShowErrorAlert = false;
    }

    private void SetContactStats()
    {
        intTotalContacts =
            colContacts.Count;

        intArchivedContacts =
            colContacts.Count(
                objContact =>
                    objContact.Entity.ArchivedUtc.HasValue);

        intActiveContacts =
            colContacts.Count(
                objContact =>
                    !objContact.Entity.ArchivedUtc.HasValue);

        intContactableContacts =
            colContacts.Count(
                HasPrimaryContactDetails);

        intLinkedContacts =
            colContacts.Count(
                objContact =>
                    objContact.Company != null);

        intNeedsDetailsContacts =
            colContacts.Count(
                objContact =>
                    !objContact.Entity.ArchivedUtc.HasValue &&
                    (
                        objContact.Company == null ||
                        !HasPrimaryContactDetails(objContact)
                    ));

        intContactablePercentage =
            intTotalContacts == 0
                ? 0
                : (Int32)Math.Round(
                    (Decimal)intContactableContacts /
                    intTotalContacts *
                    100);

        intLinkedPercentage =
            intTotalContacts == 0
                ? 0
                : (Int32)Math.Round(
                    (Decimal)intLinkedContacts /
                    intTotalContacts *
                    100);
    }

    private void SetResultSummary()
    {
        String strBaseSummary;

        if (String.IsNullOrWhiteSpace(strSearch))
        {
            strBaseSummary =
                $"Showing {intTotalContacts} contact record{GetPlural(intTotalContacts)}.";
        }
        else
        {
            strBaseSummary =
                $"Showing {intTotalContacts} result{GetPlural(intTotalContacts)} " +
                $"for \"{strSearch}\".";
        }

        if (CompanyId.HasValue)
        {
            strBaseSummary +=
                " Filtered to the selected company.";
        }

        strResultSummary =
            strBaseSummary;
    }

    private String GetAddContactUrl()
    {
        if (CompanyId.HasValue)
        {
            return
                $"/contacts/add?companyId={CompanyId.Value}";
        }

        return "/contacts/add";
    }

    private static String GetPlural(
        Int32 intCount)
    {
        return intCount == 1
            ? String.Empty
            : "s";
    }

    private static String GetContactUrl(
        Guid objContactId)
    {
        return
            $"/contacts/{objContactId}";
    }

    private static String GetCompanyUrl(
        Guid objCompanyId)
    {
        return
            $"/companies/{objCompanyId}";
    }

    private static String GetContactName(
        Contact objContact)
    {
        String strName =
            $"{objContact.FirstName} {objContact.LastName}"
                .Trim();

        if (!String.IsNullOrWhiteSpace(strName))
        {
            return strName;
        }

        if (!String.IsNullOrWhiteSpace(objContact.PrimaryEmail))
        {
            return objContact.PrimaryEmail;
        }

        if (!String.IsNullOrWhiteSpace(objContact.PrimaryPhone))
        {
            return objContact.PrimaryPhone;
        }

        if (!String.IsNullOrWhiteSpace(objContact.MobilePhone))
        {
            return objContact.MobilePhone;
        }

        return "Unnamed contact";
    }

    private static String GetInitials(
        Contact objContact)
    {
        String strFirst =
            !String.IsNullOrWhiteSpace(objContact.FirstName)
                ? objContact.FirstName[..1]
                : String.Empty;

        String strLast =
            !String.IsNullOrWhiteSpace(objContact.LastName)
                ? objContact.LastName[..1]
                : String.Empty;

        String strInitials =
            $"{strFirst}{strLast}".Trim();

        if (!String.IsNullOrWhiteSpace(strInitials))
        {
            return
                strInitials.ToUpperInvariant();
        }

        String strName =
            GetContactName(objContact);

        return
            strName[..1].ToUpperInvariant();
    }

    private static Boolean HasPrimaryContactDetails(
        Contact objContact)
    {
        return
            !String.IsNullOrWhiteSpace(objContact.PrimaryEmail) ||
            !String.IsNullOrWhiteSpace(objContact.PrimaryPhone) ||
            !String.IsNullOrWhiteSpace(objContact.MobilePhone);
    }

    private static String? GetBestPhoneNumber(
        Contact objContact)
    {
        if (!String.IsNullOrWhiteSpace(objContact.PrimaryPhone))
        {
            return objContact.PrimaryPhone;
        }

        if (!String.IsNullOrWhiteSpace(objContact.MobilePhone))
        {
            return objContact.MobilePhone;
        }

        return null;
    }

    private static String DisplayValue(
        String? strValue)
    {
        if (String.IsNullOrWhiteSpace(strValue))
        {
            return "—";
        }

        return strValue;
    }

    private static String GetContactRowClass(
        Contact objContact)
    {
        if (objContact.Entity.ArchivedUtc.HasValue)
        {
            return "contacts-row-archived";
        }

        return String.Empty;
    }
}