@page "/"
@page "/dashboard"
@attribute [Authorize]

@using CRM.Core.Companies.Abstractions
@using CRM.Core.Companies.Domain
@using CRM.Core.Contacts.Abstractions
@using CRM.Core.Contacts.Domain
@using CRM.Core.Jobs.Abstractions
@using CRM.Core.Jobs.Domain

@inject ICompanyService CompanyService
@inject IContactService ContactService
@inject IJobService JobService

<PageTitle>Dashboard - HallCRM</PageTitle>

<div class="dashboard-page">
    <div class="dashboard-hero">
        <div>
            <h2>Welcome back</h2>
            <p>Here’s what needs your attention across the CRM.</p>
        </div>

        <div class="dashboard-hero-actions">
            <a href="/companies/add" class="btn btn-primary">
                <span class="material-symbols-outlined">add</span>
                New company
            </a>

            <a href="/contacts/add" class="btn btn-light">
                <span class="material-symbols-outlined">person_add</span>
                New contact
            </a>
        </div>
    </div>

    <div class="row g-3 dashboard-stats">
        <div class="col-12 col-md-6 col-xl-3">
            <a href="/companies" class="dashboard-stat-card">
                <div class="dashboard-stat-icon">
                    <span class="material-symbols-outlined">business</span>
                </div>

                <div>
                    <div class="dashboard-stat-label">Companies</div>
                    <div class="dashboard-stat-value">@intCompanyCount</div>
                    <div class="dashboard-stat-meta">Active records</div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <a href="/contacts" class="dashboard-stat-card">
                <div class="dashboard-stat-icon">
                    <span class="material-symbols-outlined">contacts</span>
                </div>

                <div>
                    <div class="dashboard-stat-label">Contacts</div>
                    <div class="dashboard-stat-value">@intContactCount</div>
                    <div class="dashboard-stat-meta">
                        @GetContactMetaText()
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <a href="/jobs" class="dashboard-stat-card">
                <div class="dashboard-stat-icon">
                    <span class="material-symbols-outlined">work</span>
                </div>

                <div>
                    <div class="dashboard-stat-label">Open jobs</div>
                    <div class="dashboard-stat-value">@intOpenJobCount</div>
                    <div class="dashboard-stat-meta">
                        @FormatCurrency(decOpenJobValue) pipeline value
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <a href="/activities" class="dashboard-stat-card">
                <div class="dashboard-stat-icon">
                    <span class="material-symbols-outlined">task_alt</span>
                </div>

                <div>
                    <div class="dashboard-stat-label">Activities</div>
                    <div class="dashboard-stat-value">@intActivityCount</div>
                    <div class="dashboard-stat-meta">Due soon</div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12 col-xl-8">
            <div class="crm-card h-100">
                <div class="crm-card-header">
                    <div>
                        <h3>Needs attention</h3>
                        <p>Items that may need action.</p>
                    </div>
                </div>

                @if (blnLoading)
                {
                    <div class="crm-loading">
                        <span class="spinner-border spinner-border-sm"></span>
                        Loading dashboard...
                    </div>
                }
                else if (!HasAttentionItems)
                {
                    <div class="dashboard-attention-empty">
                        <div class="dashboard-attention-empty-icon">
                            <span class="material-symbols-outlined">check_circle</span>
                        </div>

                        <div>
                            <strong>Nothing urgent right now</strong>
                            <span>There are no job items currently requiring attention.</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="dashboard-attention-list">
                        @if (intOverdueJobCount > 0)
                        {
                            <a href="/jobs" class="dashboard-attention-item dashboard-attention-item-danger">
                                <div class="dashboard-attention-icon">
                                    <span class="material-symbols-outlined">warning</span>
                                </div>

                                <div class="dashboard-attention-content">
                                    <strong>@GetPluralText(intOverdueJobCount, "job") overdue</strong>
                                    <span>Expected close date has passed.</span>
                                </div>

                                <span class="material-symbols-outlined dashboard-attention-arrow">
                                    chevron_right
                                </span>
                            </a>
                        }

                        @if (intQuotedJobCount > 0)
                        {
                            <a href="/jobs" class="dashboard-attention-item">
                                <div class="dashboard-attention-icon">
                                    <span class="material-symbols-outlined">request_quote</span>
                                </div>

                                <div class="dashboard-attention-content">
                                    <strong>@GetPluralText(intQuotedJobCount, "quote") awaiting progress</strong>
                                    <span>Jobs currently sitting at the quoted stage.</span>
                                </div>

                                <span class="material-symbols-outlined dashboard-attention-arrow">
                                    chevron_right
                                </span>
                            </a>
                        }

                        @if (intToDoJobCount > 0)
                        {
                            <a href="/jobs" class="dashboard-attention-item">
                                <div class="dashboard-attention-icon">
                                    <span class="material-symbols-outlined">event_available</span>
                                </div>

                                <div class="dashboard-attention-content">
                                    <strong>@GetPluralText(intToDoJobCount, "job") ready to start</strong>
                                    <span>Work currently waiting in the To Do stage.</span>
                                </div>

                                <span class="material-symbols-outlined dashboard-attention-arrow">
                                    chevron_right
                                </span>
                            </a>
                        }

                        @if (intInvoicedJobCount > 0)
                        {
                            <a href="/jobs" class="dashboard-attention-item">
                                <div class="dashboard-attention-icon">
                                    <span class="material-symbols-outlined">receipt_long</span>
                                </div>

                                <div class="dashboard-attention-content">
                                    <strong>@GetPluralText(intInvoicedJobCount, "invoice") awaiting payment</strong>
                                    <span>@FormatCurrency(decInvoicedJobValue) currently invoiced.</span>
                                </div>

                                <span class="material-symbols-outlined dashboard-attention-arrow">
                                    chevron_right
                                </span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="crm-card h-100">
                <div class="crm-card-header">
                    <div>
                        <h3>Quick actions</h3>
                        <p>Common CRM tasks.</p>
                    </div>
                </div>

                <div class="dashboard-actions-list">
                    <a href="/companies/add" class="dashboard-action">
                        <span class="material-symbols-outlined">add_business</span>

                        <div>
                            <strong>Add company</strong>
                            <small>Create a new organisation record</small>
                        </div>
                    </a>

                    <a href="/contacts/add" class="dashboard-action">
                        <span class="material-symbols-outlined">person_add</span>

                        <div>
                            <strong>Add contact</strong>
                            <small>Add a person to a company</small>
                        </div>
                    </a>

                    <a href="/jobs/add" class="dashboard-action">
                        <span class="material-symbols-outlined">add_chart</span>

                        <div>
                            <strong>Add job</strong>
                            <small>Track a new job</small>
                        </div>
                    </a>

                    <a href="/activities/add" class="dashboard-action">
                        <span class="material-symbols-outlined">event</span>

                        <div>
                            <strong>Add activity</strong>
                            <small>Schedule a call, task, or meeting</small>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12 col-xl-8">
            <div class="crm-card">
                <div class="crm-card-header">
                    <div>
                        <h3>Recent companies</h3>
                        <p>Latest company records added to the CRM.</p>
                    </div>

                    <a href="/companies" class="btn btn-sm btn-light">
                        View all
                    </a>
                </div>

                @if (blnLoading)
                {
                    <div class="crm-loading">
                        <span class="spinner-border spinner-border-sm"></span>
                        Loading companies...
                    </div>
                }
                else if (!colRecentCompanies.Any())
                {
                    <div class="crm-empty-state">
                        <span class="material-symbols-outlined">business</span>
                        <h4>No companies yet</h4>
                        <p>Add your first company to start building the CRM.</p>

                        <a href="/companies/add" class="btn btn-primary">
                            Add company
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle crm-table">
                            <thead>
                                <tr>
                                    <th>Company</th>
                                    <th>Industry</th>
                                    <th>Contact</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (Company objCompany in colRecentCompanies)
                                {
                                    <tr>
                                        <td>
                                            <a href="@($"/companies/{objCompany.Id}")"
                                               class="fw-semibold d-block text-black">
                                                @objCompany.Name
                                            </a>

                                            @if (!String.IsNullOrWhiteSpace(objCompany.TradingName))
                                            {
                                                <small class="text-muted">
                                                    @objCompany.TradingName
                                                </small>
                                            }
                                        </td>

                                        <td>
                                            @(objCompany.Industry ?? "-")
                                        </td>

                                        <td>
                                            @if (!String.IsNullOrWhiteSpace(objCompany.PrimaryEmail))
                                            {
                                                <a href="mailto:@objCompany.PrimaryEmail">
                                                    @objCompany.PrimaryEmail
                                                </a>
                                            }
                                            else if (!String.IsNullOrWhiteSpace(objCompany.PrimaryPhone))
                                            {
                                                <a href="tel:@objCompany.PrimaryPhone">
                                                    @objCompany.PrimaryPhone
                                                </a>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>

                                        <td class="text-end">
                                            <a href="@($"/companies/{objCompany.Id}")"
                                               class="btn btn-sm btn-outline-primary">
                                                Open
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="crm-card">
                <div class="crm-card-header">
                    <div>
                        <h3>Jobs pipeline</h3>
                        <p>Current active workload and value.</p>
                    </div>

                    <a href="/jobs" class="btn btn-sm btn-light">
                        View all
                    </a>
                </div>

                <div class="pipeline-list">
                    @foreach (JobStage enmStage in colPipelineStages)
                    {
                        Int32 intCount = GetJobStageCount(enmStage);
                        Decimal decValue = GetJobStageValue(enmStage);

                        <a href="/jobs"
                           class="pipeline-row">
                            <div class="pipeline-stage">
                                <span class="pipeline-stage-name">
                                    @GetJobStageName(enmStage)
                                </span>

                                <small>
                                    @FormatCurrency(decValue)
                                </small>
                            </div>

                            <strong>@intCount</strong>
                        </a>
                    }
                </div>

                <div class="pipeline-total">
                    <span>Open pipeline</span>

                    <div>
                        <strong>@intOpenJobCount jobs</strong>
                        <small>@FormatCurrency(decOpenJobValue)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Boolean blnLoading = true;

    private Int32 intCompanyCount;
    private Int32 intContactCount;
    private Int32 intOpenJobCount;
    private Int32 intActivityCount;

    private Int32 intOverdueJobCount;
    private Int32 intQuotedJobCount;
    private Int32 intToDoJobCount;
    private Int32 intInvoicedJobCount;

    private Decimal decOpenJobValue;
    private Decimal decInvoicedJobValue;

    private List<Company> colRecentCompanies = [];
    private List<Contact> colContacts = [];
    private List<Job> colJobs = [];

    private readonly JobStage[] colPipelineStages =
    [
        JobStage.New,
        JobStage.Quoted,
        JobStage.ToDo,
        JobStage.InProgress,
        JobStage.Invoiced
    ];

    private Boolean HasAttentionItems =>
        intOverdueJobCount > 0 ||
        intQuotedJobCount > 0 ||
        intToDoJobCount > 0 ||
        intInvoicedJobCount > 0;

    protected override async Task OnInitializedAsync()
    {
        HeaderState.SetHeader(
            "Dashboard",
            "Overview of your CRM activity");

        try
        {
            Task<List<Company>> objCompaniesTask =
                CompanyService.GetCompaniesAsync();

            Task<List<Contact>> objContactsTask =
                ContactService.GetContactsAsync();

            Task<List<Job>> objJobsTask =
                JobService.GetJobsAsync();

            await Task.WhenAll(
                objCompaniesTask,
                objContactsTask,
                objJobsTask);

            List<Company> colCompanies =
                await objCompaniesTask;

            colContacts =
                await objContactsTask;

            colJobs =
                await objJobsTask;

            intCompanyCount =
                colCompanies.Count;

            intContactCount =
                colContacts.Count;

            colRecentCompanies =
                colCompanies
                    .OrderByDescending(objCompany =>
                        objCompany.Entity.CreatedUtc)
                    .Take(5)
                    .ToList();

            CalculateJobStatistics();
        }
        finally
        {
            blnLoading = false;
        }
    }

    private void CalculateJobStatistics()
    {
        List<Job> colOpenJobs =
            colJobs
                .Where(objJob =>
                    objJob.Stage != JobStage.Paid &&
                    objJob.Stage != JobStage.Lost)
                .ToList();

        intOpenJobCount =
            colOpenJobs.Count;

        decOpenJobValue =
            colOpenJobs.Sum(objJob =>
                objJob.Value ?? 0m);

        DateTime dtmToday =
            DateTime.UtcNow.Date;

        intOverdueJobCount =
            colOpenJobs.Count(objJob =>
                objJob.ExpectedCloseDateUtc.HasValue &&
                objJob.ExpectedCloseDateUtc.Value.Date < dtmToday);

        intQuotedJobCount =
            colJobs.Count(objJob =>
                objJob.Stage == JobStage.Quoted);

        intToDoJobCount =
            colJobs.Count(objJob =>
                objJob.Stage == JobStage.ToDo);

        intInvoicedJobCount =
            colJobs.Count(objJob =>
                objJob.Stage == JobStage.Invoiced);

        decInvoicedJobValue =
            colJobs
                .Where(objJob =>
                    objJob.Stage == JobStage.Invoiced)
                .Sum(objJob =>
                    objJob.Value ?? 0m);
    }

    private Int32 GetJobStageCount(JobStage enmStage)
    {
        return colJobs.Count(objJob =>
            objJob.Stage == enmStage);
    }

    private Decimal GetJobStageValue(JobStage enmStage)
    {
        return colJobs
            .Where(objJob =>
                objJob.Stage == enmStage)
            .Sum(objJob =>
                objJob.Value ?? 0m);
    }

    private static String GetJobStageName(JobStage enmStage)
    {
        return enmStage switch
        {
            JobStage.ToDo => "To Do",
            JobStage.InProgress => "In Progress",
            _ => enmStage.ToString()
        };
    }

    private String GetContactMetaText()
    {
        if (intContactCount == 0)
        {
            return "No contacts yet";
        }

        Int32 intWithContactDetails =
            colContacts.Count(objContact =>
                !String.IsNullOrWhiteSpace(objContact.PrimaryEmail) ||
                !String.IsNullOrWhiteSpace(objContact.PrimaryPhone) ||
                !String.IsNullOrWhiteSpace(objContact.MobilePhone));

        return $"{intWithContactDetails} contactable";
    }

    private static String FormatCurrency(Decimal decValue)
    {
        return decValue.ToString("C0");
    }

    private static String GetPluralText(
        Int32 intCount,
        String strSingular)
    {
        return intCount == 1
            ? $"1 {strSingular}"
            : $"{intCount} {strSingular}s";
    }
}