@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject PageHeaderState objPageHeaderState

<div class="crm-shell">

    @if (blnMobileMenuOpen)
    {
        <button class="crm-sidebar-backdrop"
                type="button"
                aria-label="Close navigation"
                @onclick="CloseMobileMenu">
        </button>
    }

    <aside class="crm-sidebar @(blnMobileMenuOpen ? "is-open" : null)">
        <div class="crm-sidebar-main">

            <div class="crm-brand">
                <div class="crm-brand-content">
                    <div class="crm-brand-title">
                        <span>Hall</span>CRM
                    </div>

                    <div class="crm-brand-subtitle">
                        Customer management
                    </div>
                </div>

                <button type="button"
                        class="crm-sidebar-close"
                        aria-label="Close navigation"
                        @onclick="CloseMobileMenu">
                    <span class="material-symbols-outlined">
                        close
                    </span>
                </button>
            </div>

            <NavMenu OnNavigate="CloseMobileMenu" />
        </div>

        <AuthorizeView>
            <Authorized Context="objAuthContext">
                <div class="crm-sidebar-user">
                    <div class="crm-sidebar-avatar">
                        @GetUserInitials(objAuthContext.User)
                    </div>

                    <div class="crm-sidebar-user-meta">
                        <a href="/account/manage">
                            @GetUserDisplayName(objAuthContext.User)
                        </a>

                        <small>
                            @GetUserRoleLabel(objAuthContext.User)
                        </small>
                    </div>

                    <span class="material-symbols-outlined crm-sidebar-user-chevron">
                        chevron_right
                    </span>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="crm-sidebar-user">
                    <div class="crm-sidebar-avatar">
                        ?
                    </div>

                    <div class="crm-sidebar-user-meta">
                        <strong>Not signed in</strong>
                        <small>Guest</small>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </aside>

    <main class="crm-main">

        <div class="crm-mobile-header">
            <button type="button"
                    class="crm-mobile-menu-button"
                    aria-label="Open navigation"
                    aria-expanded="@blnMobileMenuOpen"
                    @onclick="ToggleMobileMenu">
                <span class="material-symbols-outlined">
                    menu
                </span>
            </button>

            <div class="crm-mobile-brand">
                <span>Hall</span>CRM
            </div>
        </div>

        <header class="crm-topbar">
            <div class="crm-topbar-heading">
                <h1 class="crm-page-title">
                    @objPageHeaderState.Title
                </h1>

                @if (!String.IsNullOrWhiteSpace(objPageHeaderState.Subtitle))
                {
                    <p class="crm-page-subtitle">
                        @objPageHeaderState.Subtitle
                    </p>
                }
            </div>

            @if (objPageHeaderState.Actions != null)
            {
                <div class="crm-topbar-actions">
                    @objPageHeaderState.Actions
                </div>
            }
        </header>

        <section class="crm-content">
            @Body
        </section>
    </main>
</div>

@code {
    private Boolean blnMobileMenuOpen;

    protected override void OnInitialized()
    {
        objPageHeaderState.OnChange += HandlePageHeaderChanged;
    }

    private void ToggleMobileMenu()
    {
        blnMobileMenuOpen =
            !blnMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        blnMobileMenuOpen =
            false;
    }

    private void HandlePageHeaderChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static String GetUserDisplayName(
        ClaimsPrincipal objUser)
    {
        String? strForename =
            GetClaimValue(
                objUser,
                ClaimTypes.GivenName,
                "given_name",
                "forename",
                "FirstName",
                "Forename");

        String? strSurname =
            GetClaimValue(
                objUser,
                ClaimTypes.Surname,
                "family_name",
                "surname",
                "LastName",
                "Surname");

        String strFullName =
            $"{strForename} {strSurname}".Trim();

        if (!String.IsNullOrWhiteSpace(strFullName))
        {
            return strFullName;
        }

        String? strName =
            GetClaimValue(
                objUser,
                ClaimTypes.Name,
                "name",
                "unique_name");

        if (!String.IsNullOrWhiteSpace(strName))
        {
            return strName;
        }

        String? strEmail =
            GetClaimValue(
                objUser,
                ClaimTypes.Email,
                "email");

        if (!String.IsNullOrWhiteSpace(strEmail))
        {
            return strEmail;
        }

        return objUser.Identity?.Name ?? "Signed in";
    }

    private static String GetUserRoleLabel(
        ClaimsPrincipal objUser)
    {
        List<String> colRoles =
            objUser.Claims
                .Where(objClaim =>
                    objClaim.Type == ClaimTypes.Role ||
                    objClaim.Type.Equals(
                        "role",
                        StringComparison.OrdinalIgnoreCase))
                .Select(objClaim => objClaim.Value)
                .Where(strRole =>
                    !String.IsNullOrWhiteSpace(strRole))
                .Distinct()
                .ToList();

        if (colRoles.Count == 0)
        {
            return "User";
        }

        return String.Join(", ", colRoles);
    }

    private static String GetUserInitials(
        ClaimsPrincipal objUser)
    {
        String strDisplayName =
            GetUserDisplayName(objUser);

        if (strDisplayName.Contains('@'))
        {
            strDisplayName =
                strDisplayName
                    .Split('@')[0]
                    .Replace(".", " ")
                    .Replace("_", " ")
                    .Replace("-", " ");
        }

        String[] colNameParts =
            strDisplayName.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries |
                StringSplitOptions.TrimEntries);

        String strInitials =
            String.Empty;

        foreach (String strNamePart in colNameParts.Take(2))
        {
            strInitials +=
                Char.ToUpperInvariant(strNamePart[0]);
        }

        if (String.IsNullOrWhiteSpace(strInitials))
        {
            return "U";
        }

        return strInitials;
    }

    private static String? GetClaimValue(
        ClaimsPrincipal objUser,
        params String[] colClaimTypes)
    {
        foreach (String strClaimType in colClaimTypes)
        {
            Claim? objClaim =
                objUser.Claims.FirstOrDefault(
                    objClaim =>
                        objClaim.Type.Equals(
                            strClaimType,
                            StringComparison.OrdinalIgnoreCase));

            if (!String.IsNullOrWhiteSpace(objClaim?.Value))
            {
                return objClaim.Value;
            }
        }

        return null;
    }

    public void Dispose()
    {
        objPageHeaderState.OnChange -=
            HandlePageHeaderChanged;
    }
}